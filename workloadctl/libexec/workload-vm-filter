#!/usr/bin/python3
"""
workload-vm-filter: arm or disarm one VM's uid-keyed egress policy.

Usage: workload-vm-filter <up|down> <name>

The program is lib/filter_arm.py, which is one body for both substrates; this
file is main(), bound to its VM substrate.
"""
import sys

sys.dont_write_bytecode = True

from filter_arm import VM, down, up
from helper_main import run_helper, up_down_main


def main(argv):
    return up_down_main(argv, lambda name: up(VM, name), down)


if __name__ == "__main__":
    # `up` fails loudly, `down` does not block a stop -- see
    # helper_main.run_helper, which holds that asymmetry for all four helpers.
    sys.exit(run_helper(main, sys.argv))
