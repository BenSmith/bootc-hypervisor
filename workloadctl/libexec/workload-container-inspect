#!/usr/bin/python3
"""
workload-container-inspect: arm or retire one container workload's
transparent egress inspection.

Usage: workload-container-inspect <up|down> <name>

`up` runs as the inspect socket unit's ExecStartPre, `down` as its
ExecStopPost. The program is lib/inspect_arm.py, which is one body for both
substrates; this file is main(), bound to its container substrate.
"""
import sys

sys.dont_write_bytecode = True

from helper_main import run_helper, up_down_main
from inspect_arm import CONTAINER, down, up


def main(argv):
    return up_down_main(argv, lambda name: up(CONTAINER, name), down)


if __name__ == "__main__":
    sys.exit(run_helper(main, sys.argv))
