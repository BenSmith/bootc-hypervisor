#!/usr/bin/python3
"""
workload-container-inspect: arm or retire one container workload's
transparent egress inspection.

Usage: workload-container-inspect <up|down> <name>

Container counterpart of workload-vm-inspect (P1-8/P1-9 in the container
egress-parity build spec). `up` runs as the inspect socket unit's
ExecStartPre, `down` as its ExecStopPost -- identical split, identical
reasons. Read workload-vm-inspect's module docstring for the parts that
transfer unchanged: why both nft skeletons are applied on every start (an RPM
upgrade self-heals on next start rather than next reboot), what is never torn
down (the shared advertised address and dummy link), what the
`wl_internal_ok4/6` exemptions key on and why they carry no port, and -- most
load-bearing -- what is NOT armed here: the two cgroup exemptions
(wl_egress_cg, wl_inspect_cg) belong to the inspect SERVICE unit's own
ExecStartPre/ExecStopPost, not to this helper, because an element resolves to
a cgroup id at add time and only that unit's own start/stop moment has the
right id in scope.

D6 in the build spec: the listener binary and the two nft tables are shared
verbatim with the VM path (imported straight from lib/vm.py) -- the uid-keyed
element builders (vm_inspect_element_commands, vm_internal_ok_commands, the
listener addressing) take nothing but a uid, so nothing here needed a
container-flavoured twin. The container-specific work is entirely in parsing
[network] instead of [vm.network] and building the container schema's own
policy document (container_inspect_policy_text) -- see lib/workload_lib.py.

D7: no synthesising DNS responder for containers, so unlike
workload-vm-inspect there is no vm_uses_resolve check and no resolve-status
clearing here.

The credential-broker exemption (S2's carve-out) IS made here, gated on
`container_uses_credentials` -- the same `wl_internal_ok4/6` addition
workload-vm-inspect's `up()` makes for the VM broker's own address, and for
the same reason: without it the inspector's dial to its own broker is dropped
by the rule that stops the workload reaching the LAN.

G18: inspection_applies() delegates to container_uses_inspect(), the single
source of the predicate the generator's run-file list (P1-9) must agree
with -- the same reason workload-vm-inspect's inspection_applies delegates to
vm_uses_inspect() for the VM side.

EXIT CODES: same convention as workload-vm-inspect. `up` fails loudly, `down`
is tolerant.
"""
import ipaddress
import os
import pwd
import sys

sys.dont_write_bytecode = True

from helper_main import log, run, run_helper, up_down_main
from nft import (add_listener_addresses, purge_internal_exemptions,
                 remove_listener_addresses)
from vm import (
    NFT_BIN, NFT_PROXY_SKELETON, NFT_SKELETON,
    container_uses_credentials, ensure_advertised_interface,
    vm_broker_listen_address, vm_inspect_element_commands,
    vm_inspect_policy_path, vm_inspect_status_path,
    vm_internal_ok_commands,
)
from egress_status import clear_status
from config_parser import container_uses_inspect
from workload_lib import (
    container_inspect_policy_text, container_internal_entries,
    container_internal_resolve, load_workload_config,
)



def inspection_applies(config: dict) -> bool:
    """G18's container half: delegates to container_uses_inspect(), the same
    source the generator's run-file list reads, so this helper and the
    generator cannot disagree about which workloads have an inspector."""
    return container_uses_inspect(config)


def write_policy(name: str, net: dict) -> str:
    """Write the inspector's policy document. Same contract as
    workload-vm-inspect's write_policy: root-owned, 0640, replaced rather
    than truncated in place."""
    path = vm_inspect_policy_path(name)
    tmp = f"{path}.tmp"
    with open(tmp, "w") as f:
        f.write(container_inspect_policy_text(net))
    os.chown(tmp, 0, pwd.getpwnam(f"_wl-{name}").pw_gid)
    os.chmod(tmp, 0o640)
    os.replace(tmp, path)
    return path


def internal_failure(name: str, host: str, cause: Exception) -> str:
    """Mirrors workload-vm-inspect's internal_failure: state the blast radius
    (this is fatal to the whole workload's START, not only to the
    exemption -- this helper runs as the inspect socket's ExecStartPre and
    something the workload needs Requires= that socket) and both ways out.

    The sentence does not NAME the requiring unit, and that is deliberate: it
    is workload-<name>.service in `single` mode and the pod/net head unit in
    `pod`/`bridge` (see _head_unit in generators/workload-generate), so a
    literal name here is wrong in one topology and sends the operator to the
    wrong journal. The remedy is the same either way -- fix the name or drop
    the entry -- so the unit adds nothing the operator can act on."""
    return (f"{cause}\n"
            f"  This is fatal to the START, not only to the exemption: it "
            f"runs as workload-{name}-inspect.socket's ExecStartPre, and "
            f"{name}'s own units require that socket, so the workload will "
            f"not start while it stands.\n"
            f"  Either make {host} resolve on this host, or drop the "
            f"[[network.internal]] entry naming it -- the entry authorises "
            f"nothing by itself, so dropping it costs only this workload's "
            f"reach to that host, and the workload starts.")


def up(name: str) -> int:
    config = load_workload_config(name)
    net = config.get("network", {}) or {}
    if not inspection_applies(config):
        # The unit should not have been generated at all; treat it as a
        # no-op rather than a failure, so an edited config that drops its
        # last trigger stops cleanly instead of blocking the workload.
        log(f"  {name} is not inspected; nothing to arm")
        return 0

    uid = pwd.getpwnam(f"_wl-{name}").pw_uid

    write_policy(name, net)
    clear_status(vm_inspect_status_path(name))

    ensure_advertised_interface(run)
    # Both skeletons, for the reason workload-vm-inspect's module docstring
    # gives: the DNAT maps live in the proxy table, the guard sets in the
    # filter table, and this unit starts Before= the workload whose own
    # prestart would otherwise be the first to create one of them.
    run([NFT_BIN, "-f", NFT_PROXY_SKELETON], check=True)
    run([NFT_BIN, "-f", NFT_SKELETON], check=True)

    add_listener_addresses(uid)

    # Eight elements, both tables -- see vm_inspect_element_commands's
    # docstring. Purge before adding: `add element` on an existing key does
    # not overwrite a stale one.
    for argv in vm_inspect_element_commands(uid, "delete"):
        run(argv)
    for argv in vm_inspect_element_commands(uid, "add"):
        run(argv, check=True)

    # The `internal` exemptions, resolved here and armed per address. Purged
    # first for the same reason the six above are.
    purge_internal_exemptions(uid, name)
    hosts = [e.host for e in container_internal_entries(net)]
    addresses: list = []
    for host in hosts:
        try:
            addresses.extend(container_internal_resolve(host))
        except ValueError as e:
            raise ValueError(internal_failure(name, host, e)) from None
    # THE BROKER'S OWN ADDRESS IS AN INTERNAL DESTINATION (P2-5), and without
    # this element the brokered path cannot work at all -- the same defect the
    # VM side was fixed for, one substrate over. `vm_broker_listen_address` is
    # 127.129.x.y, inside 127.0.0.0/8 and therefore inside wl_internal4, and
    # the drop keyed on this workload's cgroup sits ABOVE the `oif lo accept`,
    # so the inspector's dial to its own broker is dropped by the rule that
    # exists to stop the workload reaching the LAN.
    #
    # It presents as a broker that is down: the connect times out, the listener
    # counts `credential broker unreachable`, and the container gets a 502
    # naming a unit that is running perfectly.
    #
    # Armed only for a workload that HAS a broker, so one with no credentials
    # gains no exemption; purged by uid with the rest, so dropping the last
    # credential removes it.
    if container_uses_credentials(config):
        addresses.append(ipaddress.ip_address(vm_broker_listen_address(uid)))
    try:
        add_commands = vm_internal_ok_commands(uid, addresses, "add")
    except ValueError as e:
        raise ValueError(internal_failure(name, ", ".join(hosts), e)) from None
    for argv in add_commands:
        run(argv, check=True)

    log(f"  Inspector redirect armed for uid {uid}")
    if hosts:
        log(f"  Internal exemptions armed for {len(hosts)} host(s): "
            f"{', '.join(hosts)} -> {', '.join(str(a) for a in addresses)}")
    return 0


def down(name: str) -> int:
    try:
        uid = pwd.getpwnam(f"_wl-{name}").pw_uid
    except KeyError:
        return 0
    for argv in vm_inspect_element_commands(uid, "delete"):
        run(argv)

    # NOT the two cgroup exemptions -- see the module docstring for why they
    # cannot be removed from here and live on the inspect service's own
    # ExecStopPost instead.
    try:
        purge_internal_exemptions(uid, name)
    except (OSError, ValueError) as e:
        log(f"  WARNING: could not clear internal exemptions: {e}")

    remove_listener_addresses(uid)
    return 0


def main(argv):
    return up_down_main(argv, up, down)


if __name__ == "__main__":
    sys.exit(run_helper(main, sys.argv))
