#!/usr/bin/python3
"""
workload-inspect-listener: the socket-activated entrypoint of the transparent
egress inspector. The inspector itself is lib/inspect_listener.py; this
process reads the policy, builds the minter, recovers the inherited sockets
and runs the accept loop until SIGTERM.

WHERE THE POLICY COMES FROM

/run/workload-vm/<name>/inspect.json, written by `workload-vm-inspect up` (the
socket unit's ExecStartPre) and read HERE once, at start. The workload name is
argv[1]: this process is socket-activated with four identical fd names, so
there is nothing on the socket to derive it from, and deriving it from getpwuid
would make the listener's identity depend on a naming convention rather than on
what the unit was generated for. A policy that cannot be read is a failed
start, never an empty allowlist — an empty allowlist is a listener that refuses
everything while reporting itself healthy.

WHY IT NEVER BINDS

It is socket-activated: the .socket unit binds the four listeners and
hands them in as inherited fds. This process recovers them from LISTEN_PID /
LISTEN_FDS and accepts on them; it opens no socket of its own. That is not
defensiveness — socket activation is what moves the bind out of the workload
SELinux domain and into an inherited fd. A fallback that bound the ports
itself when the activation environment was missing would silently undo that:
it would run as the workload user, in the workload domain, and bind the very
listener a guest is redirected into. So a missing environment is a loud
failure, never a second path.
"""

import signal
import sys

sys.dont_write_bytecode = True

from egress_policy import (
    inspect_policy_path, inspect_record_path, inspect_status_path,
    load_policy,
)
from inspect_listener import Listener, build_minter
from sd_listen import NotSocketActivated
from sd_listen import (
    inherited_listening_sockets as sd_inherited_listening_sockets)


def inherited_listening_sockets():
    """Recover the listening sockets systemd passed in, or fail loudly.

    The mechanics are shared with workload-vm-resolve (lib/sd_listen.py); what
    is ours is the reason a fallback bind is refused. Binding here rather than
    accepting the inherited fd would move the bind into the workload SELinux
    domain, which is the property the socket unit exists to hold.
    """
    return sd_inherited_listening_sockets(
        refusal=(", because a fallback bind would move the bind out of the "
                 "inherited fd and back into the workload SELinux domain"))


def main(argv=None):
    argv = sys.argv if argv is None else argv
    if len(argv) != 2:
        print(f"usage: {argv[0]} <workload-name>", file=sys.stderr)
        return 2
    policy_path = inspect_policy_path(argv[1])
    try:
        policy = load_policy(policy_path)
    except (OSError, ValueError) as exc:
        # Loud, and before the sockets are touched. See load_policy: there is
        # no empty-policy fallback, because it is indistinguishable from a
        # legitimate empty allowlist.
        print(f"error: could not read {policy_path}: {exc}", file=sys.stderr)
        return 1
    try:
        minter = build_minter(argv[1], policy)
    except FileNotFoundError as exc:
        # Before the sockets, like the policy read, and for the same reason: a
        # listener that accepted connections it could mint no leaf for would
        # fail every guest handshake with an opaque certificate error while
        # reporting itself up.
        print(f"error: {exc}", file=sys.stderr)
        return 1
    try:
        sockets = inherited_listening_sockets()
    except NotSocketActivated as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    listener = Listener(sockets, policy=policy, minter=minter,
                        status_path=inspect_status_path(argv[1]),
                        record_path=inspect_record_path(argv[1]))
    print(f"policy loaded from {policy_path}: {policy.summary}", flush=True)
    signal.signal(signal.SIGTERM, lambda *_args: listener.stop())
    # Rotation is logrotate's (see /etc/logrotate.d/workloadctl-inspect), and
    # this is the half of it that lives here: the snippet renames the file and
    # then HUPs us, rather than using copytruncate, which races an in-flight
    # write. The handler only sets a flag -- RequestLog.reopen says why.
    signal.signal(signal.SIGHUP, lambda *_args: listener.inspection.record.reopen())
    try:
        listener.accept_loop()
    finally:
        # On the way out as well as on the tick: SIGTERM is the one moment the
        # figures are complete, and a workload that stops between ticks would
        # otherwise leave its last half-minute unreported.
        listener.write_status()
        listener.log_summary()
        listener.inspection.record.close()
        listener.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
