#!/usr/bin/python3
"""
workload-vm-build-disk: Build or refresh the system.qcow2 for a VM workload.

Usage: workload-vm-build-disk <name> [--update]

Without --update: no-op if system.qcow2 already exists (ConditionPathExists
in the build service handles this, but the check is duplicated here for
safety when called directly).

With --update: rotates system.qcow2 → system.qcow2.gen-N and rebuilds.

Image sources (from [vm] TOML section, exactly one required):
  vm.cloud_image_url + vm.cloud_image_checksum   Download + verify qcow2
  vm.local_image                                  Copy/reflink from path
  vm.image                                        bootc image ref (via bootc-image-builder)

cloud_image_url takes any scheme urllib handles, including file://, which is
checksum-verified and cached like a remote one — that is the difference from
local_image, which copies the path as-is with neither.

The program is lib/vm_disk_build.py (the three builders, the data disk, and
the build with its rotate-and-restore) over lib/vm_image_fetch.py (the
download and its checksum) and lib/vm_disk_generations.py (the rotation).
This file is main().
"""
import sys

sys.dont_write_bytecode = True

from helper_main import log
from vm_disk_build import build_disks


def main(argv):
    update = "--update" in argv
    args = [a for a in argv[1:] if not a.startswith("-")]
    if not args:
        print(f"Usage: {argv[0]} <name> [--update]", file=sys.stderr)
        return 1
    try:
        build_disks(args[0], update)
    except Exception as e:  # noqa: BLE001 - the unit reports the exit; the message is the diagnosis
        log(f"ERROR: {e}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
