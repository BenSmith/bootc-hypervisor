#!/usr/bin/python3
"""
workload-vm-inspect: arm or retire one VM's transparent egress inspection.

Usage: workload-vm-inspect <up|down> <name>

`up` runs as the inspect socket unit's ExecStartPre, `down` as its
ExecStopPost. The program is lib/inspect_arm.py, which is one body for both
substrates; this file is main(), bound to its VM substrate.
"""
import sys

sys.dont_write_bytecode = True

from helper_main import run_helper, up_down_main
from inspect_arm import VM, down, up


def main(argv):
    return up_down_main(argv, lambda name: up(VM, name), down)


if __name__ == "__main__":
    sys.exit(run_helper(main, sys.argv))
