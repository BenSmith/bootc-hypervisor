#!/usr/bin/python3
"""
workload-vm-notify: sd_notify wrapper for QEMU VM workloads.

Usage: workload-vm-notify <name> <qemu-system-x86_64> [qemu-args...]

Starts QEMU, connects to its QMP socket, waits until the guest enters the
running state, then sends READY=1 to systemd. Exits with QEMU's exit code.

The program is lib/vm_notify.py. This file is main().
"""
import sys

sys.dont_write_bytecode = True

from vm_notify import supervise


def main(argv):
    if len(argv) < 3:
        print(f"Usage: {argv[0]} <name> <qemu-binary> [qemu-args...]",
              file=sys.stderr)
        return 1
    return supervise(argv[1], argv[2:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
