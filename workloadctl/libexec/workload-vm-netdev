#!/usr/bin/python3
"""
workload-vm-netdev: derive the host-dependent half of a VM's passt netdev.

Usage: workload-vm-netdev <name>

Writes /run/workload-env/workload-<name>.passt, a systemd EnvironmentFile
holding one variable:

    WL_PASST_DNS=<comma-separated netdev property fragment>

which the VM unit's ExecStart splices into its `-netdev passt,...` argument as
`${WL_PASST_DNS}`. Always exits 0 and always writes a usable value: a VM that
cannot resolve is bad, a VM that will not boot is worse.

WHY THIS IS A SEPARATE STEP AND NOT PART OF THE GENERATOR

The design calls the netdev "host-derived, computed from /etc/resolv.conf at
generate time". Half of that cannot be done at generate time. The Python
generator runs from workload-generate.service, ordered
`After=sysinit.target Before=basic.target` — long before network.target — so:

  - /etc/resolv.conf is readable there (it is static on a systemd-resolved
    host, and otherwise holds the previous boot's content), but
  - the default route does NOT exist yet, and `--dns-forward` needs an address
    the guest will route to passt.

So the derivation moves to the one place that is both late enough to see the
network and early enough to precede QEMU: an ExecStartPre on the VM unit
itself. systemd re-reads every EnvironmentFile= once per Exec* command
(exec_spawn() calls exec_context_load_environment() per invocation), so a file
written by ExecStartPre is visible to ExecStart in the same unit.

The program is lib/vm_netdev.py (the decision and the write) over
lib/passt_dns_host.py (what the host has) and lib/passt_dns_fragment.py (what
the guest is told). This file is main(), and the fallback that writes a
no-resolver value when anything else fails.
"""
import sys

sys.dont_write_bytecode = True

from helper_main import log
from passt_dns_fragment import NO_RESOLVER
from vm_netdev import passt_dns, write_passt_env


def main(argv):
    if len(argv) != 2:
        print(f"usage: {argv[0]} <name>", file=sys.stderr)
        return 2
    name = argv[1]
    fragment, notes = passt_dns(name)
    for note in notes:
        log(f"  passt DNS: {note}")
    log(f"  Wrote {write_passt_env(name, fragment)}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # noqa: BLE001 - never block a VM from booting
        print(f"  ERROR: {e}", file=sys.stderr)
        # Emit a safe fallback so ExecStart still has a defined expansion.
        try:
            write_passt_env(sys.argv[1], NO_RESOLVER)
        except Exception:
            pass
        sys.exit(0)
