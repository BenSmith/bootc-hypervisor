#!/usr/bin/python3
"""
workload-vm-netdev: derive the host-dependent half of a VM's passt netdev.

Usage: workload-vm-netdev <name>

Writes /run/workload-env/workload-<name>.passt, a systemd EnvironmentFile
holding one variable:

    WL_PASST_DNS=<comma-separated netdev property fragment>

which the VM unit's ExecStart splices into its `-netdev passt,...` argument as
`${WL_PASST_DNS}`. Always exits 0 and always writes a usable value: a VM that
cannot resolve is bad, a VM that will not boot is worse.

WHY THIS IS A SEPARATE STEP AND NOT PART OF THE GENERATOR

The design calls the netdev "host-derived, computed from /etc/resolv.conf at
generate time". Half of that cannot be done at generate time. The Python
generator runs from workload-generate.service, ordered
`After=sysinit.target Before=basic.target` — long before network.target — so:

  - /etc/resolv.conf is readable there (it is static on a systemd-resolved
    host, and otherwise holds the previous boot's content), but
  - the default route does NOT exist yet, and `--dns-forward` needs an address
    the guest will route to passt.

So the derivation moves to the one place that is both late enough to see the
network and early enough to precede QEMU: an ExecStartPre on the VM unit
itself. systemd re-reads every EnvironmentFile= once per Exec* command
(exec_spawn() calls exec_context_load_environment() per invocation), so a file
written by ExecStartPre is visible to ExecStart in the same unit.
"""
import os
import pwd
import sys

sys.dont_write_bytecode = True

from egress_policy import uses_resolve
from helper_main import log
from passt_dns_fragment import build_dns_fragment, build_synthesis_fragment
from passt_dns_host import default_gateways, host_resolvers
from workload_addr import resolve_address
from workload_lib import load_workload_config, workload_env_dir


def workload_config(name: str) -> dict:
    """This workload's parsed TOML, or {} if it cannot be read.

    An empty dict is a workload that is not a VM as far as uses_resolve is
    concerned, which lands on the no-responder path — the same assumption the
    old resolver_mode made when the file was unreadable.
    """
    try:
        return load_workload_config(name)
    except (OSError, ValueError) as e:
        log(f"  WARNING: could not read config for {name}: {e}; assuming "
            f"resolver = \"host\" and no responder")
        return {}


def resolver_mode(config: dict) -> str:
    """[vm.network].resolver for this workload: "host" (default) or "none"."""
    mode = (config.get("vm", {}) or {}).get("network", {}) \
        .get("resolver", "host")
    return mode if mode in ("host", "none") else "host"


def responder_address(name: str) -> str:
    """This workload's synthesising responder address, 127.130.x.y.

    Derived from the uid, which exists by the time this runs: the netdev
    prestart is on the VM unit, and the VM unit Requires= the setup service
    that creates the user.
    """
    return resolve_address(pwd.getpwnam(f"_wl-{name}").pw_uid)


def main(argv):
    if len(argv) != 2:
        print(f"usage: {argv[0]} <name>", file=sys.stderr)
        return 2
    name = argv[1]

    config = workload_config(name)

    if resolver_mode(config) == "none":
        # The guest gets no resolver at all. Under synthesis this no longer
        # means "no DNS tunnelling" -- nothing is forwarded either way -- it
        # means a guest that can only dial literals.
        fragment = "dhcp-dns=off"
        notes = ['[vm.network].resolver = "none": the guest is given no '
                 'resolver']
    elif uses_resolve(config):
        try:
            responder = responder_address(name)
        except (KeyError, ValueError) as e:
            # Fail closed, and specifically NOT back to build_dns_fragment.
            # This workload's guest is filtered; handing it the host's real
            # nameservers because we could not derive a uid would be a leak of
            # exactly the kind synthesis exists to remove.
            log(f"  WARNING: no responder address for {name} ({e}); "
                f"the guest gets no resolver rather than the host's")
            fragment = "dhcp-dns=off"
            notes = []
        else:
            fragment, notes = build_synthesis_fragment(default_gateways(),
                                                       responder)
    else:
        # No responder: an unfiltered or bridged VM, whose guest really is being
        # handed the host's own nameservers. /etc/resolv.conf is read here and
        # nowhere else.
        gateways = default_gateways()
        resolvers = host_resolvers()
        fragment, notes = build_dns_fragment(gateways, resolvers)

    for note in notes:
        log(f"  passt DNS: {note}")

    env_dir = workload_env_dir()
    env_dir.mkdir(parents=True, exist_ok=True)
    env_file = env_dir / f"workload-{name}.passt"
    tmp = env_file.with_suffix(".passt.tmp")
    # Write-then-rename: ExecStart reads this file microseconds later, and a
    # torn read would produce a netdev argument QEMU rejects.
    tmp.write_text(f"WL_PASST_DNS={fragment}\n")
    os.replace(tmp, env_file)
    log(f"  Wrote {env_file}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # noqa: BLE001 - never block a VM from booting
        print(f"  ERROR: {e}", file=sys.stderr)
        # Emit a safe fallback so ExecStart still has a defined expansion.
        try:
            env_dir = workload_env_dir()
            env_dir.mkdir(parents=True, exist_ok=True)
            (env_dir / f"workload-{sys.argv[1]}.passt").write_text(
                "WL_PASST_DNS=dhcp-dns=off\n")
        except Exception:
            pass
        sys.exit(0)
