#!/usr/bin/python3
"""
workload-broker-config: write one workload's broker.toml (either substrate).

Usage: workload-broker-config config <name>

Runs as the ExecStartPre of that workload's own broker instance
(workload-<name>-broker.service) and writes the instance's config into the
RuntimeDirectory= systemd has already created as the unit's dynamic user -- so
the file is written unprivileged, at 0600 inside a 0700 directory, and there is
no window in which it is wider than it ends up.

Regenerated at every start rather than installed once, which is what /run buys
over /etc (ADR 007 decision 2 as amended): the config cannot drift from the
bundle it is a pure function of, and it cannot serve the previous boot's
credential set.

The program is broker_config.write_instance_config; this file is main(), which
turns the name into the bundle and the uid it is a function of.

EXIT CODES

`config` fails loudly, and always with 1. There is no tolerant verb: a config
that did not get written leaves the broker reading a stale file or none, and
the unit's ExecStartPre is deliberately not `-` prefixed for the same reason.
"""
import pwd
import sys

sys.dont_write_bytecode = True

from broker_config import write_instance_config
from workload_lib import load_workload_config


def main(argv):
    if len(argv) != 3 or argv[1] != "config":
        print(f"usage: {argv[0]} config <name>", file=sys.stderr)
        return 2
    name = argv[2]
    path = write_instance_config(load_workload_config(name),
                                 pwd.getpwnam(f"_wl-{name}").pw_uid)
    print(f"  Wrote {path}", flush=True)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # noqa: BLE001
        print(f"  ERROR: {e}", file=sys.stderr)
        sys.exit(1)
