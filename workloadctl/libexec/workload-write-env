#!/usr/bin/python3
"""
workload-write-env: write one container's decrypted secrets for --env-file.

Usage:
    workload-write-env <workload-name>              # single-container workload
    workload-write-env <workload-name> <container>  # one container in a [[containers]] workload

The program is lib/secrets_env.py; this file is main(), and the exit code an
EnvFileError becomes.
"""
import sys

from secrets_env import EnvFileError, write_secrets_env


def main(argv):
    if len(argv) not in (2, 3):
        print(f"Usage: {argv[0]} <workload-name> [container-name]", file=sys.stderr)
        return 1
    container = argv[2] if len(argv) == 3 else None
    try:
        write_secrets_env(argv[1], container)
    except EnvFileError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
