#!/usr/bin/python3
"""
workload-vm-proxy: provision or retire one VM's hostname-policy proxy.

Usage: workload-vm-proxy <up|down> <name>

`up` runs as the proxy unit's ExecStartPre, `down` as its ExecStopPost. Between
them they own three things: the shared advertised endpoint (a dummy interface
and an nftables nat chain), this workload's element in the uid -> listener map,
and the instance's generated tinyproxy config.

WHY THE CONFIG IS WRITTEN HERE AND NOT BY THE GENERATOR

It lives in /run/workload-vm/<name>, a RuntimeDirectory that does not exist when
the boot generator runs — and the generator is deliberately read-only with
respect to /var and /run state (see generators/workload-generate). Writing it at
start also means an edited `hosts` list takes effect on restart with no
regeneration, matching how the egress allowlist already behaves.

WHY THE INTERFACE IS NEVER TORN DOWN

`down` removes this workload's map element and nothing else. The dummy link and
the nat chain are shared, hold no per-workload state, and cost nothing when idle
— so there is no refcount, which is the whole reason ADR 006 could delete the
managed bridge's lifecycle. An orphaned link with an empty map translates
nothing; an orphaned chain matches no uid. Both self-heal on reboot anyway,
since neither nft state nor a dummy link survives one.

EXIT CODES

`up` fails loudly, on the same reasoning as workload-vm-filter: a VM whose
config names a hostname allowlist, whose proxy did not come up, and whose egress
is filtered, cannot reach anything at all — but if the redirect silently did not
install while the proxy did, the guest reaches the proxy through no path and the
operator sees a working proxy and a broken guest. Better to fail the start.
`down` is tolerant: its element is legitimately absent whenever the start failed
before installing it.
"""
import os
import pwd
import subprocess
import sys

sys.dont_write_bytecode = True

from vm import (
    NFT_BIN, NFT_PROXY_MAP, NFT_PROXY_SKELETON, NFT_PROXY_TABLE, NFT_SKELETON,
    VM_PROXY_ADDR, VM_PROXY_IFACE, VM_PROXY_PORT,
    vm_management_address, vm_proxy_cgroup_command, vm_proxy_config,
    vm_proxy_filter_file, vm_proxy_hosts, vm_proxy_map_command,
    vm_proxy_runtime_dir, vm_uses_proxy,
)
from workload_lib import workload_config_path

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - 3.11+ everywhere we ship
    tomllib = None

IP_BIN = "/usr/sbin/ip"


def log(msg):
    print(msg, flush=True)


def run(argv, check=False):
    return subprocess.run(argv, capture_output=True, text=True, check=check,
                          timeout=30)


def load_config(name: str) -> dict:
    with open(workload_config_path(name), "rb") as f:
        return tomllib.load(f)


def ensure_interface() -> None:
    """Create the dummy link carrying the advertised address, idempotently.

    Both steps tolerate "already exists" because two VMs starting concurrently
    race here — there is no lock and deliberately no owning unit. Anything else
    is fatal: without the address the redirect's destination is unroutable and
    the guest's proxy connection fails with no useful diagnostic.
    """
    result = run([IP_BIN, "link", "add", VM_PROXY_IFACE, "type", "dummy"])
    if result.returncode != 0 and "File exists" not in result.stderr:
        raise RuntimeError(
            f"could not create {VM_PROXY_IFACE}: {result.stderr.strip()}")

    # Query, then add. Not "add and tolerate the error": iproute2 answers a
    # duplicate address with "Address already assigned", not the "File exists"
    # the duplicate-link case produces, so a string match on the wrong phrase
    # fails only on the SECOND start of a workload — which is how this was
    # found, and not by any test.
    shown = run([IP_BIN, "-o", "addr", "show", "dev", VM_PROXY_IFACE])
    if VM_PROXY_ADDR not in shown.stdout:
        result = run([IP_BIN, "addr", "add", f"{VM_PROXY_ADDR}/32",
                      "dev", VM_PROXY_IFACE])
        if result.returncode != 0 and "xist" not in result.stderr \
                and "assigned" not in result.stderr:
            raise RuntimeError(
                f"could not add {VM_PROXY_ADDR} to {VM_PROXY_IFACE}: "
                f"{result.stderr.strip()}")

    run([IP_BIN, "link", "set", VM_PROXY_IFACE, "up"], check=True)


def write_instance_files(name: str, uid: int, hosts: list[str]) -> str:
    """Write tinyproxy.conf and the hostname allowlist. Returns the listen address.

    Both are written root-owned and world-unreadable-by-others but readable by
    the workload user, which is all tinyproxy needs — it reads them as
    _wl-<name> before it has served anything. 0640 rather than 0644 keeps one
    workload's policy from being enumerable by another.
    """
    listen_addr = vm_management_address(uid)
    rt = vm_proxy_runtime_dir(name)
    files = {
        f"{rt}/tinyproxy.conf": vm_proxy_config(name, listen_addr, hosts),
        f"{rt}/hosts.allow": vm_proxy_filter_file(hosts),
    }
    for path, content in files.items():
        # Replace rather than truncate-in-place: tinyproxy re-reads its config
        # only at start, but a restart racing a rewrite would otherwise see a
        # half-written file and exit 70.
        tmp = f"{path}.tmp"
        with open(tmp, "w") as f:
            f.write(content)
        os.chown(tmp, 0, pwd.getpwnam(f"_wl-{name}").pw_gid)
        os.chmod(tmp, 0o640)
        os.replace(tmp, path)
    return listen_addr


def up(name: str) -> int:
    config = load_config(name)
    if not vm_uses_proxy(config):
        # The unit should not have been generated at all; treat it as a no-op
        # rather than a failure so an edited config that drops `hosts` stops
        # cleanly instead of blocking the workload's start.
        log(f"  {name} has no hostname policy; nothing to provision")
        return 0

    uid = pwd.getpwnam(f"_wl-{name}").pw_uid
    hosts = vm_proxy_hosts(config.get("vm", {}).get("network", {}) or {})

    ensure_interface()
    run([NFT_BIN, "-f", NFT_PROXY_SKELETON], check=True)
    # The filter skeleton too, not only the proxy one: the exemption element
    # below lives in the filter table, and this unit starts Before= the VM
    # whose prestart would otherwise be the first to create it.
    run([NFT_BIN, "-f", NFT_SKELETON], check=True)

    listen_addr = write_instance_files(name, uid, hosts)

    # Purge before adding: an element for this uid may name a stale listen
    # address if the workload's uid was ever reallocated, and `add element` on
    # an existing key does not overwrite it.
    run(vm_proxy_map_command(uid, listen_addr, "delete"))
    run(vm_proxy_map_command(uid, listen_addr, "add"), check=True)

    # Exempt this proxy's own egress from the default-deny drop. systemd makes a
    # fresh cgroup on every start and an element resolves to a cgroup *id* when
    # it is added, so this pair adds the current one and removes nothing: both
    # commands name a path, and by the time ExecStartPre runs that path already
    # resolves to the NEW id. The previous start's element is retired by `down`
    # below, which runs while its cgroup is still live. The delete stays as the
    # idempotent half of an add — a restart that somehow reused an id must not
    # fail on "element exists".
    #
    # An element that outlives its cgroup (ExecStopPost never ran) is inert:
    # kernfs ids are not reused, so it matches nothing, and nft state does not
    # survive a reboot.
    run(vm_proxy_cgroup_command(name, "delete"))
    run(vm_proxy_cgroup_command(name, "add"), check=True)

    log(f"  Proxy for uid {uid} on {listen_addr}:{VM_PROXY_PORT}, "
        f"{len(hosts)} host pattern{'' if len(hosts) == 1 else 's'}, "
        f"reached as {VM_PROXY_ADDR}:{VM_PROXY_PORT}")
    return 0


def down(name: str) -> int:
    try:
        uid = pwd.getpwnam(f"_wl-{name}").pw_uid
    except KeyError:
        return 0
    # The value is part of the delete command but nft matches on the key, so a
    # stale listen address here still removes the right element.
    run(vm_proxy_map_command(uid, vm_management_address(uid), "delete"))
    run(vm_proxy_cgroup_command(name, "delete"))
    return 0


def main(argv):
    if len(argv) != 3 or argv[1] not in ("up", "down"):
        print(f"usage: {argv[0]} <up|down> <name>", file=sys.stderr)
        return 2
    action, name = argv[1], argv[2]
    return up(name) if action == "up" else down(name)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # noqa: BLE001
        print(f"  ERROR: {e}", file=sys.stderr)
        sys.exit(1 if len(sys.argv) > 1 and sys.argv[1] == "up" else 0)
