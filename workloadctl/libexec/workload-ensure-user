#!/usr/bin/python3
"""
Ensure a single workload user is fully configured for rootless podman.

Called as ExecStartPre=+ (root) in each workload service, and by
workloadctl enable.  Idempotent — safe to run on every service start.

Usage: workload-ensure-user <workload-name>
"""

import contextlib
import fcntl
import pwd
import sys
from pathlib import Path

from workload_lib import (
    WORKLOADS_BASE, load_workload_config, workload_config_path,
    workload_username, infer_workload_kind, container_uses_inspect,
)
from vm import (
    VM_SEED_CONTRACT_EXIT, SeedContractError, vm_uses_inspect,
)
import ensure_common
from ensure_common import (
    warn_if_stale_home, setup_home_directory, record_deployment_provenance,
    restore_selinux_labels, write_environment_file, setup_vm_socket_dir,
    generate_vm_egress_ca, provision_vm_pki_dirs,
)
from ensure_vm import (
    setup_nvram, setup_vm_volume_directories, generate_ssh_keypair,
    generate_vm_host_keypair, seed_vm_home_share_ssh_key,
    build_cloud_init_iso,
)
from ensure_container import (
    configure_subuid_subgid, setup_required_file_ownership,
    setup_volume_directories, enable_linger, ensure_manager_slice,
)

















































































# Per-workload provisioning lock. A module constant so tests can redirect it.
ENSURE_LOCK_DIR = Path("/run/lock/workloadctl")


@contextlib.contextmanager
def ensure_user_lock(name: str):
    """Serialize provisioning of one workload against a concurrent run of itself.

    `workloadctl enable` starts this script twice for the same workload, at the
    same time: once directly (cmd_enable → provision_user), and once as the
    ExecStartPre of the start job the generator enqueues for the unit it has just
    written. Nearly every step below is check-then-create — the two keypairs, the
    NVRAM copy, the cloud-init ISO, the volume dirs — so interleaved runs let one
    process's "does it exist yet?" answer No while the other is midway through
    creating it.

    ssh-keygen is the step that fails *loudly* when that happens (it will not
    overwrite a key that appeared after the exists() guard, so it exits nonzero
    and takes the whole enable down with it, intermittently). It is not the only
    step that races — just the only one that says so. The rest lose more quietly.

    Serializing is the entire fix: every step here is idempotent, so whichever
    process takes the lock second wakes to find the work already done and returns
    without redoing it.

    Degrades to running unlocked if the lock can't be taken. Both real callers are
    root, so that shouldn't happen — and if it does, running unlocked is merely
    the status quo ante (a race that usually wins), whereas refusing to provision
    would be a new way to fail.
    """
    fd = None
    try:
        ENSURE_LOCK_DIR.mkdir(parents=True, exist_ok=True)
        fd = open(ENSURE_LOCK_DIR / f"{name}.lock", "w")
        fcntl.flock(fd.fileno(), fcntl.LOCK_EX)
    except OSError as e:
        if fd is not None:
            fd.close()
            fd = None
        ensure_common.log(f"  WARNING: could not take the provisioning lock for {name} ({e}); "
            f"continuing unlocked")
    try:
        yield
    finally:
        if fd is not None:
            # Closing drops the flock; no explicit LOCK_UN needed.
            fd.close()


def main():
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} <workload-name>", file=sys.stderr)
        return 1

    name = sys.argv[1]
    with ensure_user_lock(name):
        return _ensure_user(name)


def _ensure_user(name: str) -> int:
    username = workload_username(name)

    ensure_common.log(f"Ensuring user setup for workload: {name}")

    # Look up user once — all functions receive the pwd struct
    try:
        pw = pwd.getpwnam(username)
    except KeyError:
        ensure_common.log(f"ERROR: User {username} does not exist")
        return 1

    # Flag (don't fix) a pre-Step-2 home dir — it silently breaks healthchecks.
    try:
        warn_if_stale_home(pw, name)
    except Exception as e:
        ensure_common.log(f"  WARNING: stale-home check failed for {username}: {e}")

    # Ensure base directory exists
    WORKLOADS_BASE.mkdir(parents=True, exist_ok=True)

    # Load config once — needed by volume setup and environment file
    try:
        config = load_workload_config(name)
    except Exception as e:
        ensure_common.log(f"ERROR: Failed to load config for {name}: {e}")
        return 1

    kind = infer_workload_kind(config)

    # Best-effort steps run independently so a failure in one doesn't skip the
    # rest; must-succeed steps (marked ERROR + return 1) abort the remaining
    # steps instead, since a workload missing a prerequisite has no reason to
    # continue provisioning
    # No fcontext registration here. The blanket /var/lib/workloads rule names
    # no workload and is install-time work, so it moved to the RPM's %post: run
    # from every prestart, N workloads raced the same semanage read lock at
    # every boot, and a lost race was logged once and never retried. The
    # per-workload VM override (svirt_image_t) is registered at enable, where
    # it contends with nothing.

    try:
        setup_home_directory(pw, name)
    except Exception as e:
        ensure_common.log(f"  WARNING: Failed to set up home directory for {username}: {e}")

    record_deployment_provenance(name)

    if kind == "vm":
        # VM workloads: NVRAM, socket dir, SSH key, cloud-init
        # Skip subuid/subgid (QEMU doesn't use user namespaces)
        # Skip linger (QEMU runs as a system service, not a user session)
        #
        # No network setup here any more (ADR 006). passt needs no host
        # configuration at all: no bridge to create, and no /etc/qemu/bridge.conf
        # entry, because it does not go through setuid-root qemu-bridge-helper.
        # A VM pinned to an operator-provided bridge does still need that helper
        # allowed for its bridge, but the operator provisions that bridge
        # themselves and the allow-list entry belongs with it.

        # NVRAM is a prerequisite for boot: the VM unit references nvram.fd
        # unconditionally, so a missing/failed NVRAM yields a flapping service.
        # Surface as a failure (the build and main VM services both Require this
        # setup unit, so failing here stops the VM from coming up bad).
        try:
            setup_nvram(pw, config)
        except Exception as e:
            ensure_common.log(f"  ERROR: Failed to set up NVRAM for {name}: {e}")
            return 1

        try:
            setup_vm_socket_dir(pw, name)
        except Exception as e:
            ensure_common.log(f"  WARNING: Failed to create socket dir for {name}: {e}")

        try:
            setup_vm_volume_directories(pw, config)
        except Exception as e:
            ensure_common.log(f"  WARNING: Failed to create virtiofs host directories for {name}: {e}")

        # SSH keypair + cloud-init ISO are prerequisites for a usable VM:
        # without them, `workloadctl exec` has no way in. Surface as failures
        # (the build service and the main VM service both Require this
        # setup unit, so failing here stops the VM from coming up bad).
        try:
            generate_ssh_keypair(pw, name)
        except Exception as e:
            ensure_common.log(f"  ERROR: Failed to generate SSH keypair for {name}: {e}")
            return 1

        # Must run after the keypair (it needs the pubkey) and after the volume
        # dirs. Fatal for the same reason those are: a share over the guest home
        # hides the key cloud-init installs, so an unseeded share is a VM the CLI
        # cannot log into — better to stop here than to start one.
        try:
            seed_vm_home_share_ssh_key(pw, config)
        except Exception as e:
            ensure_common.log(f"  ERROR: Failed to seed SSH key into the home share for {name}: {e}")
            return 1

        # Host keypair for SSH host-key pinning (S1) — must exist before
        # build_cloud_init_iso injects/pins it.
        try:
            generate_vm_host_keypair(pw, name)
        except Exception as e:
            ensure_common.log(f"  ERROR: Failed to generate VM host keypair for {name}: {e}")
            return 1

        # The egress CA, for the same reason and at the same point: the seed
        # carries it, so it must exist before the ISO is built. Filtered VMs
        # only -- an `egress = "open"` workload has no inspector to present
        # anything, so a CA would be a key with no purpose.
        #
        # G12 in the container egress-parity build spec: VM-only by
        # construction -- this is inside `if kind == "vm":`. Per-workload
        # egress CA generation for containers is P1-10, in the container
        # branch below this one.
        if vm_uses_inspect(config):
            try:
                generate_vm_egress_ca(pw, name)
            except Exception as e:
                ensure_common.log(f"  ERROR: Failed to generate egress CA for {name}: {e}")
                return 1

            # The leaf caches and the labels, after the CA so one relabel
            # covers it. Fatal for the same reason: an inspector that cannot
            # read its own CA fails to start, and every guest dial to 80/443
            # then times out with nothing in the guest to say why.
            try:
                provision_vm_pki_dirs(pw, name)
            except Exception as e:
                ensure_common.log(f"  ERROR: Failed to prepare the egress PKI directories "
                    f"for {name}: {e}")
                return 1

        try:
            build_cloud_init_iso(
                pw, config, name,
                config_path=workload_config_path(name),
            )
        except SeedContractError as e:
            # The operator's seed is wrong and the message says how to fix it.
            # A distinct exit code keeps the CLI from framing it as a crash.
            ensure_common.log(f"  ERROR: {e}")
            return VM_SEED_CONTRACT_EXIT
        except Exception as e:
            ensure_common.log(f"  ERROR: Failed to build cloud-init ISO for {name}: {e}")
            return 1

        try:
            restore_selinux_labels(name)
        except Exception as e:
            ensure_common.log(f"  WARNING: Failed to restore SELinux labels for {username}: {e}")

        try:
            write_environment_file(name, pw, config)
        except Exception as e:
            ensure_common.log(f"  WARNING: Failed to write environment file for {name}: {e}")

    else:
        # Container workloads: full existing setup
        try:
            configure_subuid_subgid(pw, config)
        except Exception as e:
            ensure_common.log(f"  ERROR: Failed to configure subuid/subgid for {username}: {e}")
            return 1

        # The egress CA (P1-10, G12's container half). generate_vm_egress_ca
        # and provision_vm_pki_dirs are already name-keyed only -- nothing
        # inside either reads [vm.network] -- so they are reused verbatim
        # rather than duplicated. Must land before the container's own
        # ExecStartPre (podman run, with the --volume the generator's
        # _container_ca_delivery_args added) or that mount has nothing to
        # bind: setup.service's ExecStartPre order is what enforces "before".
        if container_uses_inspect(config):
            # setup_vm_socket_dir is also name-keyed only, and the inspect
            # socket's ExecStartPre (workload-container-inspect up) writes
            # inspect.json under the directory it creates -- the socket's own
            # Requires=/After= names only setup.service (never the workload's
            # own unit, VM or container: generate_vm_inspect_socket's docstring
            # is explicit that the listener must exist before the workload's
            # first packet), so nothing else in the container path creates it.
            try:
                setup_vm_socket_dir(pw, name)
            except Exception as e:
                ensure_common.log(f"  ERROR: Failed to create the egress inspector's "
                    f"runtime directory for {name}: {e}")
                return 1
            try:
                generate_vm_egress_ca(pw, name)
            except Exception as e:
                ensure_common.log(f"  ERROR: Failed to generate egress CA for {name}: {e}")
                return 1
            try:
                provision_vm_pki_dirs(pw, name)
            except Exception as e:
                ensure_common.log(f"  ERROR: Failed to prepare the egress PKI directories "
                    f"for {name}: {e}")
                return 1

        try:
            setup_volume_directories(pw, config)
        except Exception as e:
            ensure_common.log(f"  ERROR: Failed to create volume directories for {username}: {e}")
            return 1

        # After the volume dirs: a required file lands inside one of them, and
        # only the operator's copy step decides its owner.
        try:
            setup_required_file_ownership(pw, config)
        except Exception as e:
            ensure_common.log(f"  ERROR: Failed to fix required-file ownership for {username}: {e}")
            return 1

        try:
            write_environment_file(name, pw, config)
        except Exception as e:
            ensure_common.log(f"  ERROR: Failed to write environment file for {name}: {e}")
            return 1

        try:
            restore_selinux_labels(name)
        except Exception as e:
            ensure_common.log(f"  WARNING: Failed to restore SELinux labels for {username}: {e}")

        try:
            enable_linger(pw)
        except Exception as e:
            ensure_common.log(f"  ERROR: Failed to enable linger for {username}: {e}")
            return 1

        try:
            ensure_manager_slice(pw, config)
        except Exception as e:
            ensure_common.log(f"  WARNING: Failed to migrate user@{pw.pw_uid}.service into its "
                f"slice for {username}: {e}")

    ensure_common.log(f"User setup complete for {name} ({kind})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
