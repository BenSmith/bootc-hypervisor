#!/usr/bin/python3
"""
Ensure a single workload user is fully configured for rootless podman.

Called as ExecStartPre=+ (root) in each workload service, and by
workloadctl enable.  Idempotent -- safe to run on every service start.

Usage: workload-ensure-user <workload-name>

The program is lib/ensure_user.py. This file is main().
"""

import sys

from ensure_user import ensure_user


def main(argv):
    if len(argv) != 2:
        print(f"Usage: {argv[0]} <workload-name>", file=sys.stderr)
        return 1
    return ensure_user(argv[1])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
