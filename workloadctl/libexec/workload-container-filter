#!/usr/bin/python3
"""
workload-container-filter: arm or disarm one container workload's uid-keyed
egress policy.

Usage: workload-container-filter <up|down> <name>

Container counterpart of workload-vm-filter (P1-8 in the container
egress-parity build spec). `up` runs as an ExecStartPre, `down` as the
matching ExecStopPost, on the one unit that pod/bridge mode orders BEFORE
every member container: the container's own unit in `single` mode, and the
pod-create/network-create head unit (`workload-<name>-pod.service` /
`-net.service`) in `pod`/`bridge`. NOT the umbrella -- it carries `After=`
its members, so arming there ran only once every container was already up
and the workload spent the whole of member startup unfiltered. See
_head_unit()'s docstring in generators/workload-generate. Both operate on set
*elements* in the shared `inet workload_filter` table; neither ever touches a
rule. See workload-vm-filter's module docstring for why this has to be a
script and not a handful of ExecStartPre lines -- the allowlist-edit /
stale-element argument (nft has no "delete every element whose first field is
this uid") applies unchanged.

WHAT DIFFERS FROM workload-vm-filter

- No bridge check. Containers have no VM-style bridge escape hatch; the one
  topology where uid attribution might not hold (`[network] mode = "host"`)
  is excluded upstream, in container_uses_inspect() itself, pending the P0-1
  hardware spike -- so by the time this script runs, "has a trigger" already
  means "uid attribution holds".
- No resolver. There is no per-workload synthesising DNS responder for
  containers (D7) -- a container resolves through the host's own resolver --
  so there is no answer document to write here.
- The gate is container_uses_inspect(), not `egress == "filtered"`: presence
  of a trigger ([network].hosts, [[network.allow]], or [[network.policy]]) is
  the whole statement for containers (R3 -- no default-deny, no `egress`
  key).

EXIT CODES: same convention as workload-vm-filter. `up` fails loudly -- a
workload that has a trigger and did not arm would run unfiltered while its
config claims otherwise. `down` is tolerant.
"""
import json
import pwd
import subprocess
import sys

sys.dont_write_bytecode = True

from vm import (
    NFT_BIN, NFT_SETS, NFT_SKELETON, NFT_TABLE,
    vm_filter_delete_command, vm_owned_elements,
)
from workload_lib import (
    container_allow_entries, container_allow_resolved, container_filter_commands,
    container_uses_inspect, workload_config_path,
)

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - 3.11+ everywhere we ship
    tomllib = None


def log(msg):
    print(msg, flush=True)


def run(argv, check):
    return subprocess.run(argv, capture_output=True, text=True, check=check,
                          timeout=30)


def workload_uid(name: str) -> int:
    return pwd.getpwnam(f"_wl-{name}").pw_uid


def load_config(name: str) -> dict:
    with open(workload_config_path(name), "rb") as f:
        return tomllib.load(f)


def purge(uid: int) -> int:
    """Remove every element owned by `uid` from every set.

    Verbatim copy of workload-vm-filter's purge(): same sets
    (NFT_SETS -- wl_filtered, wl_allow4, wl_allow6), same tolerant-on-missing
    behaviour. Nothing here is container-specific, so there is nothing to
    change.
    """
    removed = 0
    for set_name in NFT_SETS:
        listed = run([NFT_BIN, "-j", "list", "set", *NFT_TABLE.split(),
                      set_name], check=False)
        if listed.returncode != 0:
            continue
        try:
            payload = json.loads(listed.stdout)
        except ValueError:
            continue
        elems = []
        for item in payload.get("nftables", []):
            if "set" in item:
                elems = item["set"].get("elem", [])
                break
        owned = vm_owned_elements(uid, elems)
        if not owned:
            continue
        result = run(vm_filter_delete_command(set_name, owned), check=False)
        if result.returncode == 0:
            removed += len(owned)
        else:
            log(f"  WARNING: could not clear {set_name}: "
                f"{result.stderr.strip()}")
    return removed


def up(name: str) -> int:
    uid = workload_uid(name)
    config = load_config(name)
    net = config.get("network", {}) or {}

    # Not tolerant: everything below depends on the table existing. Same
    # not-tolerant choice workload-vm-filter makes, for the same reason.
    run([NFT_BIN, "-f", NFT_SKELETON], check=True)

    stale = purge(uid)
    if stale:
        log(f"  Cleared {stale} stale element(s) for uid {uid}")

    if not container_uses_inspect(config):
        log(f"  {name} has no [network] trigger: not filtered")
        return 0

    allow = container_allow_entries(net)
    resolved = container_allow_resolved(allow)
    for argv in container_filter_commands(uid, allow, "add", resolved):
        run(argv, check=True)
    log(f"  Filtered uid {uid} with {len(allow)} allow entr"
        f"{'y' if len(allow) == 1 else 'ies'}")
    return 0


def down(name: str) -> int:
    try:
        uid = workload_uid(name)
    except KeyError:
        # The user is already gone; nothing can be armed.
        return 0
    purge(uid)
    return 0


def main(argv):
    if len(argv) != 3 or argv[1] not in ("up", "down"):
        print(f"usage: {argv[0]} <up|down> <name>", file=sys.stderr)
        return 2
    action, name = argv[1], argv[2]
    if action == "up":
        return up(name)
    return down(name)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # noqa: BLE001
        print(f"  ERROR: {e}", file=sys.stderr)
        sys.exit(1 if len(sys.argv) > 1 and sys.argv[1] == "up" else 0)
