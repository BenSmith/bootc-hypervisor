#!/usr/bin/python3
"""
workload-container-filter: arm or disarm one container workload's uid-keyed
egress policy.

Usage: workload-container-filter <up|down> <name>

`up` runs as an ExecStartPre, `down` as the matching ExecStopPost, on the one
unit that pod/bridge mode orders BEFORE every member container: the
container's own unit in `single` mode, and the pod-create/network-create head
unit (`workload-<name>-pod.service` / `-net.service`) in `pod`/`bridge`. NOT
the umbrella -- it carries `After=` its members, so arming there would run
only once every container was already up, and the workload would spend the
whole of member startup unfiltered. See _head_unit()'s docstring in
lib/gen_container_heads.py.

The program is lib/filter_arm.py, which is one body for both substrates; this
file is main(), bound to its container substrate.
"""
import sys

sys.dont_write_bytecode = True

from filter_arm import CONTAINER, down, up
from helper_main import run_helper, up_down_main


def main(argv):
    return up_down_main(argv, lambda name: up(CONTAINER, name), down)


if __name__ == "__main__":
    sys.exit(run_helper(main, sys.argv))
