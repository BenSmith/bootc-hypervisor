#!/usr/bin/python3
"""
workload-vm-broker: write one workload's broker.toml.

Usage: workload-vm-broker config <name>

Runs as the ExecStartPre of that workload's own broker instance
(workload-<name>-broker.service) and writes the instance's config into the
RuntimeDirectory= systemd has already created as the unit's dynamic user -- so
the file is written unprivileged, at 0600 inside a 0700 directory, and there is
no window in which it is wider than it ends up.

Regenerated at every start rather than installed once, which is what
/run buys over /etc (ADR 007 decision 2 as amended): the config cannot drift
from the bundle it is a pure function of, and it cannot serve the previous
boot's credential set.

WHAT USED TO BE HERE

`up` and `down`, an ExecStartPre/ExecStopPost pair on the VM unit that owned a
shared advertised endpoint (a dummy interface plus an nftables nat chain) and
this workload's element in a uid -> broker map. ADR 007 deleted what they
reached: with one broker instance per workload, bound to an address derived from
that workload's uid and dialled by the inspector, there is no advertised
endpoint for a guest to name and no map to translate it. They went with the
mechanism rather than being left inert, so this helper is one verb now.

The uid-reuse sweep those verbs performed went too, and nothing replaces it
because nothing needs to: the entitlement it was scrubbing lived in a
host-global map keyed by a uid the allocator reuses, and the entitlement now
lives in the workload's own generated unit, which is deleted with the workload.

EXIT CODES

`config` fails loudly. A broker started against a stale config serves the wrong
credentials, and one started against no config serves none -- both are worse
than a start that does not happen, and the unit's ExecStartPre is deliberately
not `-` prefixed for the same reason.
"""
import os
import pwd
import sys

sys.dont_write_bytecode = True

from vm import (
    render_vm_broker_config, vm_broker_config_path, vm_uses_credentials,
)
from workload_lib import workload_config_path

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - 3.11+ everywhere we ship
    tomllib = None


def log(msg):
    print(msg, flush=True)


def load_config(name: str) -> dict:
    with open(workload_config_path(name), "rb") as f:
        return tomllib.load(f)


def write_config(name: str) -> int:
    """Render this workload's broker.toml into the instance's runtime directory.

    A pure function of the workload TOML and the workload uid, rewritten at
    every start (design D2). Nothing here reconciles anything: there is no
    previous file to compare against, because systemd removed the runtime
    directory when the instance last stopped, and that is precisely what stops
    an instance serving the previous boot's credential set.

    UNPRIVILEGED, and the whole verb depends on it. It runs as the instance's
    own DynamicUser, inside the unit's sandbox, so the file it writes is owned
    by the uid the broker runs as and by nothing else -- no chown, and no window
    in which the material's config is readable by the workload uid. Everything
    it reads (the bundle, the passwd db) is world-readable.

    Failing is the right outcome for every error below. A broker started against
    a missing or stale config either refuses every request or attaches the wrong
    credential to one, and the second is silent.
    """
    config = load_config(name)
    uid = pwd.getpwnam(f"_wl-{name}").pw_uid
    if not vm_uses_credentials(config):
        # The generator does not emit an instance for such a workload, so
        # reaching here means a unit outlived the config that produced it --
        # a hand-edited unit, or a TOML edited without a regeneration. Refused
        # rather than written empty: the broker exits on a config with no
        # sandboxes anyway, and this message names the cause.
        print(f"  ERROR: {name} declares no [[vm.network.credential]] blocks "
              f"(or is not inspected), so it has no broker instance. This unit "
              f"is stale: `workloadctl reload {name}`", file=sys.stderr)
        return 1
    path = vm_broker_config_path(name)
    path.parent.mkdir(parents=True, exist_ok=True)
    text = render_vm_broker_config(config, uid)
    # Written through a temporary and renamed, so a broker that is somehow
    # already reading cannot see a half-written table -- and 0600 before the
    # rename rather than after, so the file is never briefly wider than it ends
    # up. The directory is already 0700 (RuntimeDirectoryMode=); this is the
    # second half of the same rule and costs nothing.
    tmp = path.with_name(path.name + ".new")
    with open(tmp, "w") as fh:
        fh.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    log(f"  Wrote {path} for uid {uid}")
    return 0


def main(argv):
    if len(argv) != 3 or argv[1] != "config":
        print(f"usage: {argv[0]} config <name>", file=sys.stderr)
        return 2
    return write_config(argv[2])


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # noqa: BLE001
        print(f"  ERROR: {e}", file=sys.stderr)
        # Always 1. There is no tolerant verb left: `down` was the one, and it
        # was tolerant because its element was legitimately absent whenever a
        # start had failed before installing it. A config that did not get
        # written has no such benign case -- it leaves the broker reading a
        # stale file or none.
        sys.exit(1)
