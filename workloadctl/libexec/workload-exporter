#!/usr/bin/python3
"""
Prometheus metrics HTTP server for workloadctl workloads.

Serves /metrics on port 9110. Collects per-workload systemd state,
cgroup v2 resource usage, and podman health check status.

Designed to run as a long-lived systemd service (Type=simple).
Safe to scrape concurrently — collection is synchronous per request,
no shared mutable state.

Usage: workload-exporter [port]
  port: TCP port to listen on (default: 9110)
"""

import os
import subprocess
import sys
import time
import tomllib
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

# --- workloadctl lib bootstrap ---------------------------------------------
# Keep this block byte-identical across bin/workloadctl, generators/workload-
# generate, and libexec/workload-{ensure-user,write-env,exporter}. Locates
# workload_lib.py (and its sibling podman.py) in: this script's own dir
# (installed libexec scripts), <repo>/lib (dev checkout), or
# /usr/libexec/workloadctl (installed /usr/bin entrypoint). First match wins;
# insert(0) keeps it ahead of any PyPI package of the same name. True
# centralization needs a packaging change (sitelib install or .pth file).
_here = Path(__file__).resolve().parent
for _libdir in (_here, _here.parent / "lib", Path("/usr/libexec/workloadctl")):
    if (_libdir / "workload_lib.py").is_file():
        sys.path.insert(0, str(_libdir))
        break
# --- end bootstrap ---------------------------------------------------------
from podman import Podman


WORKLOAD_CONFIG_DIR = Path(
    os.environ.get("WORKLOAD_CONFIG_DIR", "/etc/workloads.d")
)

PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 9110


def get_enabled_workloads():
    """Read all enabled workload configs from config directory.

    Returns list of (name, has_health_check) tuples.
    """
    workloads = []
    if not WORKLOAD_CONFIG_DIR.is_dir():
        return workloads

    for toml_path in sorted(WORKLOAD_CONFIG_DIR.glob("*.toml")):
        try:
            if toml_path.resolve() == Path("/dev/null"):
                continue
        except OSError:
            continue

        try:
            with open(toml_path, "rb") as f:
                config = tomllib.load(f)
            if config.get("workload", {}).get("enabled", True):
                name = config.get("workload", {}).get("name", "")
                has_health = bool(
                    config.get("container", {}).get("health", {}).get("cmd", "")
                )
                if name:
                    workloads.append((name, has_health))
        except Exception:
            continue

    return workloads


def systemd_show(service, *properties):
    """Query systemd properties for a service. Returns dict."""
    props = ",".join(properties)
    try:
        result = subprocess.run(
            ["systemctl", "show", service, f"--property={props}"],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode != 0:
            return {}
        out = {}
        for line in result.stdout.strip().splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                out[k] = v
        return out
    except Exception:
        return {}


def get_service_metrics(name):
    """Get systemd service metrics for a workload."""
    service = f"workload-{name}.service"
    props = systemd_show(
        service,
        "ActiveState",
        "SubState",
        "NRestarts",
        "ActiveEnterTimestampMonotonic",
        "ExecMainStatus",
    )
    active_state = props.get("ActiveState", "inactive") if props else "inactive"

    metrics = {
        "active": 1 if active_state == "active" else 0,
        "failed": 1 if active_state == "failed" else 0,
        "restarts_total": int(props.get("NRestarts", 0)),
    }

    enter_mono = int(props.get("ActiveEnterTimestampMonotonic", 0))
    if enter_mono > 0 and active_state == "active":
        try:
            now_mono = time.monotonic_ns() // 1000  # convert ns to µs
            metrics["uptime_seconds"] = max(0, (now_mono - enter_mono) / 1_000_000)
        except Exception:
            pass

    return metrics


def get_container_health(name):
    """Query podman container health status for a workload.

    Returns "healthy", "unhealthy", "starting", or None if no health check.
    Runs podman inspect as the workload user.
    """
    username = f"_wl-{name}"
    try:
        import pwd as _pwd
        pw = _pwd.getpwnam(username)
        uid = pw.pw_uid
    except (KeyError, ImportError):
        return None

    try:
        return Podman.for_user(
            username, uid, pw.pw_dir, timeout=5
        ).container_health(f"workload-{name}")
    except Exception:
        return None


def find_workload_cgroup(name):
    """Find the cgroup path for a workload's podman container.

    Rootless podman containers live under:
    /sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/app.slice/libpod-*.scope
    """
    username = f"_wl-{name}"
    try:
        import pwd
        pw = pwd.getpwnam(username)
        uid = pw.pw_uid
    except (KeyError, ImportError):
        return None

    user_slice = Path(f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service")
    if not user_slice.is_dir():
        return None

    for scope in user_slice.rglob("libpod-*.scope"):
        if scope.is_dir():
            return scope

    return None


def read_cgroup_metric(cgroup_path, filename):
    """Read a single value from a cgroup file."""
    try:
        content = (cgroup_path / filename).read_text().strip()
        if content == "max":
            return None
        return int(content)
    except (OSError, ValueError):
        return None


def read_cpu_usage(cgroup_path):
    """Read total CPU usage in seconds from cpu.stat."""
    try:
        content = (cgroup_path / "cpu.stat").read_text()
        for line in content.splitlines():
            if line.startswith("usage_usec"):
                return int(line.split()[1]) / 1_000_000  # µs → seconds
    except (OSError, ValueError):
        pass
    return None


def get_cgroup_metrics(name):
    """Get resource metrics from cgroup v2 for a workload."""
    cgroup = find_workload_cgroup(name)
    if not cgroup:
        return {}

    metrics = {}

    cpu = read_cpu_usage(cgroup)
    if cpu is not None:
        metrics["cpu_usage_seconds_total"] = cpu

    mem = read_cgroup_metric(cgroup, "memory.current")
    if mem is not None:
        metrics["memory_current_bytes"] = mem

    mem_max = read_cgroup_metric(cgroup, "memory.max")
    if mem_max is not None:
        metrics["memory_max_bytes"] = mem_max

    pids = read_cgroup_metric(cgroup, "pids.current")
    if pids is not None:
        metrics["pids_current"] = pids

    return metrics


def format_metrics(all_metrics):
    """Format metrics in Prometheus exposition format."""
    lines = [
        "# Workload metrics collected by workload-exporter",
        f"# Generated at {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}",
        "",
    ]

    type_defs = [
        ("workload_active", "gauge", "Whether the workload service is active (1) or not (0)"),
        ("workload_failed", "gauge", "Whether the workload service is in failed state (1) or not (0)"),
        ("workload_restarts_total", "counter", "Total number of service restarts"),
        ("workload_uptime_seconds", "gauge", "Seconds since the service entered active state"),
        ("workload_cpu_usage_seconds_total", "counter", "Total CPU time consumed in seconds"),
        ("workload_memory_current_bytes", "gauge", "Current memory usage in bytes"),
        ("workload_memory_max_bytes", "gauge", "Memory limit in bytes"),
        ("workload_pids_current", "gauge", "Current number of processes"),
        ("workload_health", "gauge", "Container health check status (1=healthy, 0=unhealthy)"),
    ]

    for metric_name, metric_type, help_text in type_defs:
        lines.append(f"# HELP {metric_name} {help_text}")
        lines.append(f"# TYPE {metric_name} {metric_type}")

        for workload_name, svc_metrics, cgroup_metrics in all_metrics:
            key = metric_name.replace("workload_", "")
            if key in svc_metrics:
                value = svc_metrics[key]
                if isinstance(value, float):
                    lines.append(f'{metric_name}{{workload="{workload_name}"}} {value:.2f}')
                else:
                    lines.append(f'{metric_name}{{workload="{workload_name}"}} {value}')
            elif key in cgroup_metrics:
                value = cgroup_metrics[key]
                if isinstance(value, float):
                    lines.append(f'{metric_name}{{workload="{workload_name}"}} {value:.6f}')
                else:
                    lines.append(f'{metric_name}{{workload="{workload_name}"}} {value}')

        lines.append("")

    lines.append("# HELP workload_enabled_total Total number of enabled workloads")
    lines.append("# TYPE workload_enabled_total gauge")
    lines.append(f"workload_enabled_total {len(all_metrics)}")
    lines.append("")

    lines.append("# HELP workload_metrics_last_collect_timestamp_seconds Unix timestamp of last metrics collection")
    lines.append("# TYPE workload_metrics_last_collect_timestamp_seconds gauge")
    lines.append(f"workload_metrics_last_collect_timestamp_seconds {time.time():.0f}")
    lines.append("")

    return "\n".join(lines)


class MetricsHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path not in ("/metrics", "/metrics/"):
            self.send_response(404)
            self.end_headers()
            return
        try:
            workloads = get_enabled_workloads()
            all_metrics = []
            for name, has_health in workloads:
                svc = get_service_metrics(name) or {}
                cgroup = get_cgroup_metrics(name)
                if has_health:
                    health = get_container_health(name)
                    if health is not None:
                        svc["health"] = 1 if health == "healthy" else 0
                all_metrics.append((name, svc, cgroup))
            body = format_metrics(all_metrics).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; version=0.0.4; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        except Exception as e:
            self.send_response(500)
            self.end_headers()
            print(f"workload-exporter: collection error: {e}", file=sys.stderr)

    def log_message(self, fmt, *args):
        pass  # suppress per-request access logs


def main():
    # Bind all interfaces. The alloy agent scrapes this exporter as
    # host.containers.internal:9110; under pasta networking that name resolves
    # to the host's routable interface, never loopback, so a 127.0.0.1 bind is
    # unreachable by the very agent meant to scrape it. Port 9110 is kept out
    # of the firewall, so 0.0.0.0 here is not a LAN exposure.
    server = HTTPServer(("0.0.0.0", PORT), MetricsHandler)
    print(f"workload-exporter: listening on 0.0.0.0:{PORT}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
