#!/usr/bin/python3
"""
Prometheus metrics textfile writer for workloadctl workloads.

Collects per-workload systemd state, cgroup v2 resource usage, and podman
health check status, and writes them as a Prometheus exposition textfile for
node_exporter's textfile collector to pick up.

Runs as a root oneshot on a timer (workload-exporter.timer). Collection needs
root — it reads every workload's cgroups and shells into each rootless-podman
instance — while the only consumer, the local Alloy agent, is rootless in a
pasta netns and can do neither. So the producer drops an atomic file and Alloy
ingests it over a read-only bind mount rather than scraping a socket. There is
no network listener.

Disk usage is a second, slow producer. `du -sb` over a workload's durable
state can take seconds on a large home (tens of GB), and running it on the
fast timer stalls every other metric behind it. So `--disk` splits that walk
onto its own infrequent timer (workload-exporter-disk.timer), writing a
separate textfile in the same drop dir; node_exporter's textfile collector
globs the directory and picks up both. The fast path never touches the disk.

Usage: workload-exporter [--disk] [output_path]
  --disk:      collect only disk usage (slow walk), for the disk timer
  output_path: file to write (defaults per mode, under /run/workload-exporter)
"""

import sys

from exporter_textfile import (
    output_path,
    parse_args,
    write_disk_metrics,
    write_metrics,
)

def main(argv):
    disk_mode, override = parse_args(argv)
    target = output_path(disk_mode, override)
    if disk_mode:
        write_disk_metrics(target)
    else:
        write_metrics(target)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
