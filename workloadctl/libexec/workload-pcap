#!/usr/bin/python3
"""
workload-pcap: run one capture, and take its rules down again whatever happens.

Usage: workload-pcap run <name> <plan-json>

Runs as the whole of a transient `workload-pcap-<name>.service`. That unit —
not a try/finally in the CLI — is what guarantees teardown: it survives a
dropped session, a `kill -9` of the CLI, and a reboot, and its RuntimeMaxSec is
the capture's duration bound.

The plan arrives as JSON rather than being re-derived here. If this program
recomputed it from the config the two could disagree, and the contract of
`pcap --dry-run` is precisely that what was printed is what runs.

WHAT IT INSTALLS

  host   a non-terminating `log` rule in inet workload_filter's output chain,
         plus (for -Q in/inout) a pcap_input chain carrying one rule selected
         by conntrack mark. Read back with `tcpdump -i nflog:<group>`.
  guest  for a VM, a filter-dump object added over QMP; for a container,
         tcpdump inside the workload's own network namespace.

Both are removed on the way out — in a finally, and again by the unit's
ExecStopPost if this process never reaches it.

TIMESTAMPS ON A VM'S GUEST-SIDE CAPTURE

filter-dump stamps packets with QEMU_CLOCK_VIRTUAL + start_ts, which is wrong
twice: the clock counts from VM start rather than capture start, and start_ts
reinterprets the guest's UTC RTC as host local time. The offset is therefore
`VM uptime + host UTC offset`, and only the first term is guessable. So it is
measured instead — the wall-clock time of a probe packet this program emits is
compared with the timestamp that packet carries in the finished file, and every
record is shifted by the difference. That needs nothing from the guest and is
immune to both error terms. It is also self-neutralising: were QEMU fixed, the
measured difference would be ~0 and the shift a no-op.

Reading and rewriting those files is done in lib/pcap.py rather than through
capinfos and editcap, which ship in a package that is not installed by default.

The program is lib/pcap_session.py (the run and its cleanup) over one module
per vantage: lib/pcap_host_tap.py, lib/pcap_vm_tap.py and
lib/pcap_container_tap.py. This file is main(), and the SIGTERM handler that
turns the unit's stop into an unwind through the run's finally.
"""
import json
import signal
import sys

sys.dont_write_bytecode = True

from pcap_session import cleanup, run


def _exit_on_term(signum, _frame):
    """Turn SIGTERM into SystemExit so the `finally` in main() actually runs.

    Python's default SIGTERM disposition terminates the process outright — it
    does NOT unwind, so finally blocks are skipped. Which means the ordinary
    `systemctl stop` path, the one an operator uses every time, was the one
    path where the guest-side file never got finalized: the process died, and
    the unit's ExecStopPost then found a staged file with nobody left to move
    it. Measured, not theorised.

    SystemExit unwinds normally, so teardown, the timestamp correction and the
    move all happen before the process goes.
    """
    raise SystemExit(0)


signal.signal(signal.SIGTERM, _exit_on_term)


def main(argv):
    if len(argv) == 3 and argv[1] == "cleanup":
        return cleanup(argv[2])
    if len(argv) != 4 or argv[1] != "run":
        print(f"usage: {argv[0]} run <name> <plan-json>\n"
              f"       {argv[0]} cleanup <name>", file=sys.stderr)
        return 2
    return run(argv[2], json.loads(argv[3]))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # noqa: BLE001
        print(f"  ERROR: {e}", file=sys.stderr)
        sys.exit(1)
