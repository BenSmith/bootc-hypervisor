[Unit]
Description=Write the workload metrics textfile for node_exporter
Documentation=man:workload-exporter

[Service]
Type=oneshot
ExecStart=/usr/libexec/workloadctl/workload-exporter

# Hardening. No network role: collects from cgroups, rootless-podman, and VM
# QMP sockets, then drops a textfile under /run/workload-exporter.
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
# The only writable path. ProtectSystem=strict makes the rest read-only; the
# drop dir is pre-created by tmpfiles (workloads-dirs.conf) so this bind exists.
ReadWritePaths=/run/workload-exporter
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
