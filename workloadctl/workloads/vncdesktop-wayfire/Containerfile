  oswitch \
  place \
  resize \
  switcher \
  vswitch \
  wayfire-shell \
  window-rules \
  wm-actions \
  wobbly \
  zoom

[output:HEADLESS-1]
mode = 1920x1080@60000

[autostart]
background = wf-background
panel = wf-panel
dock = wf-dock
notifications = mako

[command]
