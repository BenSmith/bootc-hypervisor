# --- wf-shell config ---
# Panel widgets that talk to system buses (volume, network, battery) fail in
# this container with "Connection refused" because NetworkManager / UPower /
# the PulseAudio system socket aren't present. Stick to self-contained widgets.

RUN cat > /etc/xdg/wf-shell.ini <<'INI'
[panel]
widgets_left = menu
widgets_center = window-list
widgets_right = clock
position = top
minimal_height = 32

[dock]
position = bottom
INI

# --- Foot terminal config ---

