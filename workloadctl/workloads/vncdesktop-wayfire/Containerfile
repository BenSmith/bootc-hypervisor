# Headless Wayfire Desktop (VNC)
#
# Wayfire runs headlessly (WLR_BACKENDS=headless). Access via wayvnc on
# port 5900.
#
# Build:
#   sudo workloadctl build vncdesktop-wayfire
#
# Run:
#   workload-ctl enable vncdesktop-wayfire

FROM registry.fedoraproject.org/fedora:44

RUN dnf install --setopt=install_weak_deps=False --nodocs -y \
    adwaita-cursor-theme \
    adwaita-icon-theme \
    bash-completion \
    clinfo \
    dbus-daemon \
    drm_info \
    eglinfo \
    ffmpegthumbnailer \
