    imv \
    just \
    less \
    librsvg2 \
    mako \
    mesa-dri-drivers \
    mesa-libEGL \
    mesa-libGL \
    mesa-libgbm \
    mesa-vulkan-drivers \
    mpv \
    nano \
    neovim \
    procps-ng \
    rsync \
