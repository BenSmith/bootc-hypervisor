# Headless Sway Desktop (VNC)
#
# Sway runs headlessly (WLR_BACKENDS=headless). Access via wayvnc on
# port 5900. Set VNC_PASSWORD to enable authentication.
#
# Build:
#   sudo workloadctl build vncdesktop-sway
#
# Run:
#   workloadctl enable vncdesktop-sway

FROM registry.fedoraproject.org/fedora:44

RUN dnf install --setopt=install_weak_deps=False --nodocs -y \
    abattis-cantarell-fonts \
    adwaita-cursor-theme \
    arc-theme \
    bash-completion \
    btop \
    dbus-daemon \
    firefox \
    foot \
    fuzzel \
    geany \
    git \
    google-noto-color-emoji-fonts \
    google-noto-sans-fonts \
    grim \
    hostname \
    htop \
    imv \
    jetbrains-mono-fonts \
    less \
    librsvg2 \
    mako \
    mesa-dri-drivers \
    mesa-libEGL \
    mesa-libGL \
    mesa-libgbm \
    mesa-vulkan-drivers \
    nano \
    neovim \
    papirus-icon-theme \
    procps-ng \
    rsync \
    slurp \
    sudo \
    sway \
    swappy \
    systemd \
    systemd-udev \
    thunar \
    tmux \
    util-linux \
    waybar \
    wayvnc \
    wdisplays \
    wf-recorder \
    wl-clipboard \
    wlr-randr \
    wlrctl \
    xdg-user-dirs \
    xdg-utils \
    xorg-x11-server-Xwayland \
    && dnf clean all

RUN sed -i 's/^hosts:.*/hosts: files myhostname resolve [!UNAVAIL=return] dns/' /etc/nsswitch.conf

# Fedora ships /usr/bin/sway with cap_sys_nice+ep for realtime scheduling.
# In a container with a reduced capability bounding set, execve() fails with
# EPERM because the kernel can't grant the file's permitted caps. Strip them —
# realtime scheduling is unnecessary for a headless VNC compositor.
RUN setcap -r /usr/bin/sway

# --- Firefox stability fix ---
# Disable Wayland vsync: Firefox freezes under wlroots compositors without
# mouse movement. Mozilla bug #1954343.

RUN mkdir -p /usr/lib/firefox/browser/defaults/preferences && \
    cat > /usr/lib/firefox/browser/defaults/preferences/99-container.js <<'JS'
pref("widget.wayland.vsync.enabled", false);
JS

