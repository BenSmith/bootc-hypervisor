# --- XDG runtime dir service ---
# container-bootstrap.service is gated by ConditionPathExists so it only runs
# once, but /run is a fresh tmpfs on every container start. This service
# creates /run/user/${CONTAINER_UID} unconditionally before any user service.

RUN cat > /usr/lib/systemd/system/xdg-runtime-dir.service <<'UNIT'
[Unit]
After=container-bootstrap.service
Description=Create XDG_RUNTIME_DIR for container user
Requires=container-bootstrap.service

[Service]
ExecStart=/bin/sh -c 'mkdir -p /run/user/${CONTAINER_UID} && chown ${CONTAINER_UID}:${CONTAINER_GID} /run/user/${CONTAINER_UID} && chmod 0700 /run/user/${CONTAINER_UID}'
PassEnvironment=CONTAINER_UID CONTAINER_GID
RemainAfterExit=yes
Type=oneshot

[Install]
WantedBy=multi-user.target
UNIT

# --- Sway startup script ---

RUN cat > /usr/local/bin/start-sway <<'SCRIPT'
#!/bin/sh
set -e
export HOME="/home/${CONTAINER_USER}"
export XDG_RUNTIME_DIR="/run/user/${CONTAINER_UID}"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"

ls /dev/dri/renderD* >/dev/null 2>&1 || {
    export WLR_RENDERER=pixman
    export LIBGL_ALWAYS_SOFTWARE=1
}

dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --nofork --nopidfile &

cd
exec /usr/bin/sway -c /etc/sway/config
SCRIPT

RUN chmod +x /usr/local/bin/start-sway

# --- Sway systemd service ---

RUN cat > /usr/lib/systemd/system/sway.service <<'UNIT'
[Unit]
After=xdg-runtime-dir.service
Description=Sway Wayland Compositor (headless)
Requires=xdg-runtime-dir.service

[Service]
PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER LANG NO_AT_BRIDGE
Restart=on-failure
RestartSec=3
TasksMax=infinity
Type=simple

Environment=GDK_BACKEND=wayland
Environment=LIBSEAT_BACKEND=noop
Environment=MOZ_ENABLE_WAYLAND=1
Environment=QT_QPA_PLATFORM=wayland
Environment=WLR_BACKENDS=headless
Environment=WLR_HEADLESS_OUTPUTS=1
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=XCURSOR_SIZE=24
Environment=XCURSOR_THEME=Adwaita
Environment=XDG_CURRENT_DESKTOP=sway
Environment=XDG_SESSION_TYPE=wayland

ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /usr/local/bin/start-sway

[Install]
WantedBy=multi-user.target
UNIT

# --- Wayland ready gate ---

RUN cat > /usr/local/bin/wait-for-wayland <<'SCRIPT'
#!/bin/sh
RUNTIME_DIR="/run/user/${CONTAINER_UID}"
ENV_FILE="/run/wayland-display.env"

while true; do
    for sock in "$RUNTIME_DIR"/wayland-*; do
        case "$sock" in *.lock) continue ;; esac
        if [ -S "$sock" ]; then
            DISPLAY_NAME="${sock##*/}"
            echo "WAYLAND_DISPLAY=${DISPLAY_NAME}" > "$ENV_FILE"
            exit 0
        fi
    done
    sleep 0.5
done
SCRIPT

RUN chmod +x /usr/local/bin/wait-for-wayland

RUN cat > /usr/lib/systemd/system/sway-wayland-ready.service <<'UNIT'
[Unit]
After=sway.service
Description=Wait for sway Wayland socket
Requires=sway.service

[Service]
ExecStart=/usr/local/bin/wait-for-wayland
PassEnvironment=CONTAINER_UID
RemainAfterExit=yes
Type=oneshot

[Install]
WantedBy=multi-user.target
UNIT

# --- set-resolution systemd service ---

RUN cat > /usr/lib/systemd/system/set-resolution.service <<'UNIT'
[Unit]
After=sway-wayland-ready.service
Description=Set virtual output resolution
Requires=sway-wayland-ready.service

[Service]
ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /bin/sh -c '. /run/wayland-display.env && export XDG_RUNTIME_DIR=/run/user/${CONTAINER_UID} WAYLAND_DISPLAY && wlr-randr --output HEADLESS-1 --custom-mode "${DESKTOP_RESOLUTION:-1920x1080}@60"'

PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER DESKTOP_RESOLUTION
RemainAfterExit=yes
Type=oneshot

[Install]
WantedBy=multi-user.target
UNIT

# --- wayvnc launcher ---
# Writes wayvnc auth config from VNC_PASSWORD/VNC_USERNAME (if set) before
# spawning wayvnc. With no VNC_PASSWORD, wayvnc runs unauthenticated.

RUN cat > /usr/local/bin/start-wayvnc <<'SCRIPT'
#!/bin/sh
set -e
. /run/wayland-display.env
export WAYLAND_DISPLAY
export HOME="/home/${CONTAINER_USER}"
export XDG_RUNTIME_DIR="/run/user/${CONTAINER_UID}"

mkdir -p "$HOME/.config/wayvnc"
if [ -n "${VNC_PASSWORD:-}" ]; then
    cat > "$HOME/.config/wayvnc/config" <<CFG
enable_auth=true
username=${VNC_USERNAME:-desktop}
password=${VNC_PASSWORD}
CFG
    chmod 600 "$HOME/.config/wayvnc/config"
    echo "wayvnc: authentication enabled (username: ${VNC_USERNAME:-desktop})"
else
    rm -f "$HOME/.config/wayvnc/config"
    echo "wayvnc: WARNING — no authentication. Set VNC_PASSWORD to enable."
fi

cd
exec /usr/bin/wayvnc 0.0.0.0 5900
SCRIPT

RUN chmod +x /usr/local/bin/start-wayvnc

RUN cat > /usr/lib/systemd/system/wayvnc.service <<'UNIT'
[Unit]
After=set-resolution.service
Description=wayvnc VNC server
Requires=set-resolution.service

[Service]
ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /usr/local/bin/start-wayvnc
PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER VNC_PASSWORD VNC_USERNAME
Restart=on-failure
RestartSec=3
Type=simple

[Install]
WantedBy=multi-user.target
UNIT

# --- Bootstrap ---

RUN cat > /usr/local/bin/container-bootstrap <<'SCRIPT'
#!/bin/bash
set -e
: "${CONTAINER_USER:?must be set}"
: "${CONTAINER_UID:?must be set}"
: "${CONTAINER_GID:?must be set}"

HOME_DIR="/home/$CONTAINER_USER"

groupadd -g "$CONTAINER_GID" "$CONTAINER_USER" 2>/dev/null || true
useradd -u "$CONTAINER_UID" -g "$CONTAINER_GID" -d "$HOME_DIR" -s /bin/bash -M "$CONTAINER_USER" 2>/dev/null || true
chown "$CONTAINER_UID:$CONTAINER_GID" "$HOME_DIR"

for grp in render video; do
    if getent group "$grp" >/dev/null 2>&1; then
        usermod -aG "$grp" "$CONTAINER_USER" 2>/dev/null || true
    fi
done

mkdir -p /etc/sudoers.d
echo "$CONTAINER_USER ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/container-user
chown 0:0 /etc/sudoers.d/container-user
chmod 0440 /etc/sudoers.d/container-user

echo "Bootstrap complete."
SCRIPT

RUN cat > /usr/lib/systemd/system/container-bootstrap.service <<'UNIT'
[Unit]
After=sysinit.target
Before=sway.service
DefaultDependencies=no
Description=Container bootstrap

[Service]
ExecStart=/usr/local/bin/container-bootstrap
PassEnvironment=CONTAINER_USER CONTAINER_UID CONTAINER_GID
Type=oneshot

[Install]
WantedBy=multi-user.target
UNIT

RUN mkdir -p /etc/systemd/journald.conf.d && \
    cat > /etc/systemd/journald.conf.d/10-container.conf <<'CONF'
[Journal]
Storage=volatile
ForwardToSocket=/run/host-systemd/journal/socket
CONF

RUN mkdir -p /etc/systemd/system/systemd-journald.service.d && \
    cat > /etc/systemd/system/systemd-journald.service.d/10-container.conf <<'DROPIN'
[Service]
CapabilityBoundingSet=
IPAddressDeny=
LockPersonality=no
MemoryDenyWriteExecute=no
NoNewPrivileges=no
ProtectClock=no
RestrictAddressFamilies=
RestrictNamespaces=no
RestrictRealtime=no
RestrictSUIDSGID=no
SystemCallArchitectures=
SystemCallFilter=
DROPIN

RUN mkdir -p /etc/systemd/system && \
    ln -sf /dev/null /etc/systemd/system/rtkit-daemon.service && \
    ln -sf /dev/null /etc/systemd/system/systemd-oomd.service && \
    ln -sf /dev/null /etc/systemd/system/systemd-oomd.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-resolved.service && \
    ln -sf /dev/null /etc/systemd/system/systemd-resolved.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd-control.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd-kernel.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd.service && \
    systemctl enable sway sway-wayland-ready set-resolution wayvnc container-bootstrap xdg-runtime-dir && \
    chmod +x /usr/local/bin/container-bootstrap

# --- DNS fix ---
RUN printf 'nameserver 127.0.0.53\noptions single-request ndots:1\n' > /etc/resolv.conf

# Fedora 44 dropped the consolidated CA bundle files in favour of the directory-
# hash format — https://fedoraproject.org/wiki/Changes/droppingOfCertPemFile —
# which breaks apps with a bundled TLS stack that read the bundle *file*
# ("unable to load trusted SSL root certificates"). Restore the legacy names as
# symlinks to the stable extracted bundle (Fedora's documented permanent fix).
RUN B=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem && \
    ln -sf "$B" /etc/pki/tls/certs/ca-bundle.crt && \
    ln -sf "$B" /etc/pki/tls/certs/ca-certificates.crt && \
    ln -sf "$B" /etc/pki/tls/cert.pem && \
    ln -sf "$B" /etc/ssl/cert.pem

STOPSIGNAL SIGRTMIN+3
CMD ["/usr/sbin/init"]
