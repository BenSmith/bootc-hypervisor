# --- .desktop overrides ---
# Hide dependency entries that would clutter the launcher.

RUN mkdir -p /usr/local/share/applications && \
    for f in foot-server footclient thunar-bulk-rename thunar-settings xterm; do \
        printf '[Desktop Entry]\nType=Application\nName=hidden\nNoDisplay=true\n' \
            > /usr/local/share/applications/${f}.desktop ; \
    done && \
    cat > /usr/local/share/applications/btop.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=btop++
Icon=btop
Exec=foot --window-size-chars=80x24 btop
Categories=System;Monitor;
DESK

RUN cat > /usr/local/share/applications/thunar.desktop <<'DESK'
[Desktop Entry]
Type=Application
Name=Thunar File Manager
Icon=org.xfce.thunar
Exec=thunar
Categories=Utility;FileManager;
MimeType=inode/directory;
DESK

# --- Sway config ---
# Ctrl+Alt is the primary modifier — chosen because Super is typically
# intercepted by the local DE before reaching a VNC viewer. hjkl is used
# instead of arrow keys to avoid Ctrl+Alt+arrow conflicts with KDE Plasma
# workspace switching.
# Resolution is set at runtime by wlr-randr so DESKTOP_RESOLUTION can apply.

RUN mkdir -p /etc/sway && \
    cat > /etc/sway/config <<'SWAY'
### Mods and apps
set $mod Mod1+Control
set $term foot
set $menu fuzzel

### Output
output * bg #383c4a solid_color

### Appearance
default_border pixel 1
default_floating_border pixel 1
focus_follows_mouse yes
font pango:Cantarell 10
gaps inner 6
titlebar_padding 6 2

# Arc-Dark inspired colors
# class                 border    background  text      indicator  child_border
client.focused          #5294e2   #4b5162     #ffffff   #5294e2    #5294e2
client.focused_inactive #404552   #383c4a     #d3dae3   #404552    #404552
client.unfocused        #404552   #383c4a     #9da0a8   #404552    #404552
client.urgent           #c0392b   #c0392b     #ffffff   #c0392b    #c0392b

### Applications
bindsym $mod+Return exec $term
bindsym $mod+space  exec $menu

### Window management
bindsym $mod+Shift+r       reload
bindsym $mod+Shift+space   floating toggle
bindsym $mod+e             layout toggle split
bindsym $mod+f             fullscreen toggle
bindsym $mod+q             kill

# Focus (hjkl — avoids Ctrl+Alt+arrows which KDE intercepts on host)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move window in tiling layout
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Window cycle (Alt+Tab is intercepted by host DE)
bindsym $mod+Shift+Tab focus prev
bindsym $mod+Tab       focus next

### Workspaces (Ctrl+Alt+1-4 is safe on KDE — KDE uses Ctrl+F1-F4)
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+Shift+1 move container to workspace 1; workspace 1
bindsym $mod+Shift+2 move container to workspace 2; workspace 2
bindsym $mod+Shift+3 move container to workspace 3; workspace 3
bindsym $mod+Shift+4 move container to workspace 4; workspace 4

### Resize mode
mode "resize" {
    bindsym h resize shrink width  20px
    bindsym j resize grow   height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow   width  20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Autostart
exec dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec xdg-user-dirs-update
exec mako
exec waybar
SWAY

