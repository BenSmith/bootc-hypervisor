; Per-workload SELinux policy for the wolf-game-streaming workload container.
; __WL_MODULE__ is substituted with the name-keyed block name at enable time.
;
; Wolf is non-systemd, so all its processes — including Steam and bwrap — run as
; this single type. Grants:
;   /dev/uinput + /dev/input/*  — create virtual input devices, read evdev
;   /run/udev                   — device property lookups (libdrm, mesa, ALSA)
;   filesystem mount/remount    — Steam's bubblewrap sandbox (srt-bwrap)
;   Wine/Proton                 — execheap, mmap_zero, execmod for Windows PE
;   Steam IPC                   — /tmp socket and file operations

(block __WL_MODULE__
    (blockinherit container)
    (blockinherit net_container)

    ; Input devices: /dev/uinput + /dev/input/event* (event_device_t on Fedora).
    (allow process event_device_t (chr_file (open read write ioctl getattr)))
    (allow process event_device_t (dir (open read search getattr)))

    ; Udev runtime database (libdrm, mesa, ALSA).
    (allow process udev_var_run_t (dir (open read search getattr)))
    (allow process udev_var_run_t (file (open read getattr)))
    (allow process udev_var_run_t (sock_file (getattr)))
    (allow process udev_var_run_t (lnk_file (read getattr)))

    ; Steam bwrap sandbox (srt-bwrap / pressure-vessel) remounts/mounts.
    (allow process cgroup_t (filesystem (remount)))
    (allow process pstore_t (filesystem (remount)))
    (allow process bpf_t (filesystem (remount)))
    (allow process tmpfs_t (filesystem (remount)))
    (allow process devpts_t (filesystem (mount)))
    (allow process container_file_t (sock_file (mounton)))

    ; Wayland clients allocate their pixel buffers as shared memory and mmap
    ; them, which needs `map` on tmpfs_t. Without it every client that draws
    ; dies the moment it tries to, while the compositor itself stays up -- so
    ; gamescope comes up with nothing in it and nothing looks unhealthy.
    ; Diagnosed on vncdesktop-sway, where foot failed in shm.c ("failed to mmap
    ; SHM backing memory file: Permission denied").
    ;
    ; The rest of this group is bwrap/pressure-vessel building the Steam sandbox
    ; root on the tmpfs above: create/mount/watch its dirs, fully manage files
    ; there (create, mmap+exec staged binaries, link/rename/unlink, bind-mount
    ; over them) plus its symlinks, associate a proc mount, and unmount the
    ; bind-mounted container_file_t mounts on teardown. Granted directly to
    ; container_t by container-selinux's base policy, but not inherited by a
    ; per-workload type, so they must be enumerated here. Same set that
    ; wayfire-game-streaming captured at runtime against the same Steam stack.
    (allow process tmpfs_t (dir (create mounton setattr watch)))
    (allow process tmpfs_t (file (create map execute link mounton open rename setattr unlink)))
    (allow process tmpfs_t (lnk_file (create unlink)))
    (allow process container_file_t (filesystem (unmount)))
    (allow process proc_t (file (ioctl)))
    (allow process proc_t (filesystem (associate)))

    ; Steam IPC: /tmp sockets and temp files (user_tmp_t).
    (allow process user_tmp_t (dir (open read write search getattr add_name remove_name ioctl lock)))
    (allow process user_tmp_t (sock_file (create write getattr setattr unlink mounton)))
    (allow process user_tmp_t (file (open read write create getattr unlink lock map)))

    ; Wine/Proton PE loader: executable heap, NULL-page map, text relocations.
    (allow process self (process (execheap)))
    ; mmap_zero is neverallow'd for normal domains; refpolicy's exempt set is
    ; the mmap_low_domain_type attribute. Join it so the allow below is legal
    ; even when neverallow checking is on (host runs expand-check=0 today).
    (typeattributeset mmap_low_domain_type (process))
    (allow process self (memprotect (mmap_zero)))
    (allow process container_file_t (file (execmod))))
