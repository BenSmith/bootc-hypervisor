; Per-workload SELinux policy for the alloy telemetry-collector workload.
; __WL_MODULE__ is substituted with the name-keyed block name (wl_alloy) at
; enable time; do not hardcode it. inherits container (full container domain)
; and net_container (alloy reaches the central OTLP backend over the network).
;
; The allow-rules grant just journal + /proc/1 read, scoped to wl_alloy.process
; alone. alloy reads the journal via libsystemd, which mmap()s the .journal
; files (file map) and watches the directory via inotify (dir watch) — both
; confirmed by AVC denials on first run. This replaces a blanket
; security_opt = ["label=disable"]: if the host-metrics collectors (node_exporter
; reading /host/proc and /host/sys) produce AVC denials, regenerate with udica /
; `audit2allow -a` and fold the rules in here rather than reverting to label=disable.

(block __WL_MODULE__
    (blockinherit container)
    (blockinherit net_container)

    ; Runtime journal: /run/log/journal/* is labeled syslogd_var_run_t.
    (allow process syslogd_var_run_t (dir (open read search getattr watch)))
    (allow process syslogd_var_run_t (file (open read getattr map)))

    ; Persistent journal: /var/log/journal/* is labeled var_log_t.
    (allow process var_log_t (dir (open read search getattr watch)))
    (allow process var_log_t (file (open read getattr map)))

    ; Filesystem collector: node_exporter opens /host/proc/1/mounts to enumerate
    ; host mount points. /proc/1/ is labeled init_t; the type needs dir search to
    ; traverse into it and file read to read the mounts file.
    (allow process init_t (dir (search getattr open read)))
    (allow process init_t (file (open read getattr)))

    ; Workload metrics textfile: the workload-exporter oneshot drops
    ; /run/workload-exporter/workloads.prom (default label var_run_t for files
    ; under /run), bind-mounted :ro. node_exporter's textfile collector opens
    ; the directory and reads the .prom file across the mount.
    (allow process var_run_t (dir (open read search getattr)))
    (allow process var_run_t (file (open read getattr)))
)
