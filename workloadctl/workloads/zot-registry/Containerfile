FROM registry.fedoraproject.org/fedora:43

LABEL org.opencontainers.image.title="Zot Registry"
LABEL org.opencontainers.image.description="OCI-native container registry with pull-through cache and web UI"

ARG ZOT_VERSION=2.1.20
ARG ZOT_SHA256=a32e42d042d1f17b5b1317e55cc1a415a744c873dcd05c25c56b665478258bcb

# ca-certificates needed to verify TLS to upstream registries during sync.
# tar/gzip not needed — zot ships as a single static binary.
RUN dnf install --setopt=install_weak_deps=False --nodocs -y \
    ca-certificates curl \
    && dnf clean all

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl -fsSL -o /usr/local/bin/zot \
        "https://github.com/project-zot/zot/releases/download/v${ZOT_VERSION}/zot-linux-amd64" \
    && echo "${ZOT_SHA256}  /usr/local/bin/zot" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/zot

# Storage dir — volume-mounted at runtime, owned by workload user via
# workload-ensure-user. Config is mounted read-only from the workload home dir.
RUN mkdir -p /var/lib/registry /etc/zot

COPY --link --chmod=0755 entrypoint.sh /entrypoint.sh

# Registry HTTP port
EXPOSE 5000

CMD ["/entrypoint.sh"]
