# --- Bash prompt (system-wide; sourced by /etc/bashrc) ---

RUN cat > /etc/profile.d/desktop-prompt.sh << 'EOF'
if [ "$PS1" ]; then
    PS1='\[\033[01;36m\][labwc]\[\033[01;32m\] \u:\w\$\[\033[0m\] '
fi
EOF

# --- Entrypoint script ---
# Starts a per-session D-Bus, the labwc compositor on the headless backend,
# sizes the virtual output, then starts wayvnc on 0.0.0.0:5900.

RUN cat > /usr/local/bin/start-desktop.sh << 'STARTUP' && chmod 0755 /usr/local/bin/start-desktop.sh
#!/bin/bash
set -e

# Ensure XDG_RUNTIME_DIR exists — /run is a fresh tmpfs at container start.
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

ls /dev/dri/renderD* >/dev/null 2>&1 || {
    export WLR_RENDERER=pixman
    export LIBGL_ALWAYS_SOFTWARE=1
}

# Configure wayvnc auth before the compositor starts (read at wayvnc spawn).
mkdir -p "$HOME/.config/wayvnc"
if [ -n "${VNC_PASSWORD:-}" ]; then
    cat > "$HOME/.config/wayvnc/config" <<CFG
enable_auth=true
username=${VNC_USERNAME:-desktop}
password=${VNC_PASSWORD}
CFG
    chmod 600 "$HOME/.config/wayvnc/config"
    echo "wayvnc: authentication enabled (username: ${VNC_USERNAME:-desktop})"
else
    echo "wayvnc: WARNING — no authentication. Set VNC_PASSWORD to enable."
fi

# Launch labwc under a private D-Bus session (waybar/mako/clipboard need it).
dbus-run-session labwc &
LABWC_PID=$!

# Wait for the wayland socket to appear.
for i in $(seq 1 50); do
    for sock in "$XDG_RUNTIME_DIR"/wayland-*; do
        if [ -S "$sock" ] && [ "${sock##*.}" != "lock" ]; then
            export WAYLAND_DISPLAY="${sock##*/}"
            break 2
        fi
    done
    sleep 0.1
done

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo "ERROR: labwc did not create a Wayland socket"
    kill "$LABWC_PID" 2>/dev/null || true
    exit 1
fi

# Set the headless output resolution (HEADLESS-1 is wlroots' default name).
wlr-randr --output HEADLESS-1 --custom-mode "${DESKTOP_RESOLUTION:-1920x1080}@60" || true

wayvnc 0.0.0.0 5900 &
WAYVNC_PID=$!

cleanup() {
    kill "$WAYVNC_PID" 2>/dev/null || true
    kill "$LABWC_PID" 2>/dev/null || true
    wait 2>/dev/null || true
}
trap cleanup TERM INT

# Exit when either child dies — the other gets cleaned up.
wait -n "$LABWC_PID" "$WAYVNC_PID"
cleanup
STARTUP

RUN mkdir -p /run/user/1000 && chown 1000:1000 /run/user/1000 && chmod 700 /run/user/1000

# Fedora 44 dropped the consolidated CA bundle files in favour of the directory-
# hash format — https://fedoraproject.org/wiki/Changes/droppingOfCertPemFile —
# which breaks apps with a bundled TLS stack that read the bundle *file*
# ("unable to load trusted SSL root certificates"). Restore the legacy names as
# symlinks to the stable extracted bundle (Fedora's documented permanent fix).
RUN B=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem && \
    ln -sf "$B" /etc/pki/tls/certs/ca-bundle.crt && \
    ln -sf "$B" /etc/pki/tls/certs/ca-certificates.crt && \
    ln -sf "$B" /etc/pki/tls/cert.pem && \
    ln -sf "$B" /etc/ssl/cert.pem

USER desktop
WORKDIR /home/desktop

EXPOSE 5900

# tini -s: subreaper mode — reaps orphaned descendants without being PID 1
ENTRYPOINT ["/usr/bin/tini", "-s", "--"]
CMD ["/usr/local/bin/start-desktop.sh"]
