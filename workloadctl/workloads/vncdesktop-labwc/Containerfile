# Fedora 44 labwc desktop served over VNC
#
# labwc runs in headless wlroots mode (no host Wayland or KMS); wayvnc
# attaches to the labwc compositor and serves it on TCP 5900.
#
# Build:
#   sudo workloadctl build vncdesktop-labwc
#
# All desktop configuration lives in system-wide locations (/etc/xdg, /etc,
# /usr/local/share). The container user's $HOME is provided at runtime by
# a host bind mount (./home:/home/desktop), starting empty; XDG fallback
# to /etc/xdg/* serves the defaults for every tool used here. Users
# customize by dropping files into the host-side home directory.

FROM registry.fedoraproject.org/fedora:44

# Desktop session components:
#   arc-theme             - GTK theme (clean dark style)
#   btop                  - system monitor
#   cliphist              - clipboard history; pairs with wl-paste and fuzzel (Ctrl+Alt+V)
#   dbus-daemon           - per-session D-Bus (waybar, mako, clipboard need it)
#   foot                  - terminal emulator (native Wayland, lightweight)
#   fuzzel                - app launcher (native Wayland, keyboard-driven)
#   geany                 - lightweight GUI text editor
#   imv                   - image viewer (Wayland native)
#   jetbrains-mono-fonts  - monospace font for the terminal
#   labwc                 - Wayland compositor (wlroots-based)
#                           grim and xdg-desktop-portal-wlr pulled in as deps
#   labwc-menu-generator  - generates right-click menu from .desktop files
#   mako                  - notification daemon (native Wayland)
#   mesa-dri-drivers      - GBM / DRI for hardware-accelerated render node
#   mesa-libEGL           - EGL for wlroots / wayvnc
#   papirus-icon-theme    - icon set (replaces minimal Adwaita default)
#   procps-ng             - pkill, used by labwc autostart for housekeeping
#   sudo                  - passwordless sudo for the desktop user
#   swaybg                - wallpaper setter
#   thunar                - file manager
#   tini                  - minimal init / subreaper for zombie reaping
#   tmux                  - terminal multiplexer
#   waybar                - status bar
#   wayvnc                - VNC server attaching to the labwc compositor
#   wl-clipboard          - wl-copy / wl-paste for clipboard support
#   wlr-randr             - sets the headless output resolution at runtime
#   xdg-user-dirs         - creates ~/Documents, ~/Downloads etc. on first login
#   xorg-x11-server-Xwayland - X11 compatibility; labwc aborts at startup
#                              if its built-in xwayland support can't find
#                              /usr/bin/Xwayland
RUN dnf install -y --nodocs --setopt=install_weak_deps=False \
    arc-theme \
    bash-completion \
    btop \
    cliphist \
    dbus-daemon \
    foot \
    fuzzel \
    geany \
    git-core \
    imv \
    jetbrains-mono-fonts \
    labwc \
    labwc-menu-generator \
    mako \
    mesa-dri-drivers \
    mesa-libEGL \
    papirus-icon-theme \
    procps-ng \
    rsync \
    sudo \
    swaybg \
    thunar \
    tini \
    tmux \
    waybar \
    wayvnc \
    wl-clipboard \
    wlr-randr \
    xdg-user-dirs \
    xorg-x11-server-Xwayland \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN sed -i 's/^hosts:.*/hosts: files myhostname resolve [!UNAVAIL=return] dns/' /etc/nsswitch.conf

# UID 1000 matches the workload's keep-id user mapping. Use -M (no home)
# because /home/desktop is provided at runtime by the workload's
# ./home:/home/desktop bind mount; an in-image home would be shadowed anyway.
RUN useradd -M -u 1000 -s /bin/bash desktop \
    && echo "desktop ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/desktop \
    && chmod 0440 /etc/sudoers.d/desktop

# Headless wlroots backend — labwc creates a virtual output instead of needing
# a host Wayland socket or DRM/KMS device. wayvnc attaches to it.
ENV GDK_BACKEND=wayland \
    LIBSEAT_BACKEND=noop \
    MOZ_ENABLE_WAYLAND=1 \
    QT_QPA_PLATFORM=wayland \
    WLR_BACKENDS=headless \
    WLR_LIBINPUT_NO_DEVICES=1 \
    XDG_RUNTIME_DIR=/run/user/1000 \
    XDG_SESSION_TYPE=wayland

# --- labwc compositor config (system-wide; user can override via ~/.config/labwc) ---

RUN mkdir -p /etc/xdg/labwc && cat > /etc/xdg/labwc/rc.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>

  <core>
    <gap>6</gap>
  </core>

  <theme>
    <name>Arc-Labwc</name>
    <cornerRadius>4</cornerRadius>
    <font place="ActiveWindow">
      <name>Cantarell</name>
      <size>10</size>
      <slant>Normal</slant>
      <weight>Bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>Cantarell</name>
      <size>10</size>
      <slant>Normal</slant>
      <weight>Normal</weight>
    </font>
  </theme>

  <desktops>
    <popupTime>500</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <keyboard>
    <default/>

    <!-- Applications
         Ctrl+Alt is used as the primary modifier — chosen to coexist with
         host DEs when this image is also run nested. Inside a VNC viewer,
         Super is often intercepted by the local DE before reaching the
         server, so Ctrl+Alt is the more reliable choice either way.
    -->
    <keybind key="C-A-Return">
      <action name="Execute"><command>foot</command></action>
    </keybind>
    <keybind key="C-A-space">
      <action name="Execute"><command>fuzzel</command></action>
    </keybind>
    <keybind key="C-A-v">
      <action name="Execute">
        <command>sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'</command>
      </action>
    </keybind>

    <!-- Window management -->
    <keybind key="C-A-q">
      <action name="Close"/>
    </keybind>
    <keybind key="C-A-f">
      <action name="ToggleMaximize"/>
    </keybind>
    <!-- Snapping: hjkl avoids Ctrl+Alt+arrows (KDE workspace switch on host) -->
    <keybind key="C-A-h">
      <action name="SnapToEdge"><direction>left</direction></action>
    </keybind>
    <keybind key="C-A-l">
      <action name="SnapToEdge"><direction>right</direction></action>
    </keybind>
    <keybind key="C-A-k">
      <action name="SnapToEdge"><direction>up</direction></action>
    </keybind>
    <keybind key="C-A-j">
      <action name="SnapToEdge"><direction>down</direction></action>
    </keybind>
    <keybind key="C-A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="C-A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>

    <!-- Workspaces -->
    <keybind key="C-A-1">
      <action name="GoToDesktop"><to>1</to></action>
    </keybind>
    <keybind key="C-A-2">
      <action name="GoToDesktop"><to>2</to></action>
    </keybind>
    <keybind key="C-A-3">
      <action name="GoToDesktop"><to>3</to></action>
    </keybind>
    <keybind key="C-A-4">
      <action name="GoToDesktop"><to>4</to></action>
    </keybind>
    <keybind key="C-A-S-1">
      <action name="SendToDesktop"><to>1</to><follow>yes</follow></action>
    </keybind>
    <keybind key="C-A-S-2">
      <action name="SendToDesktop"><to>2</to><follow>yes</follow></action>
    </keybind>
    <keybind key="C-A-S-3">
      <action name="SendToDesktop"><to>3</to><follow>yes</follow></action>
    </keybind>
    <keybind key="C-A-S-4">
      <action name="SendToDesktop"><to>4</to><follow>yes</follow></action>
    </keybind>

  </keyboard>

  <mouse>
    <default/>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </context>
  </mouse>

</labwc_config>
EOF

RUN cat > /etc/xdg/labwc/environment << 'EOF'
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24
GTK_THEME=Arc-Dark
QT_QPA_PLATFORM=wayland
LANG=C.UTF-8
LC_ALL=C.UTF-8
EOF

RUN cat > /etc/xdg/labwc/autostart << 'EOF'
xdg-user-dirs-update
swaybg -c '#383c4a' &
wl-paste --watch cliphist store &
mako &
sleep 0.5 && waybar &
EOF

# --- .desktop entries (system-wide overrides under /usr/local/share) ---
# Hide dependency entries that clutter the menu, and tidy up Thunar / btop.
# These must be in place BEFORE labwc-menu-generator runs below.

RUN mkdir -p /usr/local/share/applications && \
    for f in foot-server footclient thunar-bulk-rename thunar-settings xterm panel-preferences panel-desktop-handler; do \
        printf '[Desktop Entry]\nType=Application\nName=hidden\nNoDisplay=true\n' \
            > /usr/local/share/applications/${f}.desktop ; \
    done

RUN cat > /usr/local/share/applications/btop.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=btop++
Icon=btop
Exec=foot --window-size-chars=80x24 btop
Categories=System;Monitor;
EOF

RUN cat > /usr/local/share/applications/thunar.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Thunar File Manager
Icon=org.xfce.thunar
Exec=thunar
Categories=Utility;FileManager;
MimeType=inode/directory;
EOF

# Right-click menu generated at build time from installed .desktop files —
# the app set is fixed by the image, so there's no need to regenerate at
# session start. Users who install extra apps and want them in the menu
# can drop their own ~/.config/labwc/menu.xml.
RUN labwc-menu-generator > /etc/xdg/labwc/menu.xml

# --- App tool configs in /etc/xdg (XDG fallback path) ---
# Minimal waybar config — avoids modules that crash in a container environment
# (idle_inhibitor, battery, backlight, network, pulseaudio, wlr/taskbar all
# caused segfaults or runaway memory usage during testing).

RUN mkdir -p /etc/xdg/waybar && cat > /etc/xdg/waybar/config.jsonc << 'EOF'
{
    "modules-left": [],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory"],
    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "cpu {usage}%",
        "tooltip": false,
        "interval": 2
    },
    "memory": {
        "format": "mem {}%",
        "interval": 5
    }
}
EOF

RUN cat > /etc/xdg/waybar/style.css << 'EOF'
* {
    font-family: Cantarell, sans-serif;
    font-size: 13px;
}

window#waybar {
    background-color: #383c4a;
    color: #d3dae3;
    border-bottom: 2px solid #2b2e3b;
}

#clock {
    color: #d3dae3;
    padding: 0 12px;
}

#cpu,
#memory {
    color: #9da0a8;
    padding: 0 10px;
}

#cpu:hover,
#memory:hover {
    color: #d3dae3;
}

#cpu.warning,
#memory.warning {
    color: #e67e22;
}

#cpu.critical,
#memory.critical {
    color: #e74c3c;
}
EOF

