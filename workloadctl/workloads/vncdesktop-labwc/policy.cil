; Per-workload SELinux policy for the vncdesktop-labwc workload container.
; __WL_MODULE__ is substituted with the name-keyed block name at enable time.
;
; GTK4's glycin image loaders run inside a bwrap sandbox to decode SVGs and
; other image formats (icon themes, thumbnails). Without these rules, bwrap
; fails during namespace setup and every image load fails — apps appear to run
; but icons silently fail to render. This image is GTK3-only today, but the
; policy is shipped pre-emptively so adding a GTK4 app Just Works.
;
; The container runs non-systemd (--init), so all its processes are this one
; type — the device/bwrap rules below all apply to it directly.

(block __WL_MODULE__
    (blockinherit container)
    (blockinherit net_container)

    ; bwrap mounts a tmpfs for the sandbox's /tmp-home and /tmp-run.
    (allow process tmpfs_t (filesystem (mount remount)))
    ; bwrap mounts a fresh devpts inside the sandbox.
    (allow process devpts_t (filesystem (mount)))
    ; bwrap bind-mounts over existing sockets while composing the sandbox root.
    (allow process container_file_t (sock_file (mounton)))
    (allow process user_tmp_t (sock_file (mounton)))

    ; Wayland clients allocate their pixel buffers as shared memory and mmap
    ; them, which needs `map` on tmpfs_t. Without it every client that draws
    ; dies at startup -- foot fails in shm.c ("failed to mmap SHM backing memory
    ; file: Permission denied") and waybar exits right after parsing its config,
    ; so the session comes up with a background and no windows, and a terminal
    ; keybinding appears to do nothing because each launch dies immediately.
    ;
    ; The rest of this group is bwrap populating the sandbox root on the tmpfs
    ; above: create/mount its dirs, stage and exec the glycin loaders
    ; (execute+map => running code mmap'd from tmpfs), create its symlinks, and
    ; unmount the bind-mounted container_file_t mounts on teardown. All granted
    ; directly to container_init_t by container-selinux's base policy, but not
    ; inherited by a per-workload type, so they must be enumerated here.
    ; Mirrors vncdesktop-sway/-wayfire, where the missing `map` was diagnosed.
    (allow process tmpfs_t (dir (create mounton)))
    (allow process tmpfs_t (file (create open mounton execute map)))
    (allow process tmpfs_t (lnk_file (create)))
    (allow process container_file_t (filesystem (unmount)))
    ; ioctl on a /proc file.
    (allow process proc_t (file (ioctl)))

    ; NVIDIA device nodes (/dev/nvidia*, nvidiactl, nvidia-uvm*, nvidia-caps/*)
    ; on a GPU host — xserver_misc_device_t. Stated here rather than inherited:
    ; the NVIDIA images set container_use_xserver_devices, but that boolean is
    ; written against container_t, not the container_domain attribute this type
    ; belongs to. DRI (dri_device_t) needs nothing — the base policy grants it
    ; to container_domain unconditionally.
    (allow process xserver_misc_device_t
        (chr_file (append getattr ioctl lock map open read setattr write))))
