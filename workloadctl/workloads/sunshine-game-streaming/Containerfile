# --- labwc systemd service ---

RUN cat > /usr/lib/systemd/system/labwc.service <<'UNIT'
[Unit]
Description=Labwc Wayland Compositor (headless)
After=container-bootstrap.service polkit-stub.service seatd.service
Requires=seatd.service

[Service]
Type=simple
TasksMax=infinity
Restart=on-failure
RestartSec=3
PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER DESKTOP_RESOLUTION

Environment=GDK_BACKEND=wayland
Environment=LIBSEAT_BACKEND=seatd
Environment=MOZ_ENABLE_WAYLAND=1
Environment=QT_QPA_PLATFORM=wayland
Environment=WLR_BACKENDS=headless,libinput
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=XCURSOR_SIZE=24
Environment=XCURSOR_THEME=Adwaita
Environment=XDG_CURRENT_DESKTOP=wlroots
Environment=XDG_SESSION_TYPE=wayland
EnvironmentFile=-/run/wlr-renderer.env

ExecStartPre=/bin/sh -c 'ls /dev/dri/renderD* 2>/dev/null | grep -q . || echo LIBGL_ALWAYS_SOFTWARE=1 > /run/wlr-renderer.env'
ExecStartPre=/bin/sh -c 'mkdir -p /run/user/${CONTAINER_UID} && chown ${CONTAINER_UID}:${CONTAINER_GID} /run/user/${CONTAINER_UID} && chmod 0700 /run/user/${CONTAINER_UID}'
ExecStartPre=/bin/sh -c 'while [ ! -S /run/seatd.sock ]; do sleep 0.1; done'
ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /bin/sh -c 'export HOME=/home/${CONTAINER_USER} XDG_RUNTIME_DIR=/run/user/${CONTAINER_UID} && cd && exec /usr/bin/dbus-run-session /usr/bin/labwc'

[Install]
WantedBy=multi-user.target
UNIT

# --- Wayland ready gate ---
# Oneshot that blocks until labwc's Wayland socket exists. Services that
# need the display (sunshine, wayvnc) depend on this instead
# of each polling independently.

RUN cat > /usr/local/bin/wait-for-wayland <<'SCRIPT'
#!/bin/sh
RUNTIME_DIR="/run/user/${CONTAINER_UID}"
ENV_FILE="/run/wayland-display.env"

while true; do
    for sock in "$RUNTIME_DIR"/wayland-*; do
        case "$sock" in *.lock) continue ;; esac
        if [ -S "$sock" ]; then
            DISPLAY_NAME="${sock##*/}"
            echo "WAYLAND_DISPLAY=${DISPLAY_NAME}" > "$ENV_FILE"
            exit 0
        fi
    done
    sleep 0.5
done
SCRIPT

RUN chmod +x /usr/local/bin/wait-for-wayland

RUN cat > /usr/lib/systemd/system/labwc-wayland-ready.service <<'UNIT'
[Unit]
Description=Wait for labwc Wayland socket
After=labwc.service
Requires=labwc.service

[Service]
Type=oneshot
RemainAfterExit=yes
PassEnvironment=CONTAINER_UID
ExecStart=/usr/local/bin/wait-for-wayland

[Install]
WantedBy=multi-user.target
UNIT

# --- Sunshine systemd service ---
# Runs as the container user after labwc has created the Wayland socket.
# Restart=on-failure ensures it recovers from network drops and crashes.

# --- Sunshine prestart ---
# Runs as ExecStartPre in sunshine.service. Three jobs, all run on every start
# because the inputs (visible GPU, host IPs) can change between restarts:
#   1. Pick adapter_name + encoder from the visible render node's PCI vendor.
#      With gpu = "nvidia:<UUID>" / "amd" in the workload TOML, only one
#      /dev/dri/renderD* is mounted, so the loop selects exactly that GPU.
#   2. Refresh csrf_allowed_origins so Sunshine's web UI accepts the host's
#      current IPs (network is up by this point so `hostname -I` returns them).
RUN cat > /usr/local/bin/sunshine-prestart <<'SCRIPT'
#!/bin/bash
set -e
CONF="$HOME/.config/sunshine/sunshine.conf"
mkdir -p "$(dirname "$CONF")"

# Base port — every Sunshine port derives from it. Overridable per workload via
# the SUNSHINE_PORT env so this desktop can coexist with another Sunshine host on
# the same machine (host networking shares the port space). Default 47989 is
# Sunshine's standard base; the web UI is base + 1. In Moonlight, add this host
# manually as <ip>:<SUNSHINE_PORT> when it isn't on the default base.
SUNSHINE_PORT="${SUNSHINE_PORT:-47989}"
WEB_PORT=$((SUNSHINE_PORT + 1))

# Wipe the lines we're about to rewrite.
sed -i '/^port=/d;/^adapter_name=/d;/^encoder=/d;/^csrf_allowed_origins=/d' "$CONF" 2>/dev/null || true

echo "port=${SUNSHINE_PORT}" >> "$CONF"

# Detect adapter + encoder from PCI vendor of the visible render node.
# 0x10de = NVIDIA → nvenc; 0x1002 = AMD, 0x8086 = Intel → vaapi (mesa).
for _drm in /dev/dri/renderD*; do
    [ -c "$_drm" ] || continue
    _node=${_drm##*/}
    _vendor=$(cat "/sys/class/drm/$_node/device/vendor" 2>/dev/null || echo "")
    case "$_vendor" in
        0x10de)        _encoder=nvenc ;;
        0x1002|0x8086) _encoder=vaapi ;;
        *)             continue ;;
    esac
    echo "adapter_name=${_drm}" >> "$CONF"
    echo "encoder=${_encoder}"  >> "$CONF"
    break
done
unset _drm _node _vendor _encoder

ORIGINS=""
for ip in $(hostname -I 2>/dev/null); do
    [ -n "$ORIGINS" ] && ORIGINS="${ORIGINS},"
    ORIGINS="${ORIGINS}https://${ip}:${WEB_PORT}"
done
ORIGINS="${ORIGINS},https://localhost:${WEB_PORT},https://$(hostname):${WEB_PORT}"
echo "csrf_allowed_origins=${ORIGINS}" >> "$CONF"

# Serve a Homelab-CA-signed cert when the host minted one (setup.sh mounts it
# read-only at /etc/sunshine/tls), so the web UI is browser-trusted with no
# warning. Absent → Sunshine generates its own self-signed cert as before.
sed -i '/^cert=/d;/^pkey=/d' "$CONF" 2>/dev/null || true
if [ -f /etc/sunshine/tls/cert.pem ] && [ -f /etc/sunshine/tls/pkey.pem ]; then
    echo "cert=/etc/sunshine/tls/cert.pem" >> "$CONF"
    echo "pkey=/etc/sunshine/tls/pkey.pem" >> "$CONF"
fi
SCRIPT

RUN cat > /usr/lib/systemd/system/sunshine.service <<'UNIT'
[Unit]
Description=Sunshine GameStream host
After=labwc-wayland-ready.service
Requires=labwc-wayland-ready.service

[Service]
Type=simple
Restart=on-failure
RestartSec=3
PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER SUNSHINE_PORT

# CUDA opens hundreds of FDs per context (one per /sys/bus/pci/.../drm entry,
# plus libcuda's own pool). The default 1024 trips an EMFILE during the sysfs
# scan that maps the CUDA device to its DRM render node, which surfaces as
# "Couldn't open DRM FD for CUDA device" → "OpenEncodeSessionEx: unsupported
# device" and Sunshine never opens an encoder session.
LimitNOFILE=524288

ExecStartPre=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /bin/sh -c 'export HOME=/home/${CONTAINER_USER} && exec /usr/local/bin/sunshine-prestart'
ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /bin/sh -c '. /run/wayland-display.env && export HOME=/home/${CONTAINER_USER} XDG_RUNTIME_DIR=/run/user/${CONTAINER_UID} WAYLAND_DISPLAY && cd && exec /usr/bin/sunshine'

[Install]
WantedBy=multi-user.target
UNIT

# --- wayvnc systemd service ---
# Disabled by default (no auth, binds all interfaces). Start manually for debugging:
#   systemctl start wayvnc

RUN cat > /usr/lib/systemd/system/wayvnc.service <<'UNIT'
[Unit]
Description=wayvnc VNC server
After=labwc-wayland-ready.service
Requires=labwc-wayland-ready.service

[Service]
Type=simple
Restart=on-failure
RestartSec=3
PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER

ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /bin/sh -c '. /run/wayland-display.env && export HOME=/home/${CONTAINER_USER} XDG_RUNTIME_DIR=/run/user/${CONTAINER_UID} WAYLAND_DISPLAY && cd && exec /usr/bin/wayvnc 0.0.0.0 5900'

[Install]
WantedBy=multi-user.target
UNIT

# --- seatd ---
# labwc's libinput backend needs a libseat session to open input devices.
# A container has no logind seat, so we run seatd. SEATD_VTBOUND=0 gives a
# VT-less seat (the default VT-bound seat fails — no tty0 in a container).
# seatd runs as root (no User=) so it can create /run/seatd.sock and inherits
# PID 1's keep-groups, including `input`, to open /dev/input/event* devices.
# -g input makes the socket reachable by labwc running as the container user.

RUN cat > /usr/lib/systemd/system/seatd.service <<'UNIT'
[Unit]
Description=seatd seat management daemon (VT-less)
After=container-bootstrap.service
Before=labwc.service

[Service]
Type=simple
Restart=on-failure
RestartSec=3
Environment=SEATD_VTBOUND=0
ExecStart=/usr/bin/seatd -g input

[Install]
WantedBy=multi-user.target
UNIT

# --- Bootstrap ---

RUN cat > /usr/local/bin/container-bootstrap <<'SCRIPT'
#!/bin/bash
set -e
: "${CONTAINER_USER:?must be set}"
: "${CONTAINER_UID:?must be set}"
: "${CONTAINER_GID:?must be set}"

HOME_DIR="/home/$CONTAINER_USER"

groupadd -g "$CONTAINER_GID" "$CONTAINER_USER" 2>/dev/null || true
useradd -u "$CONTAINER_UID" -g "$CONTAINER_GID" -d "$HOME_DIR" -s /bin/bash -M "$CONTAINER_USER" 2>/dev/null || true
mkdir -p "$HOME_DIR/.local/state"
chown "$CONTAINER_UID:$CONTAINER_GID" "$HOME_DIR" "$HOME_DIR/.local" "$HOME_DIR/.local/state"

# Add the desktop user to render/input/video groups inside the container.
# These groups already exist in the Fedora base image. The hypervisor's
# --gidmap entries bring the host GIDs into the user namespace, and
# --group-add passes them to the container process. We just need the
# user to be a member so id(1) and file permission checks work.
for grp in render input video audio; do
    if getent group "$grp" >/dev/null 2>&1; then
        usermod -aG "$grp" "$CONTAINER_USER" 2>/dev/null || true
    fi
done

# Ensure Sunshine user config directory exists with correct ownership.
# chown .config itself, not just .config/sunshine -- mkdir -p creates the
# .config parent as root, leaving the desktop user unable to write its own
# config (labwc, gtk, Steam, ...) there.
mkdir -p "$HOME_DIR/.config/sunshine"
chown -R "$CONTAINER_UID:$CONTAINER_GID" "$HOME_DIR/.config"

mkdir -p /etc/sudoers.d
echo "$CONTAINER_USER ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/container-user
chown 0:0 /etc/sudoers.d/container-user
chmod 0440 /etc/sudoers.d/container-user

if ! grep -q 'PS1=' "$HOME_DIR/.bashrc" 2>/dev/null; then
    cat >> "$HOME_DIR/.bashrc" <<'PROMPT'
if [ "$PS1" ]; then
    PS1='\[\033[01;35m\][sunshine]\[\033[01;32m\] \u:\w\$\[\033[0m\] '
fi
PROMPT
    chown "$CONTAINER_UID:$CONTAINER_GID" "$HOME_DIR/.bashrc"
fi

echo "Bootstrap complete."
SCRIPT

RUN cat > /usr/lib/systemd/system/container-bootstrap.service <<'UNIT'
[Unit]
Description=First-boot container bootstrap
ConditionPathExists=!/etc/container-bootstrapped
DefaultDependencies=no
After=sysinit.target
Before=labwc.service

[Service]
Type=oneshot
PassEnvironment=CONTAINER_USER CONTAINER_UID CONTAINER_GID
ExecStart=/usr/local/bin/container-bootstrap
ExecStartPost=/bin/touch /etc/container-bootstrapped

[Install]
WantedBy=multi-user.target
UNIT

RUN mkdir -p /etc/systemd/journald.conf.d && \
    cat > /etc/systemd/journald.conf.d/10-container.conf <<'CONF'
[Journal]
Storage=volatile
ForwardToSocket=/run/host-systemd/journal/socket
CONF

RUN mkdir -p /etc/systemd/system/systemd-journald.service.d && \
    cat > /etc/systemd/system/systemd-journald.service.d/10-container.conf <<'DROPIN'
[Service]
CapabilityBoundingSet=
IPAddressDeny=
LockPersonality=no
MemoryDenyWriteExecute=no
NoNewPrivileges=no
ProtectClock=no
RestrictAddressFamilies=
RestrictNamespaces=no
RestrictRealtime=no
RestrictSUIDSGID=no
SystemCallArchitectures=
SystemCallFilter=
DROPIN

RUN mkdir -p /etc/systemd/system && \
    ln -sf /dev/null /etc/systemd/system/polkit.service && \
    ln -sf /dev/null /etc/systemd/system/rtkit-daemon.service && \
    ln -sf /dev/null /etc/systemd/system/systemd-oomd.service && \
    ln -sf /dev/null /etc/systemd/system/systemd-oomd.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd-control.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd-kernel.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd.service && \
    systemctl enable labwc labwc-wayland-ready sunshine seatd container-bootstrap systemd-logind polkit-stub && \
    chmod +x /etc/xdg/labwc/autostart /usr/local/bin/container-bootstrap \
             /usr/local/bin/polkit-stub /usr/local/bin/sunshine-prestart

# Fedora 44 dropped the consolidated CA bundle files in favour of the directory-
# hash format — https://fedoraproject.org/wiki/Changes/droppingOfCertPemFile —
# which breaks apps with a bundled TLS stack that read the bundle *file* (e.g.
# Sunshine/Steam: "unable to load trusted SSL root certificates", "http error 0").
# Restore the legacy names as symlinks to the stable extracted bundle (Fedora's
# documented permanent fix; the --rhbz2387674 temp flag is intentionally avoided).
RUN B=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem && \
    ln -sf "$B" /etc/pki/tls/certs/ca-bundle.crt && \
    ln -sf "$B" /etc/pki/tls/certs/ca-certificates.crt && \
    ln -sf "$B" /etc/pki/tls/cert.pem && \
    ln -sf "$B" /etc/ssl/cert.pem

STOPSIGNAL SIGRTMIN+3
CMD ["/usr/sbin/init"]
