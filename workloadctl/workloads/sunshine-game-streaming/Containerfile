# Headless Desktop + Sunshine Streaming
#
# labwc runs headlessly (WLR_BACKENDS=headless,libinput; no KMS).
# Input from Moonlight clients arrives as Sunshine uinput devices. labwc's
# libinput backend picks them up natively via the host udev database (mounted
# read-only at /run/udev by the workload); seatd provides the libseat session.
# Host udev hotplug events don't reach the container's libudev (it drops them --
# the host udevd's sender UID maps to "nobody" in the container's user
# namespace), so a host-side relay installed by setup.sh re-broadcasts them with
# a corrected UID for the devices Sunshine creates at runtime.
# Sunshine captures the virtual display via wlr-screencopy, encodes with VAAPI
# on the AMD render node, and streams to Moonlight clients.
# Steam Big Picture is the default session; the full labwc desktop is always
# accessible by minimising/exiting Steam.
#
# Build:
#   sudo workloadctl build sunshine-game-streaming
#
# Run:
#   workload-ctl enable sunshine-game-streaming

FROM registry.fedoraproject.org/fedora:44

RUN dnf install --setopt=install_weak_deps=False --nodocs -y \
    adwaita-cursor-theme \
    alsa-utils \
    arc-theme \
    bash-completion \
    btop \
    dbus-daemon \
    diffutils \
    egl-utils \
    firefox \
    foot \
    fuzzel \
    geany \
    git-core \
    glibc-langpack-en \
    glx-utils \
    google-noto-sans-fonts \
    grim \
    hostname \
    imv \
    jetbrains-mono-fonts \
    labwc \
    labwc-menu-generator \
    less \
    libevdev \
    libinput \
    lsb_release \
    mako \
    mesa-dri-drivers \
    mesa-libEGL \
    mesa-libGL \
    mesa-libgbm \
    mesa-va-drivers \
    mesa-vulkan-drivers \
    nano \
    neovim \
    papirus-icon-theme \
    pciutils \
    pipewire \
    pipewire-alsa \
    pipewire-jack-audio-connection-kit \
    pipewire-pulseaudio \
    procps-ng \
    psmisc \
    python3-gobject \
    seatd \
    slurp \
    sudo \
    swappy \
    swaybg \
    systemd \
    systemd-udev \
    thunar \
    tmux \
    util-linux \
    vulkan-loader \
    vulkan-tools \
