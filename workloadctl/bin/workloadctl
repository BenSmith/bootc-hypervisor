#!/usr/bin/env python3
"""
workloadctl - Manage rootless system workloads

Provides Docker/kubectl-like CLI for managing containerized workloads
running as system services with rootless podman.

The program is lib/cli_main.py over lib/cli_parser.py. This file is main().
"""
import sys

from cli_main import run


def main(argv):
    return run(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
