#!/usr/bin/env python3
"""
workloadctl - Manage rootless system workloads

Provides Docker/kubectl-like CLI for managing containerized workloads
running as system services with rootless podman.
"""

import argparse
import sys
import traceback

# Build identity, with the source-checkout fallback. Sourced from workload_lib so
# `--version` and the version stamped into generated units are the same string.
from workload_lib import WORKLOADCTL_VERSION as __version__

import cli_log
from cmd_create import cmd_create
from cmd_diagnose import cmd_diagnose
from cmd_edit import cmd_edit
from cmd_validate import cmd_validate
from cmd_catalog import cmd_catalog, cmd_duplicate, cmd_init, cmd_install
from cmd_backup import cmd_backup, cmd_restore
from cmd_doctor import cmd_doctor
from cmd_drift import cmd_drift
from cmd_health import cmd_health
from cmd_images import cmd_images
from cmd_info import cmd_info
from cmd_inspect import cmd_list, cmd_status
from cmd_stats import cmd_stats
from cmd_cleanup import cmd_cleanup
from cmd_disable import cmd_disable
from cmd_enable import cmd_enable
from cmd_interact import cmd_cp, cmd_exec, cmd_incant, cmd_logs, cmd_shell
from cmd_pcap import cmd_pcap
from cmd_lifecycle import (
    cmd_build, cmd_reboot, cmd_recreate, cmd_restart, cmd_start, cmd_stop,
)
from cmd_secret import cmd_secret
from cmd_update import cmd_rollback, cmd_update
from provisioning import ImageTransferError
from substrate import LifecycleError, ProvisionFailed
from workloadctl_core import (
    NotRoot,
    UsageError,
    WorkloadManager,
    WorkloadMasked,
    WorkloadUserNotFound,
)


def main():
    parser = argparse.ArgumentParser(
        prog="workloadctl",
        description="Manage rootless system workloads",
        epilog="For more information, see /usr/share/doc/workloadctl/"
    )

    parser.add_argument(
        "--version", action="version", version=f"%(prog)s {__version__}"
    )

    subparsers = parser.add_subparsers(dest="command", required=True, help="Command to run")

    # Options shared by the verbs that mutate a workload. They are the verbs
    # whose narration goes through cli_log, which is what makes --quiet real:
    # a flag is only offered where it is actually honored (--quiet on a verb
    # that printed anyway would be a lie), so the read/report verbs — which
    # emit output, not prose — don't take it.
    mutating = argparse.ArgumentParser(add_help=False)
    # Marks these verbs as the ones whose result object cli_log writes. The read
    # verbs carry a --json of their own that means something different (see
    # configure() below), and this is what tells the two apart.
    mutating.set_defaults(emits_result=True)
    mutating.add_argument("-q", "--quiet", action="store_true",
                          help="Suppress progress output; warnings and errors still print")
    mutating.add_argument("--json", action="store_true",
                          help="Print a JSON result object instead of progress output")

    cp_parser = subparsers.add_parser("cp", help="Copy files to/from container")
    cp_parser.set_defaults(func=cmd_cp)
    cp_parser.add_argument("source", help="Source (workload:path or path)")
    cp_parser.add_argument("destination", help="Destination (workload:path or path)")

    create_parser = subparsers.add_parser("create", help="Create a new workload configuration")
    create_parser.set_defaults(func=cmd_create)
    create_parser.add_argument("--audio", action="store_true", help="Enable audio (/dev/snd + auto-mount PulseAudio/PipeWire) - convenience flag")
    create_parser.add_argument("--device", metavar="DEVICE", action="append", help="Generic device passthrough; repeat per device (e.g., --device /dev/ttyUSB0 --device /dev/video0)")
    create_parser.add_argument("--enable", action="store_true", help="Enable and start the workload immediately")
    create_parser.add_argument("--gpu", metavar="SPEC", help="GPU access (convenience flag): 'amd', 'nvidia', 'intel', 'none', 'auto', or 'nvidia:<index|UUID>' to pin one GPU (see `nvidia-ctk cdi list`)")
    create_parser.add_argument("--groups", metavar="GROUP", action="append", help="Additional system group; repeat per group (e.g., --groups video --groups render)")
    create_parser.add_argument("--image", required=True, help="Container image (e.g., docker.io/library/nginx:alpine)")
    create_parser.add_argument("--input", action="store_true", help="Enable input devices (/dev/input + /dev/uinput) - convenience flag")
    create_parser.add_argument("--network", metavar="MODE", help="Network mode: 'host', 'pasta', 'none', or custom network name (default: pasta)")
    create_parser.add_argument("--ports", metavar="PORT", action="append", help="Port mapping; repeat per port (e.g., --ports 8080:80 --ports 8443:443)")
    create_parser.add_argument("--shm-size", metavar="SIZE", help="Shared memory size (e.g., 256m, 2g; default: 64m)")
    create_parser.add_argument("--systemd", metavar="MODE", choices=["always", "true", "false"],
                               help="Systemd container mode: 'always', 'true', or 'false' (skips --init, adds KillSignal)")
    create_parser.add_argument("--virtualization", action="store_true", help="Enable KVM (/dev/kvm + vhost devices) - convenience flag")
    create_parser.add_argument("--volumes", metavar="VOL", action="append", help="Volume mount; repeat per volume (e.g., --volumes /host/path:/container/path:ro)")
    create_parser.add_argument("name", help="Workload name (lowercase letters, numbers, hyphens, max 27 chars)")

    # Resource limit flags
    create_parser.add_argument("--cpu-quota", metavar="PERCENT", help="CPU quota (e.g., 50%%, 100%%, 200%%)")
    create_parser.add_argument("--cpu-weight", type=int, metavar="WEIGHT", help="CPU scheduling weight (1-10000, default 100)")
    create_parser.add_argument("--io-weight", type=int, metavar="WEIGHT", help="I/O scheduling weight (1-10000, default 100)")
    create_parser.add_argument("--memory-high", metavar="SIZE", help="Memory soft limit for throttling (e.g., 384M, 1.5G)")
    create_parser.add_argument("--memory-max", metavar="SIZE", help="Maximum memory (e.g., 512M, 2G, 4G)")
    create_parser.add_argument("--memory-swap-max", metavar="SIZE", help="Maximum swap usage (0 to disable, or size like 512M)")
    create_parser.add_argument("--tasks-max", type=int, metavar="NUM", help="Maximum number of tasks/threads")

    catalog_parser = subparsers.add_parser("catalog", help="List shippable workload bundles")
    catalog_parser.set_defaults(func=cmd_catalog)
    catalog_parser.add_argument("--json", action="store_true", help="Output in JSON format")

    init_parser = subparsers.add_parser(
        "init", help="Instantiate a catalog bundle into /etc/workloads.d/")
    init_parser.set_defaults(func=cmd_init)
    init_parser.add_argument("bundle", nargs="?", help="Bundle name (see 'workloadctl catalog')")
    init_parser.add_argument("--as", dest="as_name", metavar="NAME",
                             help="Instance name (default: the bundle name)")
    init_parser.add_argument("--scratch", metavar="NAME",
                             help="Create a self-contained stub workload with no bundle backing")
    init_parser.add_argument("--scratch-vm", dest="scratch_vm", metavar="NAME",
                             help="Create a self-contained VM stub workload (Fedora 44 Cloud-Base default)")

    duplicate_parser = subparsers.add_parser(
        "duplicate", aliases=["clone"], help="Copy a live workload under a new name")
    duplicate_parser.set_defaults(func=cmd_duplicate)
    duplicate_parser.add_argument("source", help="Existing workload to copy")
    duplicate_parser.add_argument("new", help="Name for the copy")

    install_parser = subparsers.add_parser(
        "install", help="Promote a local workload directory into /etc/workloads.d/")
    install_parser.set_defaults(func=cmd_install)
    install_parser.add_argument("src", help="Source directory containing workload.toml")

    build_parser = subparsers.add_parser(
        "build", help="Build a workload's container image from its bundle build context",
        parents=[mutating])
    build_parser.set_defaults(func=cmd_build)
    build_parser.add_argument("workload", help="Workload name")

    backup_parser = subparsers.add_parser("backup", help="Backup workload data and config")
    backup_parser.set_defaults(func=cmd_backup)
    backup_parser.add_argument("--all", action="store_true", help="Backup all workloads")
    backup_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    # 'app' is the deferred ideas.md slot (guest fsfreeze / guest-agent channel);
    # do NOT add it to choices until the vm-bootc-guest gate lands.
    backup_parser.add_argument("--consistency", choices=["cold", "crash"], default="cold",
                               help="Backup consistency level: cold (stop/backup/restart, default) "
                                    "or crash (QMP-paused live copy for VMs; live for containers)")
    backup_parser.add_argument("--output", "-o", metavar="PATH",
                               help="Output path (file or directory)")
    backup_parser.add_argument("workload", nargs="?", help="Workload name")

    cleanup_parser = subparsers.add_parser("cleanup", help="Remove orphaned workload users, directories, and SELinux modules")
    cleanup_parser.set_defaults(func=cmd_cleanup)
    cleanup_parser.add_argument("--apply", action="store_true",
                                help="Actually remove orphaned users/dirs (default is dry run)")
    cleanup_parser.add_argument("--json", action="store_true", help="Output in JSON format")

    drift_parser = subparsers.add_parser(
        "drift",
        help="Show diff between running units and what would be generated from current TOMLs",
    )
    drift_parser.set_defaults(func=cmd_drift)
    drift_parser.add_argument(
        "workload", nargs="?", metavar="WORKLOAD",
        help="Filter to units belonging to a specific workload (default: all workloads)",
    )
    drift_parser.add_argument(
        "--json", action="store_true",
        help="Output diff as JSON",
    )

    disable_parser = subparsers.add_parser("disable", help="Stop and disable a workload (use --purge to also remove user and data)",
                                           parents=[mutating])
    disable_parser.set_defaults(func=cmd_disable)
    disable_parser.add_argument("--purge", action="store_true",
                               help="Also remove user, home, and subuid/subgid")
    disable_parser.add_argument("--dry-run", action="store_true",
                               help="Print the teardown plan without changing anything")
    disable_parser.add_argument("workload", help="Workload name")

    edit_parser = subparsers.add_parser("edit", help="Edit config, or a named control file (copy-on-write override)")
    edit_parser.set_defaults(func=cmd_edit)
    edit_parser.add_argument("workload", help="Workload name")
    edit_parser.add_argument(
        "file", nargs="?",
        help="Control file to edit (Containerfile, setup.sh, policy.cil, …). "
             "Seeds an /etc/workloads.d/<name>/ override copy-on-write from the "
             "shipped default. Omit to edit the workload TOML.",
    )
    edit_parser.add_argument(
        "-y", "--yes", action="store_true",
        help="Apply changes without the interactive confirmation prompt",
    )

    enable_parser = subparsers.add_parser("enable", help="Enable and start a workload",
                                          parents=[mutating])
    enable_parser.set_defaults(func=cmd_enable)
    enable_parser.add_argument("workload", help="Workload name")

    exec_parser = subparsers.add_parser("exec", help="Execute command in workload container or VM (via SSH)")
    exec_parser.set_defaults(func=cmd_exec)
    # Order matters and is NOT alphabetizable: WORKLOAD must come before the
    # COMMAND positional. argparse.REMAINDER is greedy, so it has to be the LAST
    # positional — first token binds to WORKLOAD, the rest are the command
    # (e.g. `workloadctl exec web wget -qO- ...`). Putting COMMAND first makes
    # the workload bind to the trailing token instead. Matches docker/podman.
    exec_parser.add_argument("workload", metavar="WORKLOAD[/CONTAINER]",
                             help="Workload, or workload/container for multi-container workloads")
    exec_parser.add_argument("exec_args", metavar="COMMAND", nargs=argparse.REMAINDER,
                             help="Command to execute (a leading -- is optional)")

    health_parser = subparsers.add_parser("health", help="Check workload health")
    health_parser.set_defaults(func=cmd_health)
    health_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    health_parser.add_argument("workload", metavar="WORKLOAD[/CONTAINER]",
                               help="Workload, or workload/container for multi-container workloads")

    incant_parser = subparsers.add_parser(
        "incant",
        help="Raw control-plane passthrough (escape hatch — bypasses the declarative model)",
        description=(
            "Send a raw command to the workload's runtime control plane as the owning identity, "
            "with the fiddly invocation (sudo env, QMP framing) supplied automatically.\n\n"
            "For containers: runs `podman <argv>` as `_wl-<name>` via the rootless wrapper.\n"
            "For VMs: sends a QMP command to the QEMU monitor (first token = command name, "
            "remaining `key=value` tokens = arguments).\n\n"
            "This bypasses the declarative TOML → units model. Prefer the purpose-built verbs "
            "when they cover your use case."
        ),
    )
    incant_parser.set_defaults(func=cmd_incant)
    incant_parser.add_argument(
        "workload", metavar="WORKLOAD[/CONTAINER]",
        help="Workload, or workload/container for multi-container workloads",
    )
    incant_parser.add_argument(
        "argv", metavar="CMD", nargs=argparse.REMAINDER,
        help="Command to pass to the control plane (a leading -- is optional)",
    )

    info_parser = subparsers.add_parser("info", help="Show detailed workload information")
    info_parser.set_defaults(func=cmd_info)
    info_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    info_parser.add_argument(
        "--files", action="store_true",
        help="Show the merged view of bundle control files: each resolved file "
             "and whether it wins from /etc (override) or /usr (shipped default)",
    )
    info_parser.add_argument("workload", help="Workload name")

    images_parser = subparsers.add_parser("images", help="Show images or prune unused")
    images_parser.set_defaults(func=cmd_images)
    images_parser.add_argument("--json", action="store_true", help="Output in JSON format (for list)")
    images_parser.add_argument("subcommand", nargs="?", default="list",
                               choices=["list", "prune"], help="Subcommand (list or prune)")
    list_parser = subparsers.add_parser("list", help="List all available workloads")
    list_parser.set_defaults(func=cmd_list)
    list_parser.add_argument("--json", action="store_true", help="Output in JSON format")

    logs_parser = subparsers.add_parser("logs", help="View workload logs (journalctl wrapper)")
    logs_parser.set_defaults(func=cmd_logs)
    logs_parser.add_argument("-f", "--follow", action="store_true", help="Follow log output")
    logs_parser.add_argument("-n", "--lines", type=int, metavar="N", help="Show last N lines (default: 50)")
    logs_parser.add_argument("--since", metavar="TIME", help="Show logs since TIME")
    logs_parser.add_argument("workload", metavar="WORKLOAD[/CONTAINER]",
                             help="Workload, or workload/container for multi-container workloads")
    # REMAINDER captures everything after WORKLOAD verbatim and passes it to
    # journalctl, so any journalctl flag works (-b, -p, -g, -o, -k, -r, ...).
    # The convenience flags above (-f/-n/--since) stay parsed when placed
    # *before* WORKLOAD; after it they ride through REMAINDER, which journalctl
    # handles identically. Must be declared after WORKLOAD so the workload token
    # isn't swallowed into the passthrough.
    logs_parser.add_argument("extra_args", nargs=argparse.REMAINDER,
                             metavar="[-- JOURNALCTL_ARGS]",
                             help="Additional journalctl arguments (after WORKLOAD)")

    # pcap — tcpdump's surface, because the people who reach for this already
    # know tcpdump. A vantage is an interface, which needs no new concept.
    pcap_parser = subparsers.add_parser(
        "pcap", help="Capture a workload's traffic (host and/or guest vantage)")
    pcap_parser.set_defaults(func=cmd_pcap)
    pcap_parser.add_argument("-i", "--interface", metavar="VANTAGE",
                             action="append",
                             help="host | guest. Repeatable. Default: host")
    pcap_parser.add_argument("-D", "--list-interfaces", action="store_true",
                             help="List this workload's vantages and exit")
    pcap_parser.add_argument("-Q", "--direction", choices=["in", "out", "inout"],
                             help="Direction to capture (default: inout)")
    pcap_parser.add_argument("-s", "--snapshot-length", metavar="SPEC",
                             help="Bytes kept per packet: 128, or "
                                  "guest:1500,host:0. 0 means no truncation "
                                  "(default: 1500)")
    pcap_parser.add_argument("-w", "--write", metavar="PATH",
                             help="Write pcapng instead of decoding. '-' is "
                                  "stdout; a directory with >1 vantage")
    pcap_parser.add_argument("--detach", action="store_true",
                             help="Start the capture and return (requires -w)")
    pcap_parser.add_argument("-c", "--packet-count", type=int, metavar="N",
                             help="Stop after N packets")
    pcap_parser.add_argument("-C", "--rotate-size", type=int, metavar="N",
                             help="Rotate at N million bytes (tcpdump's unit)")
    pcap_parser.add_argument("-W", "--file-count", type=int, metavar="N",
                             help="Cap rotation at N files, reused as a ring")
    pcap_parser.add_argument("-G", "--rotate-seconds", type=int, metavar="N",
                             help="Rotate every N seconds")
    pcap_parser.add_argument("--duration", metavar="D",
                             help="Stop after D (30s, 5m, 1h). 0 disables "
                                  "(default: 5m)")
    pcap_parser.add_argument("--max-size", metavar="S",
                             help="Stop at S (100M, 2G) (default: 100M)")
    pcap_parser.add_argument("-n", dest="numeric", action="store_true",
                             help="Do not resolve addresses to names")
    pcap_parser.add_argument("-q", "--quiet", action="store_true",
                             help="Suppress prose; warnings and errors still print")
    pcap_parser.add_argument("--json", action="store_true",
                             help="Machine-readable result object (requires -w)")
    pcap_parser.add_argument("--dry-run", action="store_true",
                             help="Print the plan and exit, changing nothing")
    pcap_parser.add_argument("--list", action="store_true",
                             help="List running captures and exit")
    pcap_parser.add_argument("--stop", action="store_true",
                             help="Stop the capture on WORKLOAD")
    pcap_parser.add_argument("workload", nargs="?",
                             metavar="WORKLOAD[/CONTAINER]",
                             help="Workload. Required except with --list")
    # Everything after WORKLOAD is a BPF filter, taken verbatim — the same
    # passthrough shape `logs` uses for journalctl arguments.
    pcap_parser.add_argument("filter", nargs=argparse.REMAINDER,
                             metavar="[FILTER ...]",
                             help="BPF filter, tcpdump syntax")

    reboot_parser = subparsers.add_parser("reboot", help="Soft-reboot a systemd container (keeps overlay)",
                                          parents=[mutating])
    reboot_parser.set_defaults(func=cmd_reboot)
    reboot_parser.add_argument("workload", help="Workload name")

    recreate_parser = subparsers.add_parser("recreate", help="Recreate container from image (destroys overlay)",
                                            parents=[mutating])
    recreate_parser.set_defaults(func=cmd_recreate)
    recreate_parser.add_argument("workload", help="Workload name")

    restart_parser = subparsers.add_parser("restart", help="Restart a workload service (keeps overlay/disk; does not apply TOML edits)",
                                           parents=[mutating])
    restart_parser.set_defaults(func=cmd_restart)
    restart_parser.add_argument("workload", help="Workload name")

    restore_parser = subparsers.add_parser("restore", help="Restore a workload from backup")
    restore_parser.set_defaults(func=cmd_restore)
    restore_parser.add_argument("--enable", action="store_true",
                                help="Enable the workload after restore")
    restore_parser.add_argument("--force", action="store_true",
                                help="Overwrite existing config, credentials, and home dir")
    restore_parser.add_argument("archive", help="Path to backup archive (.tar.zst)")

    rollback_parser = subparsers.add_parser("rollback", help="Roll back to previous image (VM workloads: restore previous disk generation)",
                                            parents=[mutating])
    rollback_parser.set_defaults(func=cmd_rollback)
    rollback_parser.add_argument("workload", help="Workload name")
    rollback_parser.add_argument("--list", action="store_true", help="List available rollback targets instead of rolling back")

    secret_parser = subparsers.add_parser("secret", help="Manage secrets (systemd credentials)")
    secret_parser.set_defaults(func=cmd_secret)
    secret_subparsers = secret_parser.add_subparsers(dest="subcommand", required=True, help="Secret operation")

    secret_create = secret_subparsers.add_parser("create", help="Create a new encrypted credential")
    secret_create.add_argument("--file", help="Read secret from file instead of stdin")
    secret_create.add_argument("--force", action="store_true", help="Overwrite if exists")
    secret_create.add_argument("--key-type", choices=["tpm2", "host", "host+tpm2"], help="Encryption key type (default: tpm2)")
    secret_create.add_argument("name", help="Credential name")

    secret_list = secret_subparsers.add_parser("list", help="List all encrypted credentials")
    secret_list.add_argument("--json", action="store_true", help="Output in JSON format")

    secret_delete = secret_subparsers.add_parser("delete", help="Delete an encrypted credential")
    secret_delete.add_argument("--force", action="store_true", help="Skip confirmation")
    secret_delete.add_argument("name", help="Credential name")

    secret_show = secret_subparsers.add_parser("show", help="Decrypt and show credential value")
    secret_show.add_argument("name", help="Credential name")

    secret_rotate = secret_subparsers.add_parser("rotate", help="Rotate a credential and restart affected workloads")
    secret_rotate.add_argument("--key-type", choices=["tpm2", "host", "host+tpm2"], help="Encryption key type (default: tpm2)")
    secret_rotate.add_argument("name", help="Credential name")

    secret_export = secret_subparsers.add_parser("export", help="Export credential with passphrase encryption (portable)")
    secret_export.add_argument("--output", "-o", metavar="FILE", help="Output file (default: NAME.secret)")
    secret_export_pass = secret_export.add_mutually_exclusive_group()
    secret_export_pass.add_argument("--passphrase-file", metavar="PATH",
                                    help="Read passphrase from PATH ('-' for stdin) instead of prompting")
    secret_export_pass.add_argument("--passphrase-stdin", action="store_true",
                                    help="Read passphrase from stdin instead of prompting")
    secret_export.add_argument("name", help="Credential name")

    secret_import = secret_subparsers.add_parser("import", help="Import passphrase-encrypted credential and re-encrypt with TPM")
    secret_import.add_argument("--force", action="store_true", help="Overwrite if exists")
    secret_import.add_argument("--key-type", choices=["tpm2", "host", "host+tpm2"], help="Encryption key type (default: tpm2)")
    secret_import_pass = secret_import.add_mutually_exclusive_group()
    secret_import_pass.add_argument("--passphrase-file", metavar="PATH",
                                    help="Read passphrase from PATH ('-' for stdin) instead of prompting")
    secret_import_pass.add_argument("--passphrase-stdin", action="store_true",
                                    help="Read passphrase from stdin instead of prompting")
    secret_import.add_argument("name", help="Credential name")
    secret_import.add_argument("file", help="Passphrase-encrypted file to import")

    shell_parser = subparsers.add_parser("shell", help="Open interactive shell in container, or SSH into VM workloads (serial console fallback)")
    shell_parser.set_defaults(func=cmd_shell)
    shell_parser.add_argument("--console", action="store_true",
                              help="VM only: skip SSH and connect directly to the serial console (recovery path)")
    shell_parser.add_argument("workload", metavar="WORKLOAD[/CONTAINER]",
                              help="Workload, or workload/container for multi-container workloads")

    stats_parser = subparsers.add_parser("stats", help="Show resource usage statistics")
    stats_parser.set_defaults(func=cmd_stats)
    stats_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    stats_parser.add_argument("-f", "--follow", action="store_true", help="Follow stats (live updating)")
    stats_parser.add_argument("workload", nargs="?", help="Workload name (or show all)")

    status_parser = subparsers.add_parser("status", help="Show workload service status")
    status_parser.set_defaults(func=cmd_status)
    status_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    status_parser.add_argument("workload", nargs="?", help="Workload name (or show all if omitted)")

    start_parser = subparsers.add_parser("start", help="Start a workload service",
                                         parents=[mutating])
    start_parser.set_defaults(func=cmd_start)
    start_parser.add_argument("workload", help="Workload name")

    stop_parser = subparsers.add_parser("stop", help="Stop a workload service",
                                        parents=[mutating])
    stop_parser.set_defaults(func=cmd_stop)
    stop_parser.add_argument("workload", help="Workload name")

    update_parser = subparsers.add_parser("update", help="Pull latest image and restart (VM workloads: rebuild system disk)",
                                          parents=[mutating])
    update_parser.set_defaults(func=cmd_update)
    update_parser.add_argument("--all", action="store_true", help="Update all enabled workloads")
    update_parser.add_argument("--force", action="store_true", help="Restart even if image unchanged")
    update_parser.add_argument("--dry-run", action="store_true",
                               help="Print what would be pulled and restarted, without changing anything")
    update_parser.add_argument("workload", nargs="?", help="Workload name")

    validate_parser = subparsers.add_parser("validate", help="Validate workload configuration")
    validate_parser.set_defaults(func=cmd_validate)
    validate_parser.add_argument("--all", action="store_true", help="Validate all workloads")
    validate_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    validate_parser.add_argument("workload", nargs="?", help="Workload name")

    diagnose_parser = subparsers.add_parser("diagnose", help="Diagnose workload runtime setup (user, subids, linger, SELinux)")
    diagnose_parser.set_defaults(func=cmd_diagnose)
    diagnose_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    diagnose_parser.add_argument("workload", help="Workload name")

    doctor_parser = subparsers.add_parser("doctor", help="Aggregate diagnosis: generator log, unit states, setup checks, drift, health")
    doctor_parser.set_defaults(func=cmd_doctor)
    doctor_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    doctor_parser.add_argument("workload", help="Workload name")

    args = parser.parse_args()

    # One configure() for the whole process, before any handler can speak.
    #
    # Two different flags spell themselves --json. On a read verb it means "my
    # stdout is a report I print myself"; on a mutating verb it means "cli_log
    # writes the result object to stdout". Both need prose off stdout, so both
    # set quiet — but only the second may set json_mode, because json_mode is
    # what licenses cli_log to *write* a document there. Granting it to a read
    # verb puts a second JSON object on a stream that already holds a report
    # (emit_failure fires from the exit ladder on any non-zero exit), and no
    # parser downstream survives that.
    json_flag = getattr(args, "json", False)
    cli_log.configure(
        quiet=getattr(args, "quiet", False) or json_flag,
        json_mode=json_flag and getattr(args, "emits_result", False),
        command=args.command,
    )

    # Create manager
    manager = WorkloadManager()

    # Each subparser above sets its own `func` default (set_defaults(func=...)),
    # so dispatch is just calling whichever handler argparse resolved.
    handler = getattr(args, "func", None)
    if handler:
        handler(args, manager)
    else:
        print(f"Command '{args.command}' not yet implemented", file=sys.stderr)
        sys.exit(1)


def _run_cli() -> int:
    """Run main() and map library exceptions to the process exit code.

    Split out from the __main__ guard so the exception→exit-code contract is
    unit-testable. Returns the code the process should exit with; SystemExit
    raised inside main() (handlers that call sys.exit directly) propagates
    unchanged, exactly as before.

    Every failing path also calls cli_log.emit_failure(), which is a no-op
    unless --json: a scripted caller must get a result document on stdout even
    when the command died before it could report its own, and this ladder is
    the one place that sees every way that can happen. A command that already
    emitted its own result (a partly-failed `update --all`, whose per-workload
    rows say far more than this backstop could) keeps it.
    """
    try:
        main()
    except SystemExit as e:
        if e.code not in (0, None):
            cli_log.emit_failure(f"command failed (exit {e.code}); see stderr")
        raise
    except KeyboardInterrupt:
        print("\nInterrupted", file=sys.stderr)
        cli_log.emit_failure("interrupted")
        return 130
    except UsageError as e:
        # Message already printed by the raiser; usage errors exit 2.
        cli_log.emit_failure(str(e))
        return 2
    except LifecycleError as e:
        # Diagnostic (if any) already printed by the raiser; reproduce the
        # exact returncode of the systemctl/podman invocation that failed.
        cli_log.emit_failure(f"lifecycle command failed (exit {e.returncode})")
        return e.returncode
    except ImageTransferError as e:
        # Backstop for `recreate`, which has no per-workload result to emit.
        # `enable` catches this itself so it can emit one.
        print(f"Error: {e}", file=sys.stderr)
        cli_log.emit_failure(str(e))
        return 1
    except ProvisionFailed as e:
        # Raiser prints the "✗ ..." diagnostic. Commands that need to keep going
        # (update --all tallies per-workload failures) catch it themselves; this
        # is the backstop for the ones that just need a clean nonzero exit.
        cli_log.emit_failure(str(e))
        return 1
    except NotRoot as e:
        print(f"Error: {e}", file=sys.stderr)
        cli_log.emit_failure(str(e))
        return 1
    except WorkloadMasked as e:
        print(str(e), file=sys.stderr)
        cli_log.emit_failure(str(e))
        return 1
    except WorkloadUserNotFound as e:
        print(f"Error: {e}", file=sys.stderr)
        cli_log.emit_failure(str(e))
        return 1
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        cli_log.emit_failure(str(e))
        return 1
    except Exception as e:
        # Unexpected: not one of the typed errors above, so it's likely a bug
        # in workloadctl rather than an operator/environment condition. Print
        # the full traceback (not just the message) so a bug report has
        # something to act on.
        traceback.print_exc(file=sys.stderr)
        print(
            "This looks like a workloadctl bug, not a usage error. "
            "Please re-run the command and include the traceback above in a bug report.",
            file=sys.stderr,
        )
        cli_log.emit_failure(f"internal error: {e!r}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(_run_cli())
