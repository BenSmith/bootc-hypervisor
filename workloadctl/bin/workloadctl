#!/usr/bin/env python3
"""
workloadctl - Manage rootless system workloads

Provides Docker/kubectl-like CLI for managing containerized workloads
running as system services with rootless podman.
"""

import argparse
import sys

from cmd_admin import cmd_create, cmd_edit, cmd_uid_map, cmd_validate, cmd_verify
from cmd_backup import cmd_backup, cmd_restore
from cmd_drift import cmd_drift
from cmd_inspect import (
    cmd_health, cmd_images, cmd_info, cmd_list, cmd_network,
    cmd_ports, cmd_ps, cmd_stats, cmd_status,
)
from cmd_interact import cmd_attach, cmd_cp, cmd_exec, cmd_logs, cmd_shell
from cmd_lifecycle import (
    cmd_cleanup, cmd_disable, cmd_enable, cmd_reboot,
    cmd_recreate, cmd_start, cmd_stop,
)
from cmd_secret import cmd_secret
from cmd_update import cmd_rollback, cmd_update
from workloadctl_core import (
    WorkloadManager,
    WorkloadMasked,
    WorkloadUserNotFound,
)


def main():
    parser = argparse.ArgumentParser(
        prog="workloadctl",
        description="Manage rootless system workloads",
        epilog="For more information, see /usr/share/doc/workloadctl/"
    )

    subparsers = parser.add_subparsers(dest="command", required=True, help="Command to run")

    attach_parser = subparsers.add_parser("attach", help="Attach to container process")
    attach_parser.add_argument("workload", help="Workload name")

    cp_parser = subparsers.add_parser("cp", help="Copy files to/from container")
    cp_parser.add_argument("source", help="Source (workload:path or path)")
    cp_parser.add_argument("destination", help="Destination (workload:path or path)")

    create_parser = subparsers.add_parser("create", help="Create a new workload configuration")
    create_parser.add_argument("--audio", action="store_true", help="Enable audio (/dev/snd + auto-mount PulseAudio/PipeWire) - convenience flag")
    create_parser.add_argument("--device", metavar="DEVICE", action="append", help="Generic device passthrough; repeat per device (e.g., --device /dev/ttyUSB0 --device /dev/video0)")
    create_parser.add_argument("--enable", action="store_true", help="Enable and start the workload immediately")
    create_parser.add_argument("--gpu", metavar="SPEC", help="GPU access (convenience flag): 'amd', 'nvidia', 'intel', 'none', 'auto', or 'nvidia:<index|UUID>' to pin one GPU (see `nvidia-ctk cdi list`)")
    create_parser.add_argument("--groups", metavar="GROUP", action="append", help="Additional system group; repeat per group (e.g., --groups video --groups render)")
    create_parser.add_argument("--image", required=True, help="Container image (e.g., docker.io/library/nginx:alpine)")
    create_parser.add_argument("--input", action="store_true", help="Enable input devices (/dev/input + /dev/uinput) - convenience flag")
    create_parser.add_argument("--network", metavar="MODE", help="Network mode: 'host', 'pasta', 'none', or custom network name (default: pasta)")
    create_parser.add_argument("--ports", metavar="PORT", action="append", help="Port mapping; repeat per port (e.g., --ports 8080:80 --ports 8443:443)")
    create_parser.add_argument("--shm-size", metavar="SIZE", help="Shared memory size (e.g., 256m, 2g; default: 64m)")
    create_parser.add_argument("--systemd", metavar="MODE", choices=["always", "true", "false"],
                               help="Systemd container mode: 'always', 'true', or 'false' (skips --init, adds KillSignal)")
    create_parser.add_argument("--virtualization", action="store_true", help="Enable KVM (/dev/kvm + vhost devices) - convenience flag")
    create_parser.add_argument("--volumes", metavar="VOL", action="append", help="Volume mount; repeat per volume (e.g., --volumes /host/path:/container/path:ro)")
    create_parser.add_argument("name", help="Workload name (lowercase letters, numbers, hyphens, max 27 chars)")

    # Resource limit flags
    create_parser.add_argument("--cpu-quota", metavar="PERCENT", help="CPU quota (e.g., 50%%, 100%%, 200%%)")
    create_parser.add_argument("--cpu-weight", type=int, metavar="WEIGHT", help="CPU scheduling weight (1-10000, default 100)")
    create_parser.add_argument("--io-weight", type=int, metavar="WEIGHT", help="I/O scheduling weight (1-10000, default 100)")
    create_parser.add_argument("--memory-high", metavar="SIZE", help="Memory soft limit for throttling (e.g., 384M, 1.5G)")
    create_parser.add_argument("--memory-max", metavar="SIZE", help="Maximum memory (e.g., 512M, 2G, 4G)")
    create_parser.add_argument("--memory-swap-max", metavar="SIZE", help="Maximum swap usage (0 to disable, or size like 512M)")
    create_parser.add_argument("--tasks-max", type=int, metavar="NUM", help="Maximum number of tasks/threads")

    backup_parser = subparsers.add_parser("backup", help="Backup workload data and config")
    backup_parser.add_argument("--all", action="store_true", help="Backup all workloads")
    backup_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    backup_parser.add_argument("--no-stop", action="store_true",
                               help="Don't stop the service (live backup, may be inconsistent)")
    backup_parser.add_argument("--output", "-o", metavar="PATH",
                               help="Output path (file or directory)")
    backup_parser.add_argument("workload", nargs="?", help="Workload name")

    cleanup_parser = subparsers.add_parser("cleanup", help="Remove orphaned workload users, directories, and SELinux modules")
    cleanup_parser.add_argument("--apply", action="store_true",
                                help="Actually remove orphaned users/dirs (default is dry run)")
    cleanup_parser.add_argument("--json", action="store_true", help="Output in JSON format")

    drift_parser = subparsers.add_parser(
        "drift",
        help="Show diff between running units and what would be generated from current TOMLs",
    )
    drift_parser.add_argument(
        "workload", nargs="?", metavar="WORKLOAD",
        help="Filter to units belonging to a specific workload (default: all workloads)",
    )
    drift_parser.add_argument(
        "--json", action="store_true",
        help="Output diff as JSON",
    )

    disable_parser = subparsers.add_parser("disable", help="Stop and disable a workload (use --purge to also remove user and data)")
    disable_parser.add_argument("--purge", action="store_true",
                               help="Also remove user, home, and subuid/subgid")
    disable_parser.add_argument("workload", help="Workload name")

    edit_parser = subparsers.add_parser("edit", help="Edit config and apply changes")
    edit_parser.add_argument("workload", help="Workload name")
    edit_parser.add_argument(
        "-y", "--yes", action="store_true",
        help="Apply changes without the interactive confirmation prompt",
    )

    enable_parser = subparsers.add_parser("enable", help="Enable and start a workload")
    enable_parser.add_argument("workload", help="Workload name")

    exec_parser = subparsers.add_parser("exec", help="Execute command in workload container or VM (via SSH)")
    # Order matters and is NOT alphabetizable: WORKLOAD must come before the
    # COMMAND positional. argparse.REMAINDER is greedy, so it has to be the LAST
    # positional — first token binds to WORKLOAD, the rest are the command
    # (e.g. `workloadctl exec web wget -qO- ...`). Putting COMMAND first makes
    # the workload bind to the trailing token instead. Matches docker/podman.
    exec_parser.add_argument("workload", metavar="WORKLOAD[/CONTAINER]",
                             help="Workload, or workload/container for multi-container workloads")
    exec_parser.add_argument("exec_args", metavar="COMMAND", nargs=argparse.REMAINDER,
                             help="Command to execute (a leading -- is optional)")

    health_parser = subparsers.add_parser("health", help="Check workload health")
    health_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    health_parser.add_argument("workload", metavar="WORKLOAD[/CONTAINER]",
                               help="Workload, or workload/container for multi-container workloads")

    info_parser = subparsers.add_parser("info", help="Show detailed workload information")
    info_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    info_parser.add_argument("workload", help="Workload name")

    images_parser = subparsers.add_parser("images", help="Show images or prune unused")
    images_parser.add_argument("--json", action="store_true", help="Output in JSON format (for list)")
    images_parser.add_argument("subcommand", nargs="?", default="list",
                               choices=["list", "prune"], help="Subcommand (list or prune)")
    list_parser = subparsers.add_parser("list", help="List all available workloads")
    list_parser.add_argument("--json", action="store_true", help="Output in JSON format")

    logs_parser = subparsers.add_parser("logs", help="View workload logs (journalctl wrapper)")
    logs_parser.add_argument("-f", "--follow", action="store_true", help="Follow log output")
    logs_parser.add_argument("-n", "--lines", type=int, metavar="N", help="Show last N lines (default: 50)")
    logs_parser.add_argument("--since", metavar="TIME", help="Show logs since TIME")
    logs_parser.add_argument("extra_args", nargs="*", help="Additional journalctl arguments")
    logs_parser.add_argument("workload", metavar="WORKLOAD[/CONTAINER]",
                             help="Workload, or workload/container for multi-container workloads")

    network_parser = subparsers.add_parser("network", help="Manage podman networks")
    network_parser.add_argument("network_name", help="Network name")
    network_parser.add_argument("subcommand", choices=["create"], help="Subcommand (create)")
    network_parser.add_argument("workload", help="Workload to create network for")

    ports_parser = subparsers.add_parser("ports", help="Show port information")
    ports_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    ports_parser.add_argument("workload", help="Workload name")

    ps_parser = subparsers.add_parser("ps", help="Show all running workload containers")
    ps_parser.add_argument("--json", action="store_true", help="Output in JSON format")

    reboot_parser = subparsers.add_parser("reboot", help="Soft-reboot a systemd container (keeps overlay)")
    reboot_parser.add_argument("workload", help="Workload name")

    recreate_parser = subparsers.add_parser("recreate", help="Recreate container from image (destroys overlay)")
    recreate_parser.add_argument("workload", help="Workload name")

    restore_parser = subparsers.add_parser("restore", help="Restore a workload from backup")
    restore_parser.add_argument("--enable", action="store_true",
                                help="Enable the workload after restore")
    restore_parser.add_argument("--force", action="store_true",
                                help="Overwrite existing config, credentials, and home dir")
    restore_parser.add_argument("archive", help="Path to backup archive (.tar.zst)")

    rollback_parser = subparsers.add_parser("rollback", help="Roll back to previous image (VM workloads: restore previous disk generation)")
    rollback_parser.add_argument("workload", help="Workload name")

    secret_parser = subparsers.add_parser("secret", help="Manage secrets (systemd credentials)")
    secret_subparsers = secret_parser.add_subparsers(dest="subcommand", required=True, help="Secret operation")

    secret_create = secret_subparsers.add_parser("create", help="Create a new encrypted credential")
    secret_create.add_argument("--file", help="Read secret from file instead of stdin")
    secret_create.add_argument("--force", action="store_true", help="Overwrite if exists")
    secret_create.add_argument("--key-type", choices=["tpm2", "host", "host+tpm2"], help="Encryption key type (default: tpm2)")
    secret_create.add_argument("name", help="Credential name")

    secret_list = secret_subparsers.add_parser("list", help="List all encrypted credentials")
    secret_list.add_argument("--json", action="store_true", help="Output in JSON format")

    secret_delete = secret_subparsers.add_parser("delete", help="Delete an encrypted credential")
    secret_delete.add_argument("--force", action="store_true", help="Skip confirmation")
    secret_delete.add_argument("name", help="Credential name")

    secret_show = secret_subparsers.add_parser("show", help="Decrypt and show credential value")
    secret_show.add_argument("name", help="Credential name")

    secret_rotate = secret_subparsers.add_parser("rotate", help="Rotate a credential and restart affected workloads")
    secret_rotate.add_argument("--key-type", choices=["tpm2", "host", "host+tpm2"], help="Encryption key type (default: tpm2)")
    secret_rotate.add_argument("name", help="Credential name")

    secret_export = secret_subparsers.add_parser("export", help="Export credential with passphrase encryption (portable)")
    secret_export.add_argument("--output", "-o", metavar="FILE", help="Output file (default: NAME.secret)")
    secret_export_pass = secret_export.add_mutually_exclusive_group()
    secret_export_pass.add_argument("--passphrase-file", metavar="PATH",
                                    help="Read passphrase from PATH ('-' for stdin) instead of prompting")
    secret_export_pass.add_argument("--passphrase-stdin", action="store_true",
                                    help="Read passphrase from stdin instead of prompting")
    secret_export.add_argument("name", help="Credential name")

    secret_import = secret_subparsers.add_parser("import", help="Import passphrase-encrypted credential and re-encrypt with TPM")
    secret_import.add_argument("--force", action="store_true", help="Overwrite if exists")
    secret_import.add_argument("--key-type", choices=["tpm2", "host", "host+tpm2"], help="Encryption key type (default: tpm2)")
    secret_import_pass = secret_import.add_mutually_exclusive_group()
    secret_import_pass.add_argument("--passphrase-file", metavar="PATH",
                                    help="Read passphrase from PATH ('-' for stdin) instead of prompting")
    secret_import_pass.add_argument("--passphrase-stdin", action="store_true",
                                    help="Read passphrase from stdin instead of prompting")
    secret_import.add_argument("name", help="Credential name")
    secret_import.add_argument("file", help="Passphrase-encrypted file to import")

    shell_parser = subparsers.add_parser("shell", help="Open interactive shell in container, or SSH into VM workloads (serial console fallback)")
    shell_parser.add_argument("--console", action="store_true",
                              help="VM only: skip SSH and connect directly to the serial console (recovery path)")
    shell_parser.add_argument("workload", metavar="WORKLOAD[/CONTAINER]",
                              help="Workload, or workload/container for multi-container workloads")

    stats_parser = subparsers.add_parser("stats", help="Show resource usage statistics")
    stats_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    stats_parser.add_argument("-f", "--follow", action="store_true", help="Follow stats (live updating)")
    stats_parser.add_argument("workload", nargs="?", help="Workload name (or show all)")

    status_parser = subparsers.add_parser("status", help="Show workload service status")
    status_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    status_parser.add_argument("workload", nargs="?", help="Workload name (or show all if omitted)")

    start_parser = subparsers.add_parser("start", help="Start a workload service")
    start_parser.add_argument("workload", help="Workload name")

    stop_parser = subparsers.add_parser("stop", help="Stop a workload service")
    stop_parser.add_argument("workload", help="Workload name")

    uid_map_parser = subparsers.add_parser("uid-map", help="Show UID/GID mapping for a workload")
    uid_map_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    uid_map_parser.add_argument("workload", help="Workload name")

    update_parser = subparsers.add_parser("update", help="Pull latest image and restart (VM workloads: rebuild system disk)")
    update_parser.add_argument("--all", action="store_true", help="Update all enabled workloads")
    update_parser.add_argument("--force", action="store_true", help="Restart even if image unchanged")
    update_parser.add_argument("workload", nargs="?", help="Workload name")

    validate_parser = subparsers.add_parser("validate", help="Validate workload configuration")
    validate_parser.add_argument("--all", action="store_true", help="Validate all workloads")
    validate_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    validate_parser.add_argument("workload", nargs="?", help="Workload name")

    verify_parser = subparsers.add_parser("verify", help="Verify workload setup and diagnose issues")
    verify_parser.add_argument("--json", action="store_true", help="Output in JSON format")
    verify_parser.add_argument("workload", help="Workload name")

    args = parser.parse_args()

    # Create manager
    manager = WorkloadManager()

    command_map = {
        "attach": cmd_attach,
        "backup": cmd_backup,
        "cleanup": cmd_cleanup,
        "cp": cmd_cp,
        "create": cmd_create,
        "disable": cmd_disable,
        "edit": cmd_edit,
        "enable": cmd_enable,
        "exec": cmd_exec,
        "health": cmd_health,
        "images": cmd_images,
        "info": cmd_info,
        "list": cmd_list,
        "logs": cmd_logs,
        "network": cmd_network,
        "ports": cmd_ports,
        "ps": cmd_ps,
        "reboot": cmd_reboot,
        "recreate": cmd_recreate,
        "restore": cmd_restore,
        "secret": cmd_secret,
        "shell": cmd_shell,
        "start": cmd_start,
        "stats": cmd_stats,
        "status": cmd_status,
        "stop": cmd_stop,
        "rollback": cmd_rollback,
        "drift": cmd_drift,
        "uid-map": cmd_uid_map,
        "update": cmd_update,
        "validate": cmd_validate,
        "verify": cmd_verify,
    }

    handler = command_map.get(args.command)
    if handler:
        handler(args, manager)
    else:
        print(f"Command '{args.command}' not yet implemented", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrupted", file=sys.stderr)
        sys.exit(130)
    except WorkloadMasked as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
    except WorkloadUserNotFound as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
