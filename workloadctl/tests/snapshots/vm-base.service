# VM workload service for vm-base
# Generated by workload-generate

[Unit]
Description=vm-base VM workload
Requires=workload-vm-base-setup.service workload-vm-base-build.service workload-bridge.service
After=workload-vm-base-setup.service workload-vm-base-build.service workload-bridge.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=all
Slice=workloads.slice
User=_wl-vm-base
Group=_wl-vm-base
Environment="HOME=/var/lib/workloads/vm-base/state"
EnvironmentFile=-/run/workload-env/workload-vm-base.env
RuntimeDirectory=workload-vm/vm-base
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

ExecStart=/usr/libexec/workloadctl/workload-vm-notify "vm-base" \
    /usr/bin/qemu-system-x86_64 \
        -machine q35,accel=kvm \
        -cpu host \
        -m 2048 \
        -smp 2 \
        -drive if=pflash,format=raw,readonly=on,file=/usr/share/edk2/ovmf/OVMF_CODE.fd \
        -drive if=pflash,format=raw,file=/var/lib/workloads/vm-base/state/nvram.fd \
        -drive file=/var/lib/workloads/vm-base/state/system.qcow2,if=virtio,format=qcow2,id=system \
        -drive file=/run/workload-vm/vm-base/cloud-init.iso,if=virtio,format=raw,readonly=on,media=cdrom,id=cloudinit \
        -netdev bridge,id=net0,br=_workload-br \
        -device virtio-net-pci,netdev=net0,mac=4a:ad:25:eb:ed:0e \
        -device virtio-balloon-pci \
        -serial unix:/run/workload-vm/vm-base/console.sock,server=on,wait=off \
        -qmp unix:/run/workload-vm/vm-base/qmp.sock,server=on,wait=off \
        -qmp unix:/run/workload-vm/vm-base/qmp-metrics.sock,server=on,wait=off \
        -nographic \
        -no-reboot \
        -name vm-base

ExecStop=/usr/libexec/workloadctl/workload-vm-shutdown "vm-base"

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=10s
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
