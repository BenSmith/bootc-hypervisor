# Rootless workload service for wireguard-vpn
# Generated by workload-generate

[Unit]
Description=wireguard-vpn rootless workload
Requires=workload-wireguard-vpn-setup.service
After=network.target workload-wireguard-vpn-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-wireguard-vpn
Group=_wl-wireguard-vpn
Environment="HOME=/var/lib/workloads/wireguard-vpn"
EnvironmentFile=-/run/workload-env/workload-wireguard-vpn.env

# Resource limits and constraints
CPUQuota=20%
MemoryMax=128M
MemoryHigh=96M


# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-wireguard-vpn" --hostname "wireguard-vpn" --rm --init --sdnotify=ignore --pull=never --log-driver=journald --userns=host --cap-add=NET_ADMIN --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="pasta" --volume "/var/lib/workloads/wireguard-vpn/wg0.conf":/etc/wireguard/wg0.conf:ro --env HOST_IP=${HOST_IP} --env WG_INTERFACE=wg0 --health-cmd "wg show wg0 > /dev/null 2>&1 || exit 1" --health-interval=30s --health-start-period=15s --health-on-failure=kill "localhost/wireguard-vpn:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-wireguard-vpn"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/wireguard-vpn" /run/user/__UID__
PrivateTmp=yes
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
