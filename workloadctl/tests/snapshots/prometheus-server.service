# Rootless workload service for prometheus-server
# Generated by workload-generate

[Unit]
Description=prometheus-server rootless workload
Requires=workload-prometheus-server-setup.service
After=network.target workload-prometheus-server-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-prometheus-server
Group=_wl-prometheus-server
Environment="HOME=/var/lib/workloads/prometheus-server"
EnvironmentFile=-/run/workload-env/workload-prometheus-server.env

# Resource limits and constraints
CPUQuota=50%
MemoryMax=512M
MemoryHigh=384M


# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-prometheus-server" --rm --init --sdnotify=ignore --pull=missing --log-driver=journald --userns=keep-id:uid=65534,gid=65534 --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="host" --volume "/var/lib/workloads/prometheus-server/prometheus.yml":/etc/prometheus/prometheus.yml:ro --volume "/var/lib/workloads/prometheus-server/rules":/etc/prometheus/rules:ro --volume "/var/lib/workloads/prometheus-server/data":/prometheus --health-cmd "wget -qO- http://localhost:9090/-/ready > /dev/null || exit 1" --health-interval=30s --health-start-period=30s --health-on-failure=kill "quay.io/prometheus/prometheus:latest" "--config.file=/etc/prometheus/prometheus.yml" "--storage.tsdb.path=/prometheus" "--storage.tsdb.retention.time=30d" "--web.enable-lifecycle"

ExecStop=/usr/bin/podman stop -t 10 "workload-prometheus-server"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/prometheus-server" /run/user/10013
PrivateTmp=yes
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
