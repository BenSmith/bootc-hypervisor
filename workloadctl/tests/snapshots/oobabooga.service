# Rootless workload service for oobabooga
# Generated by workload-generate

[Unit]
Description=oobabooga rootless workload
Requires=workload-oobabooga-setup.service
After=network.target workload-oobabooga-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=nvidia-cdi-generator.service
After=nvidia-cdi-generator.service

[Service]
Type=exec
Slice=workloads.slice
User=_wl-oobabooga
Group=_wl-oobabooga
Environment="HOME=/var/lib/workloads/oobabooga/state"
EnvironmentFile=-/run/workload-env/workload-oobabooga.env

ExecStartPre=/bin/bash -c 'test -s /run/cdi/nvidia.yaml || { echo "NVIDIA CDI spec missing: check nvidia-cdi-generator.service" >&2; exit 1; }'
ExecStartPre=-/usr/bin/podman system migrate
ExecStartPre=-/usr/bin/rm -f /run/user/__UID__/libpod/tmp/pause.pid /run/user/__UID__/libpod/tmp/ns_handles

# Image pulling handled by podman run --pull=newer

ExecStart=/usr/bin/podman run --name "workload-oobabooga" --hostname "oobabooga" --rm --replace --init --sdnotify=ignore --pull=newer --log-driver=passthrough --uidmap +__UID__:@__UID__:1 --gidmap +__UID__:@__UID__:1 --gidmap +39:@39:1 --gidmap +105:@105:1 --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device=nvidia.com/gpu=all --device /dev/dri --shm-size=1g --network="pasta" --publish 7860:7860 --publish 5000:5000 --volume "/var/lib/workloads/oobabooga/data/models":/app/text-generation-webui/models --env HOST_IP=${HOST_IP} --env EXTRA_LAUNCH_ARGS='--listen --api' --health-cmd "curl -sf http://localhost:7860/ || exit 1" --health-interval=30s --health-start-period=120s --health-on-failure=kill "docker.io/atinoda/text-generation-webui:default-cpu"

ExecStop=/usr/bin/podman stop -t 10 "workload-oobabooga"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-oobabooga"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-oobabooga
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/oobabooga" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
