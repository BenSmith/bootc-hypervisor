# Rootless workload service for pihole
# Generated by workload-generate

[Unit]
Description=pihole rootless workload
Requires=workload-pihole-setup.service
After=network.target workload-pihole-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Wants=workload-pihole-health.timer

[Service]
Type=exec
Slice=workloads.slice
Delegate=yes
User=_wl-pihole
Group=_wl-pihole
Environment="HOME=/var/lib/workloads/pihole"
Environment=DISABLE_HC_SYSTEMD=true
EnvironmentFile=-/run/workload-env/workload-pihole.env

# Resource limits and constraints
CPUQuota=25%
MemoryMax=256M
MemoryHigh=192M


# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-pihole" --hostname "pihole" --rm --init --sdnotify=ignore --pull=missing --log-driver=journald --cgroups=split --userns=host --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="host" --volume "/var/lib/workloads/pihole/etc-pihole":/etc/pihole --volume "/var/lib/workloads/pihole/etc-dnsmasq.d":/etc/dnsmasq.d --env HOST_IP=${HOST_IP} --env WEBPASSWORD='' --env PIHOLE_DNS_='1.1.1.1;1.0.0.1' --health-cmd "dig +short +time=2 @127.0.0.1 pi.hole || exit 1" --health-interval=30s --health-start-period=60s --health-on-failure=none "docker.io/pihole/pihole:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-pihole"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/pihole" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
