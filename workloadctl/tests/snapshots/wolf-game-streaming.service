# Rootless workload service for wolf-game-streaming
# Generated by workload-generate

[Unit]
Description=wolf-game-streaming rootless workload
Requires=workload-wolf-game-streaming-setup.service
After=network.target workload-wolf-game-streaming-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=nvidia-cdi-generator.service
After=nvidia-cdi-generator.service
Wants=workload-wolf-game-streaming-health.timer

[Service]
Type=exec
Slice=workloads.slice
Delegate=yes
User=_wl-wolf-game-streaming
Group=_wl-wolf-game-streaming
Environment="HOME=/var/lib/workloads/wolf-game-streaming"
Environment=DISABLE_HC_SYSTEMD=true
EnvironmentFile=-/run/workload-env/workload-wolf-game-streaming.env

# Resource limits and constraints
CPUQuota=400%
MemoryMax=8G
MemoryHigh=6G
TasksMax=16384

ExecStartPre=/bin/bash -c 'test -s /run/cdi/nvidia.yaml || { echo "NVIDIA CDI spec missing: check nvidia-cdi-generator.service" >&2; exit 1; }'

# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-wolf-game-streaming" --hostname "wolf-game-streaming" --rm --replace --init --sdnotify=ignore --pull=never --log-driver=journald --cgroups=split --uidmap +1000:@__UID__:1 --gidmap +1000:@__UID__:1 --gidmap +39:@39:1 --gidmap +105:@105:1 --gidmap +104:@104:1 --cap-add=CHOWN --cap-add=DAC_OVERRIDE --cap-add=FOWNER --cap-add=SETUID --cap-add=SETGID --cap-add=FSETID --cap-add=KILL --cap-add=NET_BIND_SERVICE --cap-add=SETFCAP --cap-add=SETPCAP --cap-add=SYS_CHROOT --cap-add=SYS_NICE --security-opt=label=type:wl_wolf_game_streaming.process --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device=nvidia.com/gpu=all --device /dev/dri --device /dev/uinput --shm-size=2g --pids-limit=16384 --network="host" --volume "/var/lib/workloads/wolf-game-streaming/config":/etc/wolf --volume "/var/lib/workloads/wolf-game-streaming/home":/home/steam --volume "/run/udev":/run/udev:ro --volume "/dev/input":/dev/input --env HOST_IP=${HOST_IP} --health-cmd "pgrep -x wolf > /dev/null || exit 1" --health-interval=30s --health-start-period=30s --health-on-failure=none "localhost/wolf-game-streaming:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-wolf-game-streaming"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/wolf-game-streaming" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
