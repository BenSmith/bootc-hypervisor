# Rootless workload service for alloy
# Generated by workload-generate

[Unit]
Description=alloy rootless workload
Requires=workload-alloy-setup.service
After=network.target workload-alloy-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-alloy
Group=_wl-alloy
Environment="HOME=/var/lib/workloads/alloy/state"
EnvironmentFile=-/run/workload-env/workload-alloy.env

ExecStartPre=-/usr/bin/podman system migrate
ExecStartPre=-/usr/bin/rm -f /run/user/__UID__/libpod/tmp/pause.pid /run/user/__UID__/libpod/tmp/ns_handles

# Image pulling handled by podman run --pull=newer

ExecStart=/usr/bin/podman run --name "workload-alloy" --hostname "alloy" --rm --replace --init --sdnotify=ignore --pull=newer --log-driver=passthrough --userns=host --security-opt=label=type:wl_alloy.process --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --memory=1G --cpus=0.5 --network="pasta" --publish 127.0.0.1:4317:4317 --publish 127.0.0.1:4318:4318 --volume "/var/lib/workloads/alloy/data/alloy-config.alloy":"/etc/alloy/config.alloy":"ro" --volume "/run/log/journal":"/run/log/journal":"ro" --volume "/var/log/journal":"/var/log/journal":"ro" --volume "/run/workload-exporter":"/run/workload-exporter":"ro" --volume "/":"/host":"ro,rslave" --env HOST_IP=${HOST_IP} --env CENTRAL_HOST="CHANGE_ME" --env HOST_LABEL="CHANGE_ME" --env ROLE_LABEL="CHANGE_ME" --health-cmd "bash -c 'exec 3<>/dev/tcp/localhost/12345' || exit 1" --health-interval=60s --health-start-period=30s --health-on-failure=none "docker.io/grafana/alloy:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-alloy"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-alloy"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-alloy
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/alloy" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
