# Rootless workload service for socks5-vpn
# Generated by workload-generate

[Unit]
Description=socks5-vpn rootless workload
Requires=workload-socks5-vpn-setup.service
After=network.target workload-socks5-vpn-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-socks5-vpn
Group=_wl-socks5-vpn
Environment="HOME=/var/lib/workloads/socks5-vpn/state"
EnvironmentFile=-/run/workload-env/workload-socks5-vpn.env

ExecStartPre=-/usr/bin/podman system migrate
ExecStartPre=-/usr/bin/rm -f /run/user/__UID__/libpod/tmp/pause.pid /run/user/__UID__/libpod/tmp/ns_handles

# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-socks5-vpn" --hostname "socks5-vpn" --rm --replace --init --sdnotify=ignore --pull=never --log-driver=passthrough --userns=host --cap-add=NET_ADMIN --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --memory=128M --cpus=0.2 --network="pasta" --publish 127.0.0.1:1080:1080 --volume "/var/lib/workloads/socks5-vpn/data/wg0.conf":"/etc/wireguard/wg0.conf":"ro" --env HOST_IP=${HOST_IP} --env WG_INTERFACE="wg0" --env SOCKS_PORT="1080" --health-cmd "wg show wg0 > /dev/null 2>&1 || exit 1" --health-interval=30s --health-start-period=15s --health-on-failure=kill "localhost/socks5-vpn:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-socks5-vpn"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-socks5-vpn"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-socks5-vpn
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/socks5-vpn" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
