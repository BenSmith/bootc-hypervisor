# Container service for example-multi-container/web
# Generated by workload-generate

[Unit]
Description=example-multi-container/web container
Requires=workload-example-multi-container-net.service
After=workload-example-multi-container-net.service
BindsTo=workload-example-multi-container-net.service
PartOf=workload-example-multi-container.service
StartLimitIntervalSec=300
StartLimitBurst=5
Wants=workload-example-multi-container-web-health.timer

[Service]
Type=exec
Slice=workloads.slice
Delegate=yes
User=_wl-example-multi-container
Group=_wl-example-multi-container
Environment="HOME=/var/lib/workloads/example-multi-container"
Environment=DISABLE_HC_SYSTEMD=true
EnvironmentFile=-/run/workload-env/workload-example-multi-container.env

# Resource limits and constraints
MemoryMax=512M
MemoryHigh=384M

# Load encrypted credentials (auto-decrypted to /run/credentials/{service}/)
LoadCredentialEncrypted=forgejo-db-password:/etc/credstore.encrypted/forgejo-db-password

ExecStartPre=+/usr/libexec/workloadctl/workload-write-env example-multi-container web

# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-example-multi-container-web" --hostname "example-multi-container" --rm --init --sdnotify=ignore --pull=missing --log-driver=journald --cgroups=split --userns=keep-id --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="workload-example-multi-container-net" --network-alias="web" --publish 3000:3000 --volume "/var/lib/workloads/example-multi-container/data":/var/lib/gitea --env HOST_IP=${HOST_IP} --env FORGEJO__database__DB_TYPE=postgres --env FORGEJO__database__HOST=db:5432 --env FORGEJO__database__NAME=forgejo --env FORGEJO__database__USER=forgejo --env-file "/run/workload-env/workload-example-multi-container-web.secrets" --health-cmd "wget -qO- http://localhost:3000/api/healthz > /dev/null || exit 1" --health-interval=30s --health-start-period=30s --health-on-failure=none "codeberg.org/forgejo/forgejo:15-rootless"

ExecStop=/usr/bin/podman stop -t 10 "workload-example-multi-container-web"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/example-multi-container" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30
