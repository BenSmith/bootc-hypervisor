# Rootless workload service for vncdesktop-sway
# Generated by workload-generate

[Unit]
Description=vncdesktop-sway rootless workload
Requires=workload-vncdesktop-sway-setup.service
After=network.target workload-vncdesktop-sway-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=nvidia-cdi-generator.service
After=nvidia-cdi-generator.service

[Service]
Type=exec
Slice=workloads.slice
Delegate=yes
KillSignal=SIGRTMIN+3
User=_wl-vncdesktop-sway
Group=_wl-vncdesktop-sway
Environment="HOME=/var/lib/workloads/vncdesktop-sway"
EnvironmentFile=-/run/workload-env/workload-vncdesktop-sway.env

# Resource limits and constraints
CPUQuota=200%
MemoryMax=4G
MemoryHigh=3G
TasksMax=16384

ExecStartPre=/bin/bash -c 'test -s /run/cdi/nvidia.yaml || { echo "NVIDIA CDI spec missing: check nvidia-cdi-generator.service" >&2; exit 1; }'

# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-vncdesktop-sway" --hostname "vncdesktop-sway" --rm --systemd=always --sdnotify=ignore --pull=never --log-driver=journald --cgroups=split --uidmap +1000:@__UID__:1 --gidmap +1000:@__UID__:1 --gidmap +39:@39:1 --gidmap +105:@105:1 --uidmap +0:@__UID__:1 --gidmap +0:@__UID__:1 --cap-add=CHOWN --cap-add=DAC_OVERRIDE --cap-add=FOWNER --cap-add=SETUID --cap-add=SETGID --cap-add=FSETID --cap-add=KILL --security-opt=label=type:wl_vncdesktop_sway.process --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device=nvidia.com/gpu=all --device /dev/dri --shm-size=2G --pids-limit=16384 --network="host" --volume "/var/lib/workloads/vncdesktop-sway/home":/home/desktop --volume "/run/udev":/run/udev:ro --volume "/run/systemd/journal/socket":/run/host-systemd/journal/socket --env HOST_IP=${HOST_IP} --env CONTAINER_USER=desktop --env CONTAINER_UID=1000 --env CONTAINER_GID=1000 --env LANG=C.UTF-8 --env NO_AT_BRIDGE=1 --health-cmd "pgrep -x wayvnc > /dev/null || exit 1" --health-interval=30s --health-start-period=15s --health-on-failure=kill "localhost/vncdesktop-sway:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-vncdesktop-sway"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/vncdesktop-sway" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
