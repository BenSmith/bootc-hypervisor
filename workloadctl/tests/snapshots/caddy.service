# Rootless workload service for caddy
# Generated by workload-generate

[Unit]
Description=caddy rootless workload
Requires=workload-caddy-setup.service
After=network.target workload-caddy-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Wants=workload-caddy-health.timer

[Service]
Type=simple
Slice=workloads.slice
Delegate=yes
User=_wl-caddy
Group=_wl-caddy
Environment="HOME=/var/lib/workloads/caddy"
Environment=DISABLE_HC_SYSTEMD=true
EnvironmentFile=-/run/workload-env/workload-caddy.env

# Resource limits and constraints
CPUQuota=100%
MemoryMax=256M
MemoryHigh=128M

ExecStartPre=-/usr/bin/podman system migrate

# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-caddy" --hostname "caddy" --rm --replace --init --sdnotify=ignore --pull=never --log-driver=passthrough --cgroups=split --userns=keep-id --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="host" --volume "/var/lib/workloads/caddy/Caddyfile":/etc/caddy/Caddyfile:ro --volume "/var/lib/workloads/caddy/data":/var/lib/caddy --volume "/var/lib/workloads/caddy/config":/etc/caddy/config --volume "/var/lib/workloads/caddy/homelab-root.crt":/etc/caddy/homelab-root.crt:ro --volume "/var/lib/workloads/caddy/homelab-root.key":/etc/caddy/homelab-root.key:ro --env HOST_IP=${HOST_IP} --health-cmd "curl -sS --max-time 5 -o /dev/null http://localhost:80/" --health-interval=30s --health-timeout=10s --health-retries=3 --health-start-period=15s --health-on-failure=none "localhost/caddy:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-caddy"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-caddy

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/caddy" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
