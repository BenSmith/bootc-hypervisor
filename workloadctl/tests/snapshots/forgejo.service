# Rootless workload service for forgejo
# Generated by workload-generate

[Unit]
Description=forgejo rootless workload
Requires=workload-forgejo-setup.service
After=network.target workload-forgejo-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Wants=workload-forgejo-health.timer

[Service]
Type=exec
Slice=workloads.slice
Delegate=yes
User=_wl-forgejo
Group=_wl-forgejo
Environment="HOME=/var/lib/workloads/forgejo"
Environment=DISABLE_HC_SYSTEMD=true
EnvironmentFile=-/run/workload-env/workload-forgejo.env

# Resource limits and constraints
CPUQuota=100%
MemoryMax=512M
MemoryHigh=384M

ExecStartPre=-/usr/bin/podman system migrate

# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-forgejo" --hostname "forgejo" --rm --replace --init --sdnotify=ignore --pull=missing --log-driver=journald --cgroups=split --userns=keep-id:uid=1000,gid=1000 --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="pasta" --publish 3000:3000 --publish 2222:2222 --volume "/var/lib/workloads/forgejo/data":/var/lib/gitea --env HOST_IP=${HOST_IP} --health-cmd "curl -sf http://localhost:3000/api/healthz" --health-interval=30s --health-start-period=30s --health-on-failure=none "codeberg.org/forgejo/forgejo:15-rootless"

ExecStop=/usr/bin/podman stop -t 10 "workload-forgejo"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/forgejo" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
