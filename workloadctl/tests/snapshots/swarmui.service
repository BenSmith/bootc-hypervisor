# Rootless workload service for swarmui
# Generated by workload-generate

[Unit]
Description=swarmui rootless workload
Requires=workload-swarmui-setup.service
After=network.target workload-swarmui-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=nvidia-cdi-generator.service
After=nvidia-cdi-generator.service

[Service]
Type=exec
Slice=workloads.slice
User=_wl-swarmui
Group=_wl-swarmui
Environment="HOME=/var/lib/workloads/swarmui/state"
EnvironmentFile=-/run/workload-env/workload-swarmui.env

ExecStartPre=/bin/bash -c 'test -s /run/cdi/nvidia.yaml || { echo "NVIDIA CDI spec missing: check nvidia-cdi-generator.service" >&2; exit 1; }'
ExecStartPre=-/usr/bin/podman system migrate
ExecStartPre=-/usr/bin/rm -f /run/user/__UID__/libpod/tmp/pause.pid /run/user/__UID__/libpod/tmp/ns_handles

# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-swarmui" --hostname "swarmui" --rm --replace --init --sdnotify=ignore --pull=missing --log-driver=passthrough --uidmap +__UID__:@__UID__:1 --gidmap +__UID__:@__UID__:1 --gidmap +39:@39:1 --gidmap +105:@105:1 --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device=nvidia.com/gpu=all --volume /dev/dri:/dev/dri --shm-size=1g --network="pasta" --publish 7801:7801 --volume "/var/lib/workloads/swarmui/data/data":"/SwarmUI/Data" --volume "/var/lib/workloads/swarmui/data/dlbackend":"/SwarmUI/dlbackend" --volume "/var/lib/workloads/swarmui/data/models":"/SwarmUI/Models" --volume "/var/lib/workloads/swarmui/data/output":"/SwarmUI/Output" --env HOST_IP=${HOST_IP} --env SWARMUI_ARGS="" --health-cmd "curl -sf http://localhost:7801/ > /dev/null 2>&1 || exit 1" --health-interval=30s --health-start-period=180s --health-on-failure=kill "registry.local/workloads/swarmui:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-swarmui"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-swarmui"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-swarmui
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/swarmui" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
