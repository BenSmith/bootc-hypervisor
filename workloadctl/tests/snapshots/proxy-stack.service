# Rootless workload service for proxy-stack
# Generated by workload-generate

[Unit]
Description=proxy-stack rootless workload
Requires=workload-proxy-stack-setup.service
After=network.target workload-proxy-stack-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-proxy-stack
Group=_wl-proxy-stack
Environment="HOME=/var/lib/workloads/proxy-stack"
EnvironmentFile=-/run/workload-env/workload-proxy-stack.env

ExecStartPre=-/usr/bin/podman system migrate

# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-proxy-stack" --hostname "proxy-stack" --rm --replace --init --sdnotify=ignore --pull=never --log-driver=passthrough --userns=host --cap-add=NET_ADMIN --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --memory=512M --cpus=0.3 --network="pasta" --publish 3128:3128/tcp --publish 1080:1080/tcp --publish 53:53/udp --publish 53:53/tcp --publish 80:80/tcp --volume "/var/lib/workloads/proxy-stack/wg0.conf":/etc/wireguard/wg0.conf:ro --volume "/var/lib/workloads/proxy-stack/squid.conf":/etc/squid/squid.conf:ro --volume "/var/lib/workloads/proxy-stack/etc-pihole":/etc/pihole --volume "/var/lib/workloads/proxy-stack/etc-dnsmasq.d":/etc/dnsmasq.d --volume "/var/lib/workloads/proxy-stack/cache":/var/spool/squid --env HOST_IP=${HOST_IP} --env WG_INTERFACE=wg0 --env SOCKS_PORT=1080 --env WEBPASSWORD='' --health-cmd "dig +short +time=2 @127.0.0.1 pi.hole || exit 1" --health-interval=30s --health-start-period=60s --health-on-failure=kill "localhost/proxy-stack:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-proxy-stack"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-proxy-stack"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-proxy-stack
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/proxy-stack" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
