# Rootless workload service for squid
# Generated by workload-generate

[Unit]
Description=squid rootless workload
Requires=workload-squid-setup.service
After=network.target workload-squid-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-squid
Group=_wl-squid
Environment="HOME=/var/lib/workloads/squid"
EnvironmentFile=-/run/workload-env/workload-squid.env

ExecStartPre=-/usr/bin/podman system migrate

# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-squid" --hostname "squid" --rm --replace --init --sdnotify=ignore --pull=never --log-driver=passthrough --userns=keep-id --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --memory=512M --cpus=0.5 --network="pasta" --publish 3128:3128 --volume "/var/lib/workloads/squid/squid.conf":/etc/squid/squid.conf:ro --volume "/var/lib/workloads/squid/cache":/var/spool/squid --env HOST_IP=${HOST_IP} --health-cmd "squidclient -h 127.0.0.1 -p 3128 mgr:info > /dev/null 2>&1 || exit 1" --health-interval=30s --health-start-period=10s --health-on-failure=kill "localhost/squid:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-squid"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-squid"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-squid
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/squid" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
