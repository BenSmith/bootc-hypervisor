# Rootless workload service for nvidia-gpu-exporter
# Generated by workload-generate

[Unit]
Description=nvidia-gpu-exporter rootless workload
Requires=workload-nvidia-gpu-exporter-setup.service
After=network.target workload-nvidia-gpu-exporter-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=nvidia-cdi-generator.service
After=nvidia-cdi-generator.service

[Service]
Type=exec
Slice=workloads.slice
User=_wl-nvidia-gpu-exporter
Group=_wl-nvidia-gpu-exporter
Environment="HOME=/var/lib/workloads/nvidia-gpu-exporter/state"
EnvironmentFile=-/run/workload-env/workload-nvidia-gpu-exporter.env

ExecStartPre=/bin/bash -c 'test -s /run/cdi/nvidia.yaml || { echo "NVIDIA CDI spec missing: check nvidia-cdi-generator.service" >&2; exit 1; }'
ExecStartPre=-/usr/bin/podman system migrate
ExecStartPre=-/usr/bin/rm -f /run/user/__UID__/libpod/tmp/pause.pid /run/user/__UID__/libpod/tmp/ns_handles

# Image pulling handled by podman run --pull=newer

ExecStart=/usr/bin/podman run --name "workload-nvidia-gpu-exporter" --hostname "nvidia-gpu-exporter" --rm --replace --init --sdnotify=ignore --pull=newer --log-driver=passthrough --uidmap +__UID__:@__UID__:1 --gidmap +__UID__:@__UID__:1 --gidmap +39:@39:1 --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device=nvidia.com/gpu=all --volume /dev/dri:/dev/dri --memory=256M --cpus=0.25 --network="pasta" --publish 9835:9835 --env HOST_IP=${HOST_IP} --health-cmd "bash -c 'exec 3<>/dev/tcp/localhost/9835' || exit 1" --health-interval=30s --health-start-period=20s --health-on-failure=kill "docker.io/utkuozdemir/nvidia_gpu_exporter:1.10.0"

ExecStop=/usr/bin/podman stop -t 10 "workload-nvidia-gpu-exporter"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-nvidia-gpu-exporter"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-nvidia-gpu-exporter
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/nvidia-gpu-exporter" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
