# Rootless workload service for comfyui
# Generated by workload-generate

[Unit]
Description=comfyui rootless workload
Requires=workload-comfyui-setup.service
After=network.target workload-comfyui-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=nvidia-cdi-generator.service
After=nvidia-cdi-generator.service

[Service]
Type=exec
Slice=workloads.slice
User=_wl-comfyui
Group=_wl-comfyui
Environment="HOME=/var/lib/workloads/comfyui/state"
EnvironmentFile=-/run/workload-env/workload-comfyui.env

ExecStartPre=/bin/bash -c 'test -s /run/cdi/nvidia.yaml || { echo "NVIDIA CDI spec missing: check nvidia-cdi-generator.service" >&2; exit 1; }'
ExecStartPre=-/usr/bin/podman system migrate
ExecStartPre=-/usr/bin/rm -f /run/user/__UID__/libpod/tmp/pause.pid /run/user/__UID__/libpod/tmp/ns_handles

# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-comfyui" --hostname "comfyui" --rm --replace --init --sdnotify=ignore --pull=missing --log-driver=passthrough --uidmap +__UID__:@__UID__:1 --gidmap +__UID__:@__UID__:1 --gidmap +39:@39:1 --gidmap +105:@105:1 --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device=nvidia.com/gpu=all --volume /dev/dri:/dev/dri --shm-size=1g --network="pasta" --publish 8188:8188 --volume "/var/lib/workloads/comfyui/data/models":"/comfyui/models" --volume "/var/lib/workloads/comfyui/data/output":"/comfyui/output" --volume "/var/lib/workloads/comfyui/data/custom_nodes":"/comfyui/custom_nodes" --volume "/var/lib/workloads/comfyui/data/user":"/comfyui/user" --volume "/var/lib/workloads/comfyui/data/input":"/comfyui/input" --env HOST_IP=${HOST_IP} --env COMFYUI_ARGS="--listen 0.0.0.0 --port 8188" --health-cmd "curl -sf http://localhost:8188/api/object_info > /dev/null 2>&1 || exit 1" --health-interval=30s --health-start-period=120s --health-on-failure=kill "registry.local/workloads/comfyui:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-comfyui"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-comfyui"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-comfyui
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/comfyui" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
