# Rootless workload service for llama-swap
# Generated by workload-generate

[Unit]
Description=llama-swap rootless workload
Requires=workload-llama-swap-setup.service
After=network.target workload-llama-swap-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=nvidia-cdi-generator.service
After=nvidia-cdi-generator.service

[Service]
Type=exec
Slice=workloads.slice
User=_wl-llama-swap
Group=_wl-llama-swap
Environment="HOME=/var/lib/workloads/llama-swap/state"
EnvironmentFile=-/run/workload-env/workload-llama-swap.env

ExecStartPre=/bin/bash -c 'test -s /run/cdi/nvidia.yaml || { echo "NVIDIA CDI spec missing: check nvidia-cdi-generator.service" >&2; exit 1; }'
ExecStartPre=-/usr/bin/podman system migrate
ExecStartPre=-/usr/bin/rm -f /run/user/__UID__/libpod/tmp/pause.pid /run/user/__UID__/libpod/tmp/ns_handles

# Image pulling handled by podman run --pull=newer

ExecStart=/usr/bin/podman run --name "workload-llama-swap" --hostname "llama-swap" --rm --replace --init --sdnotify=ignore --pull=newer --log-driver=passthrough --uidmap +__UID__:@__UID__:1 --gidmap +__UID__:@__UID__:1 --gidmap +39:@39:1 --gidmap +105:@105:1 --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device=nvidia.com/gpu=all --volume /dev/dri:/dev/dri --shm-size=1g --network="pasta" --publish 8080:8080 --volume "/var/lib/workloads/llama-swap/data/config.yaml":"/app/config.yaml":"ro" --volume "/var/lib/workloads/llama-swap/data/models":"/models":"ro" --env HOST_IP=${HOST_IP} --health-cmd "curl -sf http://localhost:8080/health || exit 1" --health-interval=30s --health-start-period=60s --health-on-failure=kill "ghcr.io/mostlygeek/llama-swap:vulkan"

ExecStop=/usr/bin/podman stop -t 10 "workload-llama-swap"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-llama-swap"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-llama-swap
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/llama-swap" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
