# Rootless workload service for pihole-vpn
# Generated by workload-generate

[Unit]
Description=pihole-vpn rootless workload
Requires=workload-pihole-vpn-setup.service
After=network.target workload-pihole-vpn-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Wants=workload-pihole-vpn-health.timer

[Service]
Type=exec
Slice=workloads.slice
Delegate=yes
User=_wl-pihole-vpn
Group=_wl-pihole-vpn
Environment="HOME=/var/lib/workloads/pihole-vpn"
Environment=DISABLE_HC_SYSTEMD=true
EnvironmentFile=-/run/workload-env/workload-pihole-vpn.env

# Resource limits and constraints
CPUQuota=20%
MemoryMax=256M
MemoryHigh=192M

ExecStartPre=-/usr/bin/podman system migrate

# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-pihole-vpn" --hostname "pihole-vpn" --rm --replace --init --sdnotify=ignore --pull=never --log-driver=journald --cgroups=split --userns=host --cap-add=NET_ADMIN --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="pasta" --publish 53:53/udp --publish 53:53/tcp --publish 80:80/tcp --volume "/var/lib/workloads/pihole-vpn/wg0.conf":/etc/wireguard/wg0.conf:ro --volume "/var/lib/workloads/pihole-vpn/etc-pihole":/etc/pihole --volume "/var/lib/workloads/pihole-vpn/etc-dnsmasq.d":/etc/dnsmasq.d --env HOST_IP=${HOST_IP} --env WG_INTERFACE=wg0 --env WEBPASSWORD='' --health-cmd "dig +short +time=2 @127.0.0.1 pi.hole || exit 1" --health-interval=30s --health-start-period=60s --health-on-failure=none "localhost/pihole-vpn:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-pihole-vpn"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/pihole-vpn" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
