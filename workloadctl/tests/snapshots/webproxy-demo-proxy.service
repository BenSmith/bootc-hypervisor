# Container service for webproxy-demo/proxy
# Generated by workload-generate

[Unit]
Description=webproxy-demo/proxy container
Requires=workload-webproxy-demo-net.service
After=workload-webproxy-demo-net.service
BindsTo=workload-webproxy-demo-net.service
PartOf=workload-webproxy-demo.service
StartLimitIntervalSec=300
StartLimitBurst=5
Wants=workload-webproxy-demo-proxy-health.timer

[Service]
Type=exec
Slice=workloads.slice
Delegate=yes
User=_wl-webproxy-demo
Group=_wl-webproxy-demo
Environment="HOME=/var/lib/workloads/webproxy-demo"
Environment=DISABLE_HC_SYSTEMD=true
EnvironmentFile=-/run/workload-env/workload-webproxy-demo.env

# Resource limits and constraints
MemoryMax=128M
MemoryHigh=96M


# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-webproxy-demo-proxy" --hostname "webproxy-demo" --rm --replace --init --sdnotify=ignore --pull=missing --log-driver=journald --cgroups=split --userns=keep-id --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="workload-webproxy-demo-net" --network-alias="proxy" --publish 8888:8080 --env HOST_IP=${HOST_IP} --health-cmd "wget -qO- http://localhost:8080/ > /dev/null || exit 1" --health-interval=30s --health-start-period=10s --health-on-failure=none "docker.io/library/caddy:2-alpine" "caddy" "reverse-proxy" "--from" ":8080" "--to" "http://app:8080"

ExecStop=/usr/bin/podman stop -t 10 "workload-webproxy-demo-proxy"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/webproxy-demo" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30
