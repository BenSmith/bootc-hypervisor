# Rootless workload service for desktop-kdeplasma-rdp
# Generated by workload-generate

[Unit]
Description=desktop-kdeplasma-rdp rootless workload
Requires=workload-desktop-kdeplasma-rdp-setup.service
After=network.target workload-desktop-kdeplasma-rdp-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
KillSignal=SIGRTMIN+3
User=_wl-desktop-kdeplasma-rdp
Group=_wl-desktop-kdeplasma-rdp
Environment="HOME=/var/lib/workloads/desktop-kdeplasma-rdp"
EnvironmentFile=-/run/workload-env/workload-desktop-kdeplasma-rdp.env

# Resource limits and constraints
CPUQuota=600%
MemoryMax=16G
MemoryHigh=12G
TasksMax=16384


# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-desktop-kdeplasma-rdp" --hostname "desktop-kdeplasma-rdp" --rm --systemd=always --sdnotify=ignore --pull=never --log-driver=journald --uidmap +1000:@__UID__:1 --gidmap +1000:@__UID__:1 --gidmap +63:@63:1 --gidmap +105:@105:1 --gidmap +39:@39:1 --uidmap +0:@__UID__:1 --gidmap +0:@__UID__:1 --cap-add=CHOWN --cap-add=DAC_OVERRIDE --cap-add=FOWNER --cap-add=SETUID --cap-add=SETGID --cap-add=FSETID --cap-add=KILL --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --shm-size=2G --pids-limit=16384 --network="host" --volume "/var/lib/workloads/desktop-kdeplasma-rdp/home":/home/desktop --volume "/run/udev":/run/udev:ro --volume "/run/systemd/journal/socket":/run/host-systemd/journal/socket --env HOST_IP=${HOST_IP} --env CONTAINER_USER=desktop --env CONTAINER_UID=1000 --env CONTAINER_GID=1000 --env LANG=C.UTF-8 --env KRDP_PASSWORD=changeme --health-cmd "pgrep -x kwin_wayland > /dev/null || exit 1" --health-interval=30s --health-start-period=90s --health-on-failure=kill "localhost/desktop-kdeplasma-rdp:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-desktop-kdeplasma-rdp"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/desktop-kdeplasma-rdp" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
