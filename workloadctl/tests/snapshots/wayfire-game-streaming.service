# Rootless workload service for wayfire-game-streaming
# Generated by workload-generate

[Unit]
Description=wayfire-game-streaming rootless workload
Requires=workload-wayfire-game-streaming-setup.service
After=network.target workload-wayfire-game-streaming-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=nvidia-cdi-generator.service
After=nvidia-cdi-generator.service

[Service]
Type=exec
Slice=workloads.slice
KillSignal=SIGRTMIN+3
User=_wl-wayfire-game-streaming
Group=_wl-wayfire-game-streaming
Environment="HOME=/var/lib/workloads/wayfire-game-streaming/state"
EnvironmentFile=-/run/workload-env/workload-wayfire-game-streaming.env

# Service-level overrides
LimitNICE=40
LimitRTPRIO=20

ExecStartPre=/bin/bash -c 'test -s /run/cdi/nvidia.yaml || { echo "NVIDIA CDI spec missing: check nvidia-cdi-generator.service" >&2; exit 1; }'
ExecStartPre=-/usr/bin/podman system migrate

# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-wayfire-game-streaming" --hostname "wayfire-game-streaming" --rm --replace --systemd=always --sdnotify=ignore --pull=never --log-driver=passthrough --uidmap +1000:@__UID__:1 --gidmap +1000:@__UID__:1 --gidmap +39:@39:1 --gidmap +105:@105:1 --gidmap +104:@104:1 --gidmap +63:@63:1 --uidmap +0:@__UID__:1 --gidmap +0:@__UID__:1 --cap-add=CHOWN --cap-add=DAC_OVERRIDE --cap-add=FOWNER --cap-add=SETUID --cap-add=SETGID --cap-add=FSETID --cap-add=KILL --cap-add=NET_BIND_SERVICE --cap-add=SETFCAP --cap-add=SETPCAP --cap-add=SYS_CHROOT --cap-add=SYS_NICE --security-opt=label=type:wl_wayfire_game_streaming.process --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device=nvidia.com/gpu=all --device /dev/dri --device /dev/uinput --device /dev/snd --shm-size=2g --pids-limit=16384 --memory=8G --cpus=4.0 --network="host" --volume "/var/lib/workloads/wayfire-game-streaming/data/home":/home/desktop --volume "/var/lib/workloads/wayfire-game-streaming/data/tls":/etc/sunshine/tls:ro --volume "/run/systemd/journal/socket":/run/host-systemd/journal/socket --volume "/run/udev":/run/udev:ro --volume "/dev/input":/dev/input --env HOST_IP=${HOST_IP} --env CONTAINER_USER=desktop --env CONTAINER_UID=1000 --env CONTAINER_GID=1000 --env DESKTOP_RESOLUTION=1920x1080 --health-cmd "pgrep -x sunshine > /dev/null || exit 1" --health-interval=30s --health-start-period=30s --health-on-failure=kill "localhost/wayfire-game-streaming:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-wayfire-game-streaming"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-wayfire-game-streaming"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-wayfire-game-streaming
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/wayfire-game-streaming" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
