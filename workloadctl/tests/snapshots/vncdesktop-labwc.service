# Rootless workload service for vncdesktop-labwc
# Generated by workload-generate

[Unit]
Description=vncdesktop-labwc rootless workload
Requires=workload-vncdesktop-labwc-setup.service
After=network.target workload-vncdesktop-labwc-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=nvidia-cdi-generator.service
After=nvidia-cdi-generator.service

[Service]
Type=exec
Slice=workloads.slice
User=_wl-vncdesktop-labwc
Group=_wl-vncdesktop-labwc
Environment="HOME=/var/lib/workloads/vncdesktop-labwc/state"
EnvironmentFile=-/run/workload-env/workload-vncdesktop-labwc.env

ExecStartPre=/bin/bash -c 'test -s /run/cdi/nvidia.yaml || { echo "NVIDIA CDI spec missing: check nvidia-cdi-generator.service" >&2; exit 1; }'
ExecStartPre=-/usr/bin/podman system migrate
ExecStartPre=-/usr/bin/rm -f /run/user/__UID__/libpod/tmp/pause.pid /run/user/__UID__/libpod/tmp/ns_handles

# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-vncdesktop-labwc" --hostname "vncdesktop-labwc" --rm --replace --init --sdnotify=ignore --pull=never --log-driver=passthrough --uidmap +1000:@__UID__:1 --gidmap +1000:@__UID__:1 --gidmap +39:@39:1 --gidmap +105:@105:1 --security-opt=label=type:wl_vncdesktop_labwc.process --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device=nvidia.com/gpu=all --device /dev/dri --shm-size=2G --pids-limit=16384 --memory=4G --cpus=2.0 --network="host" --volume "/var/lib/workloads/vncdesktop-labwc/data/home":/home/desktop --env HOST_IP=${HOST_IP} --env LANG=C.UTF-8 --env NO_AT_BRIDGE=1 --health-cmd "pgrep -x wayvnc > /dev/null || exit 1" --health-interval=30s --health-start-period=15s --health-on-failure=kill "localhost/vncdesktop-labwc:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-vncdesktop-labwc"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-vncdesktop-labwc"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-vncdesktop-labwc
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/vncdesktop-labwc" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
