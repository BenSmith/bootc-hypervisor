# Rootless workload service for dns-vpn
# Generated by workload-generate

[Unit]
Description=dns-vpn rootless workload
Requires=workload-dns-vpn-setup.service
After=network.target workload-dns-vpn-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-dns-vpn
Group=_wl-dns-vpn
Environment="HOME=/var/lib/workloads/dns-vpn/state"
EnvironmentFile=-/run/workload-env/workload-dns-vpn.env

ExecStartPre=-/usr/bin/podman system migrate
ExecStartPre=-/usr/bin/rm -f /run/user/__UID__/libpod/tmp/pause.pid /run/user/__UID__/libpod/tmp/ns_handles

# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-dns-vpn" --hostname "dns-vpn" --rm --replace --init --sdnotify=ignore --pull=missing --log-driver=passthrough --userns=keep-id:uid=0,gid=0 --cap-add=NET_ADMIN --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --memory=64M --cpus=0.1 --network="pasta" --publish 53:53/udp --publish 53:53/tcp --volume "/var/lib/workloads/dns-vpn/data/wg0.conf":"/etc/wireguard/wg0.conf":"ro" --env HOST_IP=${HOST_IP} --env WG_INTERFACE="wg0" --env DNS_PORT="53" --health-cmd "wg show wg0 > /dev/null 2>&1 || exit 1" --health-interval=30s --health-start-period=15s --health-on-failure=kill "registry.local/workloads/dns-vpn:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-dns-vpn"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-dns-vpn"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-dns-vpn
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/dns-vpn" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
