# Rootless workload service for dns-vpn
# Generated by workload-generate

[Unit]
Description=dns-vpn rootless workload
Requires=workload-dns-vpn-setup.service
After=network.target workload-dns-vpn-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Wants=workload-dns-vpn-health.timer

[Service]
Type=exec
Slice=workloads.slice
Delegate=yes
User=_wl-dns-vpn
Group=_wl-dns-vpn
Environment="HOME=/var/lib/workloads/dns-vpn"
Environment=DISABLE_HC_SYSTEMD=true
EnvironmentFile=-/run/workload-env/workload-dns-vpn.env

# Resource limits and constraints
CPUQuota=10%
MemoryMax=64M
MemoryHigh=48M


# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-dns-vpn" --hostname "dns-vpn" --rm --init --sdnotify=ignore --pull=never --log-driver=journald --cgroups=split --userns=host --cap-add=NET_ADMIN --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="pasta" --publish 53:53/udp --publish 53:53/tcp --volume "/var/lib/workloads/dns-vpn/wg0.conf":/etc/wireguard/wg0.conf:ro --env HOST_IP=${HOST_IP} --env WG_INTERFACE=wg0 --env DNS_PORT=53 --health-cmd "wg show wg0 > /dev/null 2>&1 || exit 1" --health-interval=30s --health-start-period=15s --health-on-failure=none "localhost/dns-vpn:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-dns-vpn"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/dns-vpn" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
