# Rootless workload service for smb-server
# Generated by workload-generate

[Unit]
Description=smb-server rootless workload
Requires=workload-smb-server-setup.service
After=network.target workload-smb-server-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-smb-server
Group=_wl-smb-server
Environment="HOME=/var/lib/workloads/smb-server"
EnvironmentFile=-/run/workload-env/workload-smb-server.env

# Resource limits and constraints
CPUQuota=50%
MemoryMax=512M
MemoryHigh=384M


# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-smb-server" --hostname "smb-server" --rm --init --sdnotify=ignore --pull=never --log-driver=journald --userns=keep-id --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="host" --volume "/var/lib/workloads/smb-server/exports":/exports --volume "/var/lib/workloads/smb-server/samba-state":/var/lib/samba --volume "/var/lib/workloads/smb-server/samba-run":/run/samba --volume "/var/lib/workloads/smb-server/samba-logs":/var/log/samba --volume "/var/lib/workloads/smb-server/smb.conf":/etc/samba/smb.conf:ro --volume "/run/systemd/journal/socket":/run/systemd/journal/socket --env HOST_IP=${HOST_IP} --health-cmd "bash -c 'exec 3<>/dev/tcp/127.0.0.1/445'" --health-interval=30s --health-start-period=10s --health-on-failure=kill "localhost/smb-server:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-smb-server"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/smb-server" /run/user/__UID__
PrivateTmp=yes
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
