# Rootless workload service for otel-lgtm
# Generated by workload-generate

[Unit]
Description=otel-lgtm rootless workload
Requires=workload-otel-lgtm-setup.service
After=network.target workload-otel-lgtm-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-otel-lgtm
Group=_wl-otel-lgtm
Environment="HOME=/var/lib/workloads/otel-lgtm/state"
EnvironmentFile=-/run/workload-env/workload-otel-lgtm.env

# Load encrypted credentials (auto-decrypted to /run/credentials/{service}/)
LoadCredentialEncrypted=grafana-admin-password:/etc/credstore.encrypted/grafana-admin-password

ExecStartPre=+/usr/libexec/workloadctl/workload-write-env otel-lgtm
ExecStartPre=-/usr/bin/podman system migrate
ExecStartPre=-/usr/bin/rm -f /run/user/__UID__/libpod/tmp/pause.pid /run/user/__UID__/libpod/tmp/ns_handles

# Image pulling handled by podman run --pull=newer

ExecStart=/usr/bin/podman run --name "workload-otel-lgtm" --hostname "otel-lgtm" --rm --replace --init --sdnotify=ignore --pull=newer --log-driver=passthrough --userns=keep-id --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --memory=4G --cpus=2.0 --network="pasta" --publish 3000:3000 --publish 4317:4317 --publish 4318:4318 --publish 127.0.0.1:9090:9090 --publish 127.0.0.1:4040:4040 --volume "/var/lib/workloads/otel-lgtm/data/lgtm":/data --volume "/var/lib/workloads/otel-lgtm/data/lgtm-etc":/etc/lgtm --env HOST_IP=${HOST_IP} --env GF_SECURITY_ADMIN_USER=admin --env GF_USERS_ALLOW_SIGN_UP=false --env GF_ANALYTICS_REPORTING_ENABLED=false --env GF_ANALYTICS_CHECK_FOR_UPDATES=false --env PROMETHEUS_RETENTION_TIME=30d --env PROMETHEUS_RETENTION_SIZE=10GB --env-file "/run/workload-env/workload-otel-lgtm.secrets" --health-cmd "bash -c 'exec 3<>/dev/tcp/localhost/3000 && exec 4<>/dev/tcp/localhost/4317' || exit 1" --health-interval=30s --health-start-period=180s --health-on-failure=kill "docker.io/grafana/otel-lgtm:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-otel-lgtm"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-otel-lgtm"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-otel-lgtm
LogRateLimitIntervalSec=30
LogRateLimitBurst=250

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/otel-lgtm" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
