# Rootless workload service for avahi
# Generated by workload-generate

[Unit]
Description=avahi rootless workload
Requires=workload-avahi-setup.service
After=network.target workload-avahi-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5
Wants=workload-avahi-health.timer

[Service]
Type=simple
Slice=workloads.slice
Delegate=yes
User=_wl-avahi
Group=_wl-avahi
Environment="HOME=/var/lib/workloads/avahi"
Environment=DISABLE_HC_SYSTEMD=true
EnvironmentFile=-/run/workload-env/workload-avahi.env

# Resource limits and constraints
CPUQuota=50%
MemoryMax=64M
MemoryHigh=32M


# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-avahi" --hostname "avahi" --rm --replace --init --sdnotify=ignore --pull=never --log-driver=journald --cgroups=split --userns=keep-id:uid=0,gid=0 --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="host" --env HOST_IP=${HOST_IP} --env ALIASES='zot registry' --health-cmd "avahi-daemon --check" --health-interval=60s --health-timeout=35s --health-retries=3 --health-start-period=10s --health-on-failure=none "localhost/avahi:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-avahi"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/avahi" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
