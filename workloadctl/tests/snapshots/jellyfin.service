# Rootless workload service for jellyfin
# Generated by workload-generate

[Unit]
Description=jellyfin rootless workload
Requires=workload-jellyfin-setup.service
After=network.target workload-jellyfin-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-jellyfin
Group=_wl-jellyfin
Environment="HOME=/var/lib/workloads/jellyfin"
EnvironmentFile=-/run/workload-env/workload-jellyfin.env

ExecStartPre=-/usr/bin/podman system migrate

# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-jellyfin" --hostname "jellyfin" --rm --replace --init --sdnotify=ignore --pull=missing --log-driver=passthrough --uidmap +0:@__UID__:1 --gidmap +0:@__UID__:1 --gidmap +105:@105:1 --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device /dev/dri/renderD128 --shm-size=256m --memory=4G --network="pasta" --publish 8096:8096 --volume "/var/lib/workloads/jellyfin/config":/config --volume "/var/lib/workloads/jellyfin/cache":/cache --volume "/var/lib/workloads/jellyfin/media":/media:ro --env HOST_IP=${HOST_IP} --health-cmd "bash -c 'exec 3<>/dev/tcp/127.0.0.1/8096'" --health-interval=30s --health-start-period=30s --health-on-failure=kill "docker.io/jellyfin/jellyfin:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-jellyfin"
ExecStopPost=-/usr/bin/podman rm -f -t0 "workload-jellyfin"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=workload-jellyfin

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/jellyfin" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
