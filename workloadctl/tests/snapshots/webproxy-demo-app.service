# Container service for webproxy-demo/app
# Generated by workload-generate

[Unit]
Description=webproxy-demo/app container
Requires=workload-webproxy-demo-net.service
After=workload-webproxy-demo-net.service
BindsTo=workload-webproxy-demo-net.service
PartOf=workload-webproxy-demo.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-webproxy-demo
Group=_wl-webproxy-demo
Environment="HOME=/var/lib/workloads/webproxy-demo"
EnvironmentFile=-/run/workload-env/workload-webproxy-demo.env

# Resource limits and constraints
MemoryMax=64M
MemoryHigh=48M


# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-webproxy-demo-app" --hostname "webproxy-demo" --rm --init --sdnotify=ignore --pull=missing --log-driver=journald --userns=keep-id --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="workload-webproxy-demo-net" --network-alias="app" --env HOST_IP=${HOST_IP} --health-cmd "wget -qO- http://localhost:8080/ > /dev/null || exit 1" --health-interval=30s --health-start-period=10s --health-on-failure=kill "docker.io/traefik/whoami:latest" "--port" "8080"

ExecStop=/usr/bin/podman stop -t 10 "workload-webproxy-demo-app"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/webproxy-demo" /run/user/__UID__
PrivateTmp=yes
TimeoutStartSec=300
TimeoutStopSec=30
