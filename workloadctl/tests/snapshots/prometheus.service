# Rootless workload service for prometheus
# Generated by workload-generate

[Unit]
Description=prometheus rootless workload
Requires=workload-prometheus-setup.service
After=network.target workload-prometheus-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-prometheus
Group=_wl-prometheus
Environment="HOME=/var/lib/workloads/prometheus"
EnvironmentFile=-/run/workload-env/workload-prometheus.env

# Resource limits and constraints
CPUQuota=20%
MemoryMax=128M
MemoryHigh=96M
MemorySwapMax=0


# Image pulling handled by podman run --pull=missing

ExecStart=/usr/bin/podman run --name "workload-prometheus" --rm --init --sdnotify=ignore --pull=missing --log-driver=journald --userns=keep-id --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="pasta" --publish 9100:9100 --volume "/":/host:ro,rslave --volume "/proc":/host/proc:ro,rslave --volume "/sys":/host/sys:ro,rslave --volume "/var/lib/prometheus/node-exporter":/textfile:ro --health-cmd "wget -qO- http://localhost:9100/metrics > /dev/null || exit 1" --health-interval=30s --health-start-period=10s --health-on-failure=kill "quay.io/prometheus/node-exporter:latest" "--path.rootfs=/host" "--path.procfs=/host/proc" "--path.sysfs=/host/sys" "--collector.textfile.directory=/textfile"

ExecStop=/usr/bin/podman stop -t 10 "workload-prometheus"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/prometheus" /run/user/10012
PrivateTmp=yes
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
