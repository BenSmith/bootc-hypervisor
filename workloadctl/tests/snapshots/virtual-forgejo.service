# VM workload service for virtual-forgejo
# Generated by workload-generate

[Unit]
Description=virtual-forgejo VM workload
Requires=workload-virtual-forgejo-setup.service workload-virtual-forgejo-build.service workload-bridge.service
After=workload-virtual-forgejo-setup.service workload-virtual-forgejo-build.service workload-bridge.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=all
Slice=workloads.slice
User=_wl-virtual-forgejo
Group=_wl-virtual-forgejo
Environment="HOME=/var/lib/workloads/virtual-forgejo"
EnvironmentFile=-/run/workload-env/workload-virtual-forgejo.env
RuntimeDirectory=workload-vm/virtual-forgejo
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

ExecStart=/usr/libexec/workloadctl/workload-vm-notify "virtual-forgejo" \
    /usr/bin/qemu-system-x86_64 \
        -machine q35,accel=kvm \
        -cpu host \
        -m 6144 \
        -smp 4 \
        -drive if=pflash,format=raw,readonly=on,file=/usr/share/edk2/ovmf/OVMF_CODE.fd \
        -drive if=pflash,format=raw,file=/var/lib/workloads/virtual-forgejo/nvram.fd \
        -drive file=/var/lib/workloads/virtual-forgejo/system.qcow2,if=virtio,format=qcow2,id=system \
        -drive file=/var/lib/workloads/virtual-forgejo/data.qcow2,if=virtio,format=qcow2,id=data \
        -drive file=/var/lib/workloads/virtual-forgejo/cloud-init.iso,if=virtio,format=raw,readonly=on,media=cdrom,id=cloudinit \
        -netdev bridge,id=net0,br=_workload-br \
        -device virtio-net-pci,netdev=net0,mac=0e:d1:bb:0c:8a:39 \
        -device virtio-balloon-pci \
        -serial unix:/run/workload-vm/virtual-forgejo/console.sock,server=on,wait=off \
        -qmp unix:/run/workload-vm/virtual-forgejo/qmp.sock,server=on,wait=off \
        -qmp unix:/run/workload-vm/virtual-forgejo/qmp-metrics.sock,server=on,wait=off \
        -nographic \
        -no-reboot \
        -name virtual-forgejo

ExecStop=/usr/libexec/workloadctl/workload-vm-shutdown "virtual-forgejo"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=10s
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
