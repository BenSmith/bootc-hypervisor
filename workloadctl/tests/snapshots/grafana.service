# Rootless workload service for grafana
# Generated by workload-generate

[Unit]
Description=grafana rootless workload
Requires=workload-grafana-setup.service
After=network.target workload-grafana-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
User=_wl-grafana
Group=_wl-grafana
Environment="HOME=/var/lib/workloads/grafana"
EnvironmentFile=-/run/workload-env/workload-grafana.env

# Resource limits and constraints
CPUQuota=100%
MemoryMax=512M
MemoryHigh=384M


# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-grafana" --rm --init --sdnotify=ignore --pull=never --log-driver=journald --userns=keep-id --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --network="host" --volume "/var/lib/workloads/grafana/grafana.ini":/etc/grafana/grafana.ini:ro --volume "/var/lib/workloads/grafana/data":/usr/share/grafana/data --env GF_SECURITY_ADMIN_USER=admin --env GF_SECURITY_ADMIN_PASSWORD=admin --env GF_USERS_ALLOW_SIGN_UP=false --env GF_LOG_MODE=console --health-cmd "wget -qO- http://localhost:3000/api/health > /dev/null || exit 1" --health-interval=30s --health-start-period=30s --health-on-failure=kill "localhost/grafana:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-grafana"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/grafana" /run/user/10016
PrivateTmp=yes
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
