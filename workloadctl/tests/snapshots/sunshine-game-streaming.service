# Rootless workload service for sunshine-game-streaming
# Generated by workload-generate

[Unit]
Description=sunshine-game-streaming rootless workload
Requires=workload-sunshine-game-streaming-setup.service
After=network.target workload-sunshine-game-streaming-setup.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Slice=workloads.slice
KillSignal=SIGRTMIN+3
User=_wl-sunshine-game-streaming
Group=_wl-sunshine-game-streaming
Environment="HOME=/var/lib/workloads/sunshine-game-streaming"
EnvironmentFile=-/run/workload-env/workload-sunshine-game-streaming.env

# Resource limits and constraints
CPUQuota=400%
MemoryMax=8G
MemoryHigh=6G
TasksMax=16384


# Image pulling handled by podman run --pull=never

ExecStart=/usr/bin/podman run --name "workload-sunshine-game-streaming" --hostname "sunshine-game-streaming" --rm --systemd=always --sdnotify=ignore --pull=never --log-driver=journald --uidmap +__UID__:@__UID__:1 --gidmap +__UID__:@__UID__:1 --gidmap +39:@39:1 --gidmap +105:@105:1 --gidmap +104:@104:1 --gidmap +63:@63:1 --cap-add=CHOWN --cap-add=DAC_OVERRIDE --cap-add=FOWNER --cap-add=SETUID --cap-add=SETGID --cap-add=FSETID --cap-add=KILL --cap-add=NET_BIND_SERVICE --cap-add=SETFCAP --cap-add=SETPCAP --cap-add=SYS_CHROOT --cap-add=SYS_NICE --security-opt=seccomp=/usr/share/containers/seccomp-workload-baseline.json --group-add=keep-groups --device /dev/uinput --device /dev/snd --shm-size=2g --pids-limit=16384 --network="host" --volume "/var/lib/workloads/sunshine-game-streaming/home":/home/desktop --volume "/run/systemd/journal/socket":/run/host-systemd/journal/socket --volume "/run/udev":/run/udev:ro --volume "/dev/input":/dev/input --env HOST_IP=${HOST_IP} --env CONTAINER_USER=desktop --env CONTAINER_UID=1000 --env CONTAINER_GID=1000 --env DESKTOP_RESOLUTION=1920x1080 --health-cmd "pgrep -x sunshine > /dev/null || exit 1" --health-interval=30s --health-start-period=30s --health-on-failure=kill "localhost/sunshine-game-streaming:latest"

ExecStop=/usr/bin/podman stop -t 10 "workload-sunshine-game-streaming"

StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

# Filesystem hardening: restrict writes to workload home + podman runtime
ProtectSystem=strict
ReadWritePaths="/var/lib/workloads/sunshine-game-streaming" /run/user/__UID__
PrivateTmp=yes
# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and
# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list
# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.
RestrictAddressFamilies=~AF_ALG AF_PACKET
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
