#!/usr/sbin/nft -f
#
# workload_filter — per-VM egress policy keyed on the workload uid (ADR 006).
#
# passt terminates the guest network stack and re-originates every flow as a
# host socket owned by the workload's own user, so `meta skuid` is a complete,
# unforgeable per-VM selector. This file is the always-on skeleton; units add
# and remove *set elements*, never rules.
#
# Applied by each VM unit's ExecStartPre. It must therefore be idempotent
# under concurrent application, which is why it is written the way it is:
#
#   - `add table`, `add chain` and `add set` create-if-absent, so re-applying
#     is a no-op for them.
#   - `add rule` APPENDS. Applying this file twice without the flush would
#     duplicate every rule. `flush chain` empties only the chain; set elements
#     live on the table and survive, so a second VM starting does not disarm
#     the first.
#   - each `nft -f` is one atomic transaction, so concurrent VM starts cannot
#     interleave into a half-built chain.
#
# Placement: firewalld runs filter_OUTPUT at filter+10, so this chain at
# priority 0 evaluates first. firewalld leaves that headroom deliberately.
# firewalld cannot express this policy itself -- its rich language has no uid
# predicate, so it can reach the traffic class but cannot tell one VM from
# another.
#
# Break-glass:  nft delete table inet workload_filter
# An abandoned table is inert: chain policy is accept, the drop is set-guarded,
# and an empty wl_filtered matches nothing. Orphaned elements self-heal on
# reboot, since nft state does not survive one.

add table inet workload_filter

# Membership: "is this workload under policy at all?" -- family-agnostic, so
# one set serves both the mark and the drop.
add set inet workload_filter wl_filtered { typeof meta skuid ; }

# Allowlists. In the inet family `ip daddr` matches v4 only and `ip6 daddr` v6
# only, so an allowlist spanning both families needs one set per family.
# Neither accept rule can fire on the other family's traffic and no explicit
# `meta nfproto` guard is needed -- the dependency is implicit in the match.
add set inet workload_filter wl_allow4 { typeof meta skuid . ip daddr . th dport ; }
add set inet workload_filter wl_allow6 { typeof meta skuid . ip6 daddr . th dport ; }

# The hostname-policy proxies, by control group (ADR 006 §4.4). Each proxy runs
# as its workload's own user *on purpose*, so `meta skuid` cannot tell the
# proxy's traffic from the guest's — and under default-deny that means the drop
# below catches the proxy too, leaving hostname policy permitting nothing at
# all. Observed on a live VM: the guest's CONNECT reaches the proxy, the proxy
# resolves the host, and its outbound SYN is dropped.
#
# The control group is the discriminator that survives the shared uid. It is
# assigned by systemd, is not something a guest can enter or forge, and is
# exact — no destination or port is widened, so a guest that ignores the proxy
# and dials 443 directly is still dropped, which is what makes the proxy
# mandatory rather than advisory.
#
# Widening by port instead — "let this uid reach 443 anywhere" — was the
# obvious alternative and is fatal: it is precisely the bypass the default-deny
# chain exists to close.
add set inet workload_filter wl_proxy_cg { typeof socket cgroupv2 level 2 ; }

add chain inet workload_filter output { type filter hook output priority 0; policy accept; }
flush chain inet workload_filter output

# Non-terminating, and NOT policy: this is what lets a capture attribute
# *inbound* packets to a workload, since nftables has no input-side uid match.
# It lives in the always-on skeleton rather than being installed when a capture
# starts, because a rule added later can only mark connections opened later --
# and the connection an operator is chasing is already established by the time
# they come looking.
#
# Guarded on the workload uid RANGE, not on @wl_filtered. Attribution is not
# policy: a container and an `egress = "open"` VM are exactly as interesting to
# capture as a filtered one, and keying this on set membership made
# `pcap -Q in` silently empty for every workload that is not filtered -- while
# `-Q out` worked, so each workload class had one working direction and no
# error. The range is the whole of what UID_MIN..UID_MAX in lib/workload_lib.py
# allocates; tests/test_pcap.py asserts the two agree rather than trusting it.
#
# This ASSIGNS the mark, and it claims the whole of it: the 0x40000000 tag plus
# a uid of up to 52948 spend all 32 bits, so there is nowhere for another
# component's mark to live alongside ours. On a host that marks connections for
# its own policy routing, any mark set on a workload's connections is replaced
# here. Nothing in this project sets one, and the only way to keep one would be
# to give up either the tag or the uid -- which is to say, the attribution. A
# site that needs the mark for something else wants the break-glass at the top
# of this file.
add rule inet workload_filter output meta skuid 10000-52948 ct mark set meta skuid or 0x40000000

# Loopback is the workload's own control plane, not egress. Without this a
# filtered VM is cut off from the host in two ways that both look like bugs
# elsewhere (both observed on a live VM before this rule existed):
#
#   - `workloadctl exec` / `shell` hang. passt binds the management address
#     127.128.x.y:2222 as the workload user, so the *replies* on that socket
#     are output traffic owned by the workload uid and hit this chain. The
#     connection is accepted and then silently dies.
#   - DNS stops resolving whenever the host runs a stub resolver. passt sends
#     the forwarded query to `dns-host` — 127.0.0.53 on a systemd-resolved
#     host — again as the workload uid.
#
# Accepting it does not widen what the guest can reach. passt is run with
# `--map-host-loopback none`, so no guest-chosen destination translates to
# host loopback; the only loopback traffic passt originates is replies on
# sockets it already bound and the DNS forward. A guest packet aimed at
# 127.0.0.1 never leaves the guest's own stack.
add rule inet workload_filter output meta skuid @wl_filtered oif lo counter accept

# The proxy's own egress. `level 2` is exact because the proxy unit pins
# Slice=workloads.slice, making its cgroup path always
# workloads.slice/workload-<name>-proxy.service — two components, whatever the
# workload's [resources].slice says. An element resolves to a cgroup id at add
# time and systemd creates a fresh cgroup on each start, so the proxy's own
# ExecStartPre adds the current one and its ExecStopPost removes it — the only
# point at which a path still resolves to the id being retired.
add rule inet workload_filter output socket cgroupv2 level 2 @wl_proxy_cg counter accept

add rule inet workload_filter output meta skuid . ip daddr . th dport @wl_allow4 counter accept
add rule inet workload_filter output meta skuid . ip6 daddr . th dport @wl_allow6 counter accept

# Set-guarded: a workload not in wl_filtered never reaches this rule.
#
# The counter is HOST-WIDE, not per-workload. One rule guarded on set membership
# serves every filtered VM, so they all accumulate on the same number. Getting
# per-workload counts would take a rule or a named counter per uid, which is
# exactly the machinery a single set-guarded rule was chosen to avoid — so
# `diagnose` reports the figure and says it is shared, because attributing a
# sibling's dropped traffic to the workload being diagnosed would send an
# operator after the wrong VM.
add rule inet workload_filter output meta skuid @wl_filtered counter drop
