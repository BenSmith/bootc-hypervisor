#!/usr/sbin/nft -f
#
# workload_broker — the uid-keyed redirect to a host-side credential broker.
#
# Same mechanism as workload-proxy.nft and for the same reason: every guest is
# handed one advertised endpoint it could not otherwise reach, and the kernel
# rewrites that destination per uid before the packet reaches anything. Under
# passt the uid on the socket is the workload's own, so the guest cannot name
# another workload's broker or forge its way into one.
#
# WHY THIS IS A SECOND TABLE AND NOT A SECOND RULE IN workload_proxy
#
# The two are reached by different workloads. The hostname-policy proxy exists
# only where `hosts` is non-empty; the broker only where `broker` is set. Each
# skeleton is applied by the unit that owns its elements, so folding them into
# one table would mean a workload with a broker and no proxy depends on a file
# the proxy unit applies — and that unit does not exist for it. Separate tables
# keep each concern's break-glass independent too.
#
# WHY A MAP AND NOT A SET WITH A FIXED DESTINATION
#
# There is one broker today and every element carries the same value, so a set
# of entitled uids plus a constant `dnat to` would express what is deployed. The
# map costs nothing extra and keeps per-workload broker instances available
# without an nft change — which is the right shape once sandboxes hold
# *different* credentials, since one shared process then holds all of them and a
# single bug leaks the set rather than one member of it.
#
# Membership is entitlement: a uid absent from the map gets no translation, and
# nothing listens at the advertised address, so its connection is refused rather
# than denied by a rule that could be misconfigured.
#
# Same idempotency contract as the other two skeletons: units add and remove map
# *elements*, never rules, `add` is create-if-absent, the `flush chain` stops a
# re-apply from duplicating the rule, and one `nft -f` is one atomic transaction
# so concurrent VM starts cannot interleave.
#
# Break-glass:  nft delete table inet workload_broker
# An abandoned table is inert: with an empty map the rule matches no uid and the
# chain policy is accept. Orphaned elements self-heal on reboot.

add table inet workload_broker

# uid -> (where that workload's broker actually listens).
add map inet workload_broker wl_broker_dest { type uid : ipv4_addr . inet_service ; }

add chain inet workload_broker broker_dnat { type nat hook output priority dstnat; policy accept; }
flush chain inet workload_broker broker_dnat

# No `meta skuid` predicate of its own: the map lookup IS the predicate, exactly
# as in workload-proxy.nft.
#
# The advertised address is shared with the proxy and the port distinguishes the
# two, so this needs no second dummy link and no second host address. It must
# agree with VM_PROXY_ADDR / VM_BROKER_PORT in lib/vm.py; tests/test_vm_broker.py
# asserts that rather than trusting it.
#
# Note for anyone debugging the far end: a connection translated here is still
# recorded by the CLIENT under the address it dialled, so a host service that
# identifies callers by matching socket tables has to look for the advertised
# endpoint, not the one it is bound to. Measured, and it is why the broker reads
# SO_ORIGINAL_DST.
add rule inet workload_broker broker_dnat ip daddr 192.0.2.1 tcp dport 8081 counter dnat ip to meta skuid map @wl_broker_dest
