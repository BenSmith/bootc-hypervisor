#!/bin/bash
# Minimal shell generator that creates a oneshot service to run the real
# (Python) workload generator. This avoids the systemd 258 generator
# sandbox timeout (systemd/systemd#39354) that freezes PID 1 when a
# generator takes too long (Python import overhead in nested/slow VMs).
#
# The generated oneshot service runs after sysinit (so /etc is writable)
# but before multi-user.target (so workload services can start).

set -eu

NORMAL_DIR="${1:-/tmp}"

cat > "${NORMAL_DIR}/workload-generate.service" <<'UNIT'
[Unit]
Description=Generate workload service files
DefaultDependencies=no
After=sysinit.target
Before=basic.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/workloadctl/workload-generate /run/systemd/system
ExecStartPost=-/usr/bin/systemctl daemon-reload
UNIT

mkdir -p "${NORMAL_DIR}/basic.target.wants"
ln -sf ../workload-generate.service "${NORMAL_DIR}/basic.target.wants/workload-generate.service"
