#!/usr/bin/python3
"""
Workload service file generator for dynamic rootless workload provisioning.
Called by workload-generate.service (a oneshot that runs early in boot).

Reads workload configs from /etc/workloads.d/*.toml and generates:
- systemd-sysusers configs for user creation
- systemd service files for rootless podman execution

NOT a systemd generator — runs as a regular early-boot oneshot service.
Generators are expected to be fast and minimal (see systemd.generator(7));
this script does nontrivial work (TOML parsing, validation, unit file
emission) that does not fit that contract. Python import overhead alone
can exceed the execution budget systemd 258+ enforces on generators
(discussed in systemd/systemd#39354). The tiny shell generator
`workload-generator` emits a oneshot service (workload-generate.service)
that calls this script during early boot.

Read-only: does not create users or access /var.
User creation deferred to ExecStartPre (systemd-sysusers + workload-ensure-user).
UID-dependent values deferred to EnvironmentFile written by workload-ensure-user.
"""

# Early logging before any imports
def _early_log(msg):
    """Log to kmsg before imports complete"""
    try:
        with open("/dev/kmsg", "w") as kmsg:
            kmsg.write(f"<6>workload-generate[EARLY]: {msg}\n")
    except OSError:
        pass  # Silently fail if kmsg unavailable

_early_log("Generator invoked")

import sys  # noqa: E402 - Early logging before imports is intentional
# Disable bytecode generation - /usr may be read-only (bootc, ostree, immutable systems)
sys.dont_write_bytecode = True

_early_log("Python imports starting")

try:
    import os

    # Prevent nss-systemd from contacting systemd-userdbd via D-Bus.
    # This script runs very early in boot (before basic.target), before
    # systemd-userdbd is up. Without this bypass, pwd.getpwnam() goes
    # through nss-systemd and blocks for ~45 seconds waiting for userdbd
    # that will never answer, which in turn delays the rest of boot until
    # this oneshot completes. The bypass skips the D-Bus call entirely
    # and resolves from /etc/passwd directly, which is what we want here.
    os.environ['SYSTEMD_NSS_BYPASS_BUS'] = '1'

    import tomllib
    import traceback
    import shlex
    import pwd
    import grp
    import re
    from pathlib import Path

    # --- workloadctl lib bootstrap -----------------------------------------
    # Keep this block byte-identical across bin/workloadctl, generators/
    # workload-generate, and libexec/workload-{ensure-user,write-env,exporter}.
    # Locates workload_lib.py (and its sibling podman.py) in: this script's
    # own dir (installed libexec scripts), <repo>/lib (dev checkout), or
    # /usr/libexec/workloadctl (installed /usr/bin entrypoint). First match
    # wins; insert(0) keeps it ahead of any PyPI package of the same name.
    # True centralization needs a packaging change (sitelib install or .pth).
    _here = Path(__file__).resolve().parent
    for _libdir in (_here, _here.parent / "lib", Path("/usr/libexec/workloadctl")):
        if (_libdir / "workload_lib.py").is_file():
            sys.path.insert(0, str(_libdir))
            break
    # --- end bootstrap -----------------------------------------------------
    from workload_lib import (
        WORKLOAD_CONFIG_DIR, WORKLOADS_BASE, GENERATOR_OWNED_DIRECTIVES,
        SECRET_PATTERN, auto_detect_credentials, validate_env_key,
        workload_username, workload_home_dir, expand_volume_path, dq,
        normalize_containers, validate_workload_config, infer_workload_mode,
        infer_workload_kind,
        VM_BRIDGE_NAME, VM_BRIDGE_SUBNET, VM_BRIDGE_IP, VM_DHCP_RANGE,
        VM_SOCKET_DIR, VM_DHCP_LEASE_FILE, VM_DHCP_PIDFILE,
        vm_mac_address, find_ovmf_code,
        parse_memory_mib, virtiofs_tag, parse_volume_spec,
        selinux_type_name,
    )
    _early_log("Python imports complete")
except Exception as e:
    _early_log(f"Import failed: {e}")
    # Exit 0 so a broken import never blocks boot.
    import sys as _sys
    _sys.exit(0)

# Output directory for generated service files and sysusers configs.
# Called by workload-generate.service with /run/systemd/system as argv[1],
# or by tests with a temp directory. Falls back to /tmp if no arg given.
NORMAL_DIR = sys.argv[1] if len(sys.argv) > 1 else "/tmp"
SERVICES_DIR = Path(NORMAL_DIR) if len(sys.argv) > 1 else Path("/run/systemd/system")
# Allow override for testing
SYSUSERS_DIR = Path(os.environ.get("SYSUSERS_DIR", str(SERVICES_DIR)))

# Baseline seccomp profile applied to all workloads unless overridden via security_opt
SECCOMP_BASELINE = "/usr/share/containers/seccomp-workload-baseline.json"


def log_msg(msg, level="info"):
    """Log to kernel message buffer (available during generator execution).

    Systemd generators run very early and cannot rely on journald.
    Use /dev/kmsg which is always available.

    Messages will appear in dmesg and eventually in the journal.
    """
    # kmsg priority levels (same as syslog)
    # 3=err, 4=warning, 5=notice, 6=info, 7=debug
    priority_map = {
        "err": 3,
        "warning": 4,
        "notice": 5,
        "info": 6,
        "debug": 7
    }
    priority = priority_map.get(level, 6)

    if os.environ.get("WORKLOAD_GENERATE_LOG_STDERR"):
        print(f"workload-generate: {msg}", file=sys.stderr, flush=True)
        return
    try:
        with open("/dev/kmsg", "w") as kmsg:
            kmsg.write(f"<{priority}>workload-generate: {msg}\n")
    except Exception:
        # /dev/kmsg isn't writable (not running as a boot-time generator, or
        # in a test); fall back to stderr so the message isn't lost.
        print(f"workload-generate: {msg}", file=sys.stderr, flush=True)


UID_MIN = 10000
UID_MAX = 52948


def allocate_uid():
    """Find the next free UID in the workload range (10000-52948).

    Scans /etc/passwd for UIDs already in use and returns the lowest
    available. Called once per new workload during generation.
    """
    used_uids = set()
    try:
        for pw in pwd.getpwall():
            if UID_MIN <= pw.pw_uid <= UID_MAX:
                used_uids.add(pw.pw_uid)
    except Exception:
        pass  # If getpwall fails, start from UID_MIN

    for uid in range(UID_MIN, UID_MAX + 1):
        if uid not in used_uids:
            used_uids.add(uid)  # Reserve for subsequent calls in same run
            return uid

    raise RuntimeError(f"No free UIDs in range {UID_MIN}-{UID_MAX}")


# Track UIDs allocated during this run (for multiple workloads)
_allocated_uids = set()


def get_next_uid():
    """Get next free UID, accounting for UIDs allocated earlier in this run."""
    used_uids = set(_allocated_uids)
    try:
        for pw in pwd.getpwall():
            if UID_MIN <= pw.pw_uid <= UID_MAX:
                used_uids.add(pw.pw_uid)
    except Exception:
        pass

    for uid in range(UID_MIN, UID_MAX + 1):
        if uid not in used_uids:
            _allocated_uids.add(uid)
            return uid

    raise RuntimeError(f"No free UIDs in range {UID_MIN}-{UID_MAX}")


def generate_sysuser_config(config, user_name, uid):
    """Generate systemd-sysusers config content for a workload user.

    Args:
        config: Parsed TOML workload config.
        user_name: System username (e.g. _wl-foo).
        uid: Numeric UID (int). Must be pre-allocated — sysusers does not
             support range syntax.
    """
    name = config["workload"]["name"]
    home_dir = str(WORKLOADS_BASE / name)
    extra_groups = config.get("security", {}).get("extra_groups", [])

    lines = [
        f"# Workload user for {name}",
        f"u {user_name} {uid} \"{name} workload\" {home_dir}",
    ]

    for group in extra_groups:
        lines.append(f"m {user_name} {group}")

    return "\n".join(lines) + "\n"



def get_group_gid(group_name):
    """Get GID for a group name."""
    try:
        return grp.getgrnam(group_name).gr_gid
    except KeyError:
        return None


def _valid_userns(mode):
    """Validate a userns mode string.

    Accepts "host", "keep-id", or "keep-id" with uid/gid parameters
    (e.g. "keep-id:uid=1000,gid=1000").
    """
    if mode in ("keep-id", "host"):
        return True
    if not mode.startswith("keep-id:"):
        return False
    params = mode[len("keep-id:"):].split(",")
    valid_keys = {"uid", "gid"}
    seen = set()
    for param in params:
        if "=" not in param:
            return False
        key, value = param.split("=", 1)
        if key not in valid_keys or key in seen or not value.isdigit():
            return False
        seen.add(key)
    return len(seen) > 0


def build_userns_args(security, uid, extra_groups, name):
    """Return podman --userns / --uidmap / --gidmap args for a security dict.

    Used for single- and bridge-mode container services (per-container
    [security]) and for the `podman pod create` command in pod mode, where
    the user namespace is owned by the pod's infra container and is therefore
    workload-level (read from the top-level [security] block).
    """
    args = []
    userns_mode = security.get("userns", "keep-id")
    if not _valid_userns(userns_mode):
        log_msg(f"WARNING: Invalid userns mode '{userns_mode}' for {name}. "
                f"Defaulting to 'keep-id'.",
                level="warning")
        userns_mode = "keep-id"

    if userns_mode == "host":
        log_msg(f"WARNING: {name} uses userns=host. Container root maps to workload user. "
                f"Container escape grants workload user privileges.", level="warning")

    # Extra UID/GID maps for keep-id userns.
    # When extra_groups or explicit maps are present, we emit +N:@N:1 flags
    # which imply keep-id behavior.
    # Podman 5.x treats --userns and --uidmap/--gidmap as mutually exclusive,
    # so we must omit --userns when + prefixed maps are used.
    extra_uidmaps = security.get("extra_uidmaps", [])
    extra_gidmaps = security.get("extra_gidmaps", [])
    needs_auto_maps = (
        userns_mode.startswith("keep-id")
        and (extra_groups or extra_uidmaps or extra_gidmaps)
    )
    if needs_auto_maps:
        # GID == UID for workload users (sysusers convention)
        gid = uid
        # Honor the optional :uid=N,gid=N suffix on keep-id, which remaps the
        # workload user to a different in-container uid/gid (e.g. for images
        # that ship a fixed non-root user). Without this, +N:@N:1 hardcodes the
        # in-container uid to the host workload uid, silently ignoring the
        # suffix that the non-needs_auto_maps branch would have honored.
        target_uid = uid
        target_gid = gid
        if userns_mode.startswith("keep-id:"):
            for param in userns_mode[len("keep-id:"):].split(","):
                key, _, value = param.partition("=")
                if key == "uid":
                    target_uid = int(value)
                elif key == "gid":
                    target_gid = int(value)
        # Auto-map the workload user's own UID and GID (+ prefix implies keep-id)
        args.append(f"--uidmap +{target_uid}:@{uid}:1")
        args.append(f"--gidmap +{target_gid}:@{gid}:1")
        # Auto-map GIDs from extra_groups
        mapped_gids = {gid}
        for group in extra_groups:
            group_gid = get_group_gid(group)
            if group_gid is not None and group_gid not in mapped_gids:
                args.append(f"--gidmap +{group_gid}:@{group_gid}:1")
                mapped_gids.add(group_gid)
        # Explicit maps from TOML (with {UID}/{GID} placeholder substitution)
        for m in extra_uidmaps:
            m = m.replace("{UID}", str(uid)).replace("{GID}", str(gid))
            args.append(f"--uidmap {m}")
        for m in extra_gidmaps:
            m = m.replace("{UID}", str(uid)).replace("{GID}", str(gid))
            args.append(f"--gidmap {m}")
    else:
        args.append(f"--userns={userns_mode}")
    return args


def build_plain_env_args(container):
    """Build --env arguments for non-secret environment variables.

    Env vars containing ${SECRET:name} references are omitted — those are
    resolved at runtime by workload-write-env and passed via --env-file.
    """
    env_vars = container.get("container", {}).get("environment", {})
    env_args = []

    for key, value in env_vars.items():
        if not validate_env_key(key):
            log_msg(f"  WARNING: skipping env var with invalid key: {key!r}", level="warning")
            continue
        if SECRET_PATTERN.search(str(value)):
            continue  # Handled by workload-write-env via --env-file
        # shlex.quote uses single quotes, preventing $-expansion in systemd
        env_args.append(f'--env {key}={shlex.quote(str(value))}')

    return env_args


def build_resource_directives(container):
    """Build systemd resource control directives from [resources] config.

    Returns list of systemd directive lines to add to [Service] section.
    Supports both convenience options (cpu_quota, memory_max, etc.) and
    custom_directives escape hatch for advanced users.
    """
    resources = container.get("resources", {})
    if not resources:
        return []

    directives = []

    # CPU limits
    if "cpu_quota" in resources:
        # Simple format: "50%", "100%", "200%"
        cpu_quota = resources["cpu_quota"]
        directives.append(f"CPUQuota={cpu_quota}")

    if "cpu_weight" in resources:
        # Integer 1-10000
        cpu_weight = resources["cpu_weight"]
        directives.append(f"CPUWeight={cpu_weight}")

    # Memory limits
    if "memory_max" in resources:
        # Simple format: "2G", "512M", "1.5G"
        memory_max = resources["memory_max"]
        directives.append(f"MemoryMax={memory_max}")

    if "memory_high" in resources:
        memory_high = resources["memory_high"]
        directives.append(f"MemoryHigh={memory_high}")

    if "memory_swap_max" in resources:
        memory_swap_max = resources["memory_swap_max"]
        directives.append(f"MemorySwapMax={memory_swap_max}")

    # I/O limits
    if "io_weight" in resources:
        io_weight = resources["io_weight"]
        directives.append(f"IOWeight={io_weight}")

    if "io_read_bandwidth_max" in resources:
        # Array of "device bandwidth" strings
        for limit in resources["io_read_bandwidth_max"]:
            directives.append(f"IOReadBandwidthMax={limit}")

    if "io_write_bandwidth_max" in resources:
        for limit in resources["io_write_bandwidth_max"]:
            directives.append(f"IOWriteBandwidthMax={limit}")

    # Process limits
    if "tasks_max" in resources:
        tasks_max = resources["tasks_max"]
        directives.append(f"TasksMax={tasks_max}")

    # Timeout overrides (these are already in Service section but allow override)
    if "timeout_start_sec" in resources:
        timeout_start = resources["timeout_start_sec"]
        directives.append(f"TimeoutStartSec={timeout_start}")

    if "timeout_stop_sec" in resources:
        timeout_stop = resources["timeout_stop_sec"]
        directives.append(f"TimeoutStopSec={timeout_stop}")

    # Escape hatch: custom systemd directives
    # Allows power users to specify any systemd directive not covered above
    custom_directives = resources.get("custom_directives", {})
    for directive, value in custom_directives.items():
        if directive in GENERATOR_OWNED_DIRECTIVES:
            log_msg(
                f"WARNING: custom_directives contains '{directive}' which is managed "
                f"by the generator — this may have no effect or cause unexpected behaviour",
                level="warning"
            )
        directives.append(f"{directive}={value}")

    return directives


def generate_setup_service(config, user_name):
    """Generate a oneshot service that creates the workload user.

    Runs as root (no User= directive) before the main workload service.
    This avoids the chicken-and-egg problem where User= must be resolvable
    before any ExecStartPre runs — including the ones that create the user.
    """
    name = config["workload"]["name"]
    sysusers_conf = f"{SERVICES_DIR}/workload-{name}.conf"

    lines = [
        f"# Setup service for {name} workload",
        "# Generated by workload-generate",
        "",
        "[Unit]",
        f"Description=Setup {name} workload user",
        "",
        "[Service]",
        "Type=oneshot",
        "RemainAfterExit=yes",
        f"ExecStart=/usr/bin/systemd-sysusers {sysusers_conf}",
        f"ExecStart=/usr/libexec/workloadctl/workload-ensure-user {name}",
        "",
    ]

    return "\n".join(lines)


def resolve_auto_gpu():
    """Detect the primary GPU from sysfs.

    Returns 'nvidia', 'nouveau', 'amd', 'intel', or 'none'. For NVIDIA cards
    the bound driver is checked: the proprietary driver uses the CDI path,
    but nouveau has no NVIDIA Container Toolkit support and must use the plain
    DRM render node instead — so it is reported separately.

    WORKLOAD_GPU_OVERRIDE pins the result regardless of host hardware. This
    makes the generated units deterministic for the snapshot tests (which must
    pass on any runner, GPU or not) and lets an operator force a result.
    """
    override = os.environ.get("WORKLOAD_GPU_OVERRIDE")
    if override:
        return override

    vendor_map = {"0x10de": "nvidia", "0x1002": "amd", "0x8086": "intel"}
    try:
        for vendor_path in sorted(Path("/sys/class/drm").glob("card*/device/vendor")):
            vendor = vendor_path.read_text().strip().lower()
            if vendor not in vendor_map:
                continue
            result = vendor_map[vendor]
            if result == "nvidia":
                try:
                    if (vendor_path.parent / "driver").resolve().name == "nouveau":
                        return "nouveau"
                except OSError:
                    pass
            return result
    except OSError:
        pass
    return "none"


def generate_pod_service(workload, user_name, uid):
    """Generate the workload-{name}-pod.service unit (pod mode only)."""
    name = workload["workload"]["name"]
    home_dir = str(WORKLOADS_BASE / name)
    slice_name = workload.get("resources", {}).get("slice", "workloads.slice")

    network_config = workload.get("network", {})
    network_mode = network_config.get("mode", "pasta")
    pod_args = [f"--name=workload-{name}", f"--network={network_mode}"]
    if network_mode not in ("host", "none"):
        for port in network_config.get("ports", []):
            pod_args.append(f"--publish {port}")
    # The pod's infra container owns the user namespace shared by every member
    # container, so userns is workload-level in pod mode: read from the
    # top-level [security] block, not per-container [containers.*.security].
    extra_groups = workload.get("security", {}).get("extra_groups", [])
    pod_args.extend(
        build_userns_args(workload.get("security", {}), uid, extra_groups, name)
    )
    pod_args_str = " ".join(pod_args)

    return "\n".join([
        f"# Pod-create service for {name}",
        "# Generated by workload-generate",
        "",
        "[Unit]",
        f"Description={name} pod",
        f"Requires=workload-{name}-setup.service",
        f"After=network.target workload-{name}-setup.service",
        # PartOf the umbrella so `systemctl stop` (and workloadctl disable)
        # tears the pod down too — otherwise this oneshot lingers
        # active(exited) and a later re-enable never re-runs `pod create`.
        f"PartOf=workload-{name}.service",
        "",
        "[Service]",
        "Type=oneshot",
        "RemainAfterExit=yes",
        f"Slice={slice_name}",
        f"User={user_name}",
        f"Group={user_name}",
        f'Environment="HOME={home_dir}"',
        f"EnvironmentFile=-/run/workload-env/workload-{name}.env",
        f"ExecStartPre=-/usr/bin/podman pod rm -f --ignore workload-{name}",
        f"ExecStart=/usr/bin/podman pod create {pod_args_str}",
        f"ExecStop=/usr/bin/podman pod rm -f --ignore workload-{name}",
        "StandardOutput=journal",
        "StandardError=journal",
        "",
        # No [Install]: this helper is pulled in by the umbrella's Requires=
        # and never gets its own multi-user.target.wants symlink.
    ])


def generate_net_service(workload, user_name, uid):
    """Generate the workload-{name}-net.service unit (bridge mode only).

    Creates a per-workload podman bridge network. Member containers join it
    via --network, which gives them DNS resolution of each other by name.
    """
    name = workload["workload"]["name"]
    home_dir = str(WORKLOADS_BASE / name)
    slice_name = workload.get("resources", {}).get("slice", "workloads.slice")
    net_name = f"workload-{name}-net"

    return "\n".join([
        f"# Bridge-network service for {name}",
        "# Generated by workload-generate",
        "",
        "[Unit]",
        f"Description={name} bridge network",
        f"Requires=workload-{name}-setup.service",
        f"After=network.target workload-{name}-setup.service",
        # PartOf the umbrella so `systemctl stop` (and workloadctl disable)
        # tears the network down too — otherwise this oneshot lingers
        # active(exited) and a later re-enable never re-runs `network create`.
        f"PartOf=workload-{name}.service",
        "",
        "[Service]",
        "Type=oneshot",
        "RemainAfterExit=yes",
        f"Slice={slice_name}",
        f"User={user_name}",
        f"Group={user_name}",
        f'Environment="HOME={home_dir}"',
        f"EnvironmentFile=-/run/workload-env/workload-{name}.env",
        f"ExecStartPre=-/usr/bin/podman network rm -f {net_name}",
        f"ExecStart=/usr/bin/podman network create {net_name}",
        f"ExecStop=/usr/bin/podman network rm -f {net_name}",
        "StandardOutput=journal",
        "StandardError=journal",
        "",
        # No [Install]: this helper is pulled in by the umbrella's Requires=
        # and never gets its own multi-user.target.wants symlink.
    ])


def generate_umbrella_service(workload_name, container_names, slice_name, mode):
    """Generate the workload-{name}.service umbrella oneshot.

    'mode' is "pod" or "bridge". Determines whether the umbrella requires
    the pod or the net service.

    Requires= (not Wants=) is used for the per-container sub-services so that
    `systemctl is-active workload-<name>.service` reflects sub-service failure:
    if any container fails to start, the umbrella is failed too, which is what
    external monitoring expects to alert on. The trade-off is that a single
    bad container takes the whole workload down — a deliberate choice; users
    who want one-container-failure-tolerance can split into separate workloads.
    """
    helper = "pod" if mode == "pod" else "net"
    sub_services = " ".join(
        f"workload-{workload_name}-{c}.service" for c in container_names
    )
    return "\n".join([
        f"# Umbrella service for {workload_name}",
        "# Generated by workload-generate",
        "",
        "[Unit]",
        f"Description={workload_name} multi-container workload",
        f"Requires=workload-{workload_name}-setup.service workload-{workload_name}-{helper}.service",
        f"After=workload-{workload_name}-setup.service workload-{workload_name}-{helper}.service",
        f"Requires={sub_services}",
        f"After={sub_services}",
        "",
        "[Service]",
        "Type=oneshot",
        "RemainAfterExit=yes",
        f"Slice={slice_name}",
        "ExecStart=/bin/true",
        "",
        "[Install]",
        "WantedBy=multi-user.target",
        "",
    ])


def generate_system_service(workload, container, user_name, uid, mode="single"):
    """Generate systemd system service for rootless podman execution.

    Requires the setup service to have created the user first.

    'workload' is the full parsed TOML (used for workload-level fields like
    [network] and [setup]); 'container' is one element of
    normalize_containers(workload). 'mode' is "single", "pod", or "bridge".
    """
    config = workload  # alias kept for the few remaining workload-level reads
    name = workload["workload"]["name"]
    if mode == "single":
        container_name = f"workload-{name}"
    else:
        container_name = f"workload-{name}-{container['name']}"
    home_dir = str(WORKLOADS_BASE / name)

    image = container["container"]["image"]
    command = container["container"].get("command", None)
    pull_policy = container["container"].get("pull", "missing")  # missing, always, newer, never
    gpu_type = container.get("devices", {}).get("gpu", "none")
    if gpu_type == "auto":
        gpu_type = resolve_auto_gpu()
    # "nvidia:<spec>" pins a specific GPU via the CDI device name (UUID or index).
    # When a spec is set, only that GPU's DRM nodes are mounted — the umbrella
    # /dev/dri is dropped so the other GPUs are invisible inside the container.
    gpu_vendor, _, gpu_spec = gpu_type.partition(":")
    extra_groups = config.get("security", {}).get("extra_groups", [])
    privileged = config.get("security", {}).get("privileged", False)

    setup_service = f"workload-{name}-setup.service"
    pod_service = f"workload-{name}-pod.service"
    net_service = f"workload-{name}-net.service"
    umbrella_service = f"workload-{name}.service"
    # Slice assignment (default: workloads.slice). In pod mode, slice is
    # workload-level; in single mode it lives on the (only) container.
    if mode == "single":
        slice_name = container.get("resources", {}).get("slice", "workloads.slice")
    else:
        slice_name = workload.get("resources", {}).get("slice", "workloads.slice")

    if mode == "single":
        unit_description = f"{name} rootless workload"
    else:
        unit_description = f"{name}/{container['name']} container"

    lines = [
        f"# Rootless workload service for {name}" if mode == "single"
        else f"# Container service for {name}/{container['name']}",
        "# Generated by workload-generate",
        "",
        "[Unit]",
        f"Description={unit_description}",
    ]
    if mode == "single":
        lines.append(f"Requires={setup_service}")
        lines.append(f"After=network.target {setup_service}")
    else:
        # pod mode binds to the pod-create service; bridge mode to the
        # network-create service.
        dep_service = pod_service if mode == "pod" else net_service
        lines.append(f"Requires={dep_service}")
        lines.append(f"After={dep_service}")
        lines.append(f"BindsTo={dep_service}")
        lines.append(f"PartOf={umbrella_service}")
    lines.append("StartLimitIntervalSec=300")
    lines.append("StartLimitBurst=5")

    if gpu_vendor == "nvidia":
        lines.append("Requires=nvidia-cdi-generator.service")
        lines.append("After=nvidia-cdi-generator.service")

    # container.systemd: "always", "true", "false", or unset
    systemd_mode = container.get("container", {}).get("systemd", None)
    if systemd_mode is not None:
        systemd_mode = str(systemd_mode).lower()
        valid_systemd = ("always", "true", "false")
        if systemd_mode not in valid_systemd:
            log_msg(f"ERROR: Invalid container.systemd='{systemd_mode}' for {name}. "
                    f"Valid values: {', '.join(valid_systemd)}.", level="err")
            return None

    # service_type is read here (before podman_args) so --sdnotify can match.
    # Default is "exec": activates once podman starts, no READY handshake needed.
    # "notify" + --sdnotify=conmon is broken systemically when linger is active
    # because conmon migrates into the user session cgroup and systemd rejects its
    # READY=1 (NotifyAccess=all only accepts PIDs in the service's own cgroup tree).
    service_type = container.get("resources", {}).get("service_type", "exec")
    valid_types = ["simple", "exec", "forking", "oneshot", "dbus", "notify", "idle"]
    if service_type not in valid_types:
        log_msg(f"WARNING: Invalid service_type '{service_type}' for {name}. "
                f"Valid types: {', '.join(valid_types)}. Defaulting to 'exec'.",
                level="warning")
        service_type = "exec"

    container_name_quoted = dq(container_name)
    podman_args = [
        "/usr/bin/podman run",
        f"--name {container_name_quoted}",
    ]
    # In pod mode the container joins the pod's UTS namespace, so it cannot
    # set its own hostname (podman rejects it). Single and bridge mode each
    # own their UTS namespace and take a hostname normally.
    if mode != "pod":
        podman_args.append(f"--hostname {dq(name)}")
    podman_args.append("--rm")
    # --replace removes a same-named container leftover from an unclean shutdown
    # (OOM kill, SIGKILL) before starting, breaking the "name already in use" loop.
    podman_args.append("--replace")

    # --init provides a minimal init process (tini) for signal handling.
    # Skip when container.systemd is set — the container either runs systemd
    # as PID 1 or has its own init/entrypoint.
    if systemd_mode is None:
        podman_args.append("--init")
    else:
        podman_args.append(f"--systemd={systemd_mode}")

    # Use sdnotify=conmon only when the unit type is notify; otherwise ignore.
    sdnotify = "conmon" if service_type == "notify" else "ignore"
    podman_args.extend([
        f"--sdnotify={sdnotify}",
        f"--pull={pull_policy}",
        "--log-driver=journald",
    ])

    # Keep the container cgroup under the unit (workloads.slice/workload-<name>.service)
    # so that systemd resource directives (MemoryMax, CPUQuota, MemoryHigh, TasksMax,
    # IOWeight, etc.) actually bind the container's cgroup. Without this, conmon
    # migrates the container into a transient scope under user@<uid>.service and the
    # unit directives are silently ignored.
    #
    # Pod mode is excluded: podman rejects --cgroups=split for pod members (they
    # join the pod's own cgroup hierarchy). The consequence is that pod-member
    # units do NOT get per-unit resource enforcement — their [resources]
    # directives are emitted but don't bind, exactly the situation split fixes
    # for single/bridge. See docs/resource-caps-and-split-review.md.
    if mode != "pod":
        podman_args.append("--cgroups=split")

    # User namespace / UID-GID maps.
    # In pod mode the user namespace is owned by the pod's infra container and
    # is set on `podman pod create` (see generate_pod_service); member
    # containers cannot set their own and podman rejects the attempt. Single
    # and bridge mode each own their userns and set it on the container.
    if mode == "pod":
        if container.get("security", {}).get("userns") is not None:
            log_msg(f"WARNING: {name}/{container['name']} sets [security].userns; "
                    f"ignored in pod mode (userns is workload-level — set it in "
                    f"the top-level [security] block)", level="warning")
    else:
        podman_args.extend(
            build_userns_args(container.get("security", {}), uid, extra_groups, name)
        )

    # Override the container image's USER directive if specified
    container_user = container.get("container", {}).get("user", "")
    if container_user:
        podman_args.append(f"--user={container_user}")

    capabilities = container.get("security", {}).get("capabilities", [])
    for cap in capabilities:
        podman_args.append(f"--cap-add={cap}")

    security_opts = container.get("security", {}).get("security_opt", [])
    for opt in security_opts:
        podman_args.append(f"--security-opt={opt}")

    # Per-workload SELinux type: launch the container under wl_<name>.process
    # instead of widening the shared container_t/container_init_t domains (a
    # global semodule load). The matching CIL policy module is loaded by the CLI
    # on enable; here we only apply the label, which is a pure string function of
    # the workload name — no I/O, boot-path safe.
    # selinux_policy is a workload-level decision (one module per workload, keyed
    # on the workload name). Read it from the top-level [security] block so the
    # label matches what cmd_enable loads in all modes including multi-container.
    workload_selinux = config.get("security", {}).get("selinux_policy")
    if mode != "single" and container.get("security", {}).get("selinux_policy"):
        log_msg(f"WARNING: {name}/{container.get('name', '?')} sets selinux_policy "
                f"under [containers.security]; this is ignored. Set selinux_policy "
                f"in the top-level [security] block to apply it to all containers "
                f"in this workload.", level="warning")
    if workload_selinux:
        podman_args.append(f"--security-opt=label=type:{selinux_type_name(name)}")

    # Apply baseline seccomp profile unless the workload overrides it or uses --privileged
    # (--privileged disables seccomp anyway; adding it would just be noise)
    if not privileged and not any(opt.startswith("seccomp=") for opt in security_opts):
        podman_args.append(f"--security-opt=seccomp={SECCOMP_BASELINE}")

    if privileged:
        log_msg(f"WARNING: {name} uses privileged=true. "
                f"Consider using specific capabilities for better security.", level="warning")
        podman_args.append("--privileged")

    # Pass host supplementary groups into the container.
    # keep-groups preserves all supplementary groups from the host process and
    # is required for @GID userns delegation in --gidmap +GID:@GID:1.
    # The workload user is added to extra_groups via sysusers 'm' directive.
    if extra_groups:
        podman_args.append("--group-add=keep-groups")

    # GPU devices (convenience flag)
    if gpu_vendor == "amd":
        podman_args.extend([
            "--device /dev/kfd",
            "--device /dev/dri",
        ])
    elif gpu_vendor == "nvidia":
        # gpu = "nvidia"           → all GPUs, all DRM nodes
        # gpu = "nvidia:<spec>"    → one GPU; CDI injects only that card's DRM
        #                            nodes, so the umbrella /dev/dri is omitted.
        # <spec> is any CDI device name from `nvidia-ctk cdi list`: an index
        # ("1") or a stable GPU UUID ("GPU-...").
        if gpu_spec:
            podman_args.append(f"--device=nvidia.com/gpu={gpu_spec}")
        else:
            podman_args.extend([
                "--device=nvidia.com/gpu=all",
                "--device /dev/dri",
            ])
    elif gpu_vendor in ("intel", "nouveau"):
        # nouveau (and Intel) expose the GPU through the standard DRM render
        # node — no CDI / Container Toolkit involved.
        podman_args.append("--device /dev/dri")

    # Generic device passthrough
    devices_config = container.get("devices", {})
    generic_devices = devices_config.get("devices", [])
    for device in generic_devices:
        podman_args.append(f"--device {device}")

    # CONVENIENCE FLAGS (multi-device shortcuts)

    # Input devices (2 devices)
    if devices_config.get("input", False):
        podman_args.extend([
            "--device /dev/input",
            "--device /dev/uinput",
        ])

    # Audio devices (device + socket auto-detection)
    if devices_config.get("audio", False):
        podman_args.append("--device /dev/snd")
        # Mount PulseAudio/PipeWire sockets via XDG_RUNTIME_DIR (resolved at exec
        # time from EnvironmentFile written by workload-ensure-user).
        for suffix in ["pulse", "pipewire-0"]:
            podman_args.append(f"--volume ${{XDG_RUNTIME_DIR}}/{suffix}:${{XDG_RUNTIME_DIR}}/{suffix}:ro")

    # Virtualization devices (3 devices)
    if devices_config.get("virtualization", False):
        podman_args.extend([
            "--device /dev/kvm",
            "--device /dev/vhost-net",
            "--device /dev/vhost-vsock",
        ])

    # Shared memory size
    shm_size = container.get("resources", {}).get("shm_size", "")
    if shm_size:
        podman_args.append(f"--shm-size={shm_size}")

    # Container PID limit (podman default is 2048, independent of systemd TasksMax)
    tasks_max = container.get("resources", {}).get("tasks_max", 0)
    if tasks_max:
        podman_args.append(f"--pids-limit={tasks_max}")

    # Network configuration.
    #  - single: workload-level [network] mode + ports.
    #  - pod: the pod owns the netns; the container just joins it (no
    #    --network/--publish — podman rejects them on a pod member).
    #  - bridge: the container joins the per-workload bridge network and
    #    publishes its own [containers.network].ports.
    if mode == "single":
        network_config = workload.get("network", {})
        network_mode = network_config.get("mode", "pasta")  # Default to pasta (works in Podman 5.3+)

        podman_args.append(f"--network={dq(network_mode)}")
        if network_mode not in ("host", "none"):
            for port in network_config.get("ports", []):
                podman_args.append(f"--publish {port}")
    elif mode == "pod":
        podman_args.append(f"--pod={dq(f'workload-{name}')}")
    else:  # bridge
        podman_args.append(f"--network={dq(f'workload-{name}-net')}")
        # Publish the short container name as a DNS alias so siblings resolve
        # each other by name (e.g. "db"); the --name is workload-{name}-{ctr}.
        podman_args.append(f"--network-alias={dq(container['name'])}")
        for port in container.get("network", {}).get("ports", []):
            podman_args.append(f"--publish {port}")

    for volume in container.get("storage", {}).get("volumes", []):
        expanded = expand_volume_path(volume, home_dir)
        if ':' in expanded:
            parts = expanded.split(':', 2)
            # Warn if host path escapes the workload home directory
            try:
                resolved = str(Path(parts[0]).resolve())
                if not resolved.startswith(home_dir + '/') and resolved != home_dir:
                    log_msg(f"  WARNING: volume host path '{parts[0]}' resolves to "
                            f"'{resolved}' outside home dir '{home_dir}'", level="warning")
            except Exception:
                pass
            parts[0] = dq(parts[0])
            expanded = ':'.join(parts)
        else:
            expanded = dq(expanded)
        podman_args.append(f"--volume {expanded}")

    credentials = auto_detect_credentials({
        "container": container.get("container", {}),
        "secrets":   container.get("secrets", {}),
    })
    # In multi-container modes the credential is loaded onto the per-container
    # service unit, so systemd decrypts it to /run/credentials/<container-unit>/.
    # Using the umbrella name here would point the bind-mount at the wrong dir.
    service_name = f"{container_name}.service"
    secrets_config = container.get("secrets", {})
    secrets_files = secrets_config.get("files", [])

    for file_spec in secrets_files:
        credential_name = file_spec.get("credential")
        container_path = file_spec.get("path")

        if not credential_name or not container_path:
            log_msg(f"WARNING: secrets.files entry missing 'credential' or 'path', skipping", level="warning")
            continue

        # Credential will be decrypted to /run/credentials/{service}/
        source_path = f"/run/credentials/{service_name}/{credential_name}"

        # Validate and default to read-only for security
        mode = file_spec.get("mode", "ro")
        valid_modes = ["ro", "rw"]
        if mode not in valid_modes:
            log_msg(
                f"WARNING: Invalid mode '{mode}' for credential '{credential_name}', "
                f"must be 'ro' or 'rw'. Defaulting to 'ro'.",
                level="warning"
            )
            mode = "ro"

        podman_args.append(f"--volume {dq(source_path)}:{dq(container_path)}:{mode}")
        log_msg(f"  Mounting credential '{credential_name}' to {container_path} (mode: {mode})")

    # HOST_IP is auto-detected by workload-ensure-user and written to the
    # EnvironmentFile; pass it into the container so configs can use it.
    podman_args.append("--env HOST_IP=${HOST_IP}")

    # Plain env vars go as --env args; secret env vars go via --env-file
    env_args = build_plain_env_args(container)
    podman_args.extend(env_args)

    # Check if any env vars reference secrets (need --env-file from workload-write-env)
    has_secret_env_vars = any(
        SECRET_PATTERN.search(str(v))
        for v in container.get("container", {}).get("environment", {}).values()
    )
    if has_secret_env_vars:
        # Per-container secrets file: each container has its own
        # LoadCredentialEncrypted/CREDENTIALS_DIRECTORY, so a shared file
        # would race when multiple containers in the same workload start.
        secrets_env_file = f"/run/workload-env/{container_name}.secrets"
        podman_args.append(f"--env-file {dq(secrets_env_file)}")

    # Health checks
    health = container.get("container", {}).get("health", {})
    health_cmd = health.get("cmd", "")
    # Under --cgroups=split (single/bridge), podman's own healthcheck runs from a
    # `systemd-run --user` timer whose probe exec can't migrate into the
    # container's payload cgroup (cross-boundary EPERM), so it always records
    # failure. We suppress that timer (DISABLE_HC_SYSTEMD below) and run the
    # probe + on-failure action from a system-manager timer via
    # workload-healthcheck instead. Pod mode keeps podman's working --user timer.
    split_health = bool(health_cmd) and mode != "pod"
    if health_cmd:
        podman_args.append(f"--health-cmd {dq(health_cmd)}")
        if "interval" in health:
            podman_args.append(f"--health-interval={health['interval']}")
        if "timeout" in health:
            podman_args.append(f"--health-timeout={health['timeout']}")
        if "retries" in health:
            podman_args.append(f"--health-retries={health['retries']}")
        if "start_period" in health:
            podman_args.append(f"--health-start-period={health['start_period']}")
        on_failure = health.get("on_failure", "none")
        # Pin podman's own action to none under split — workload-healthcheck owns
        # it (the action must fire from the system manager, where the unit lives).
        podman_args.append(
            f"--health-on-failure={'none' if split_health else on_failure}"
        )

    if split_health:
        # Pull in the per-(container) healthcheck timer when this unit starts.
        lines.append(f"Wants={container_name}-health.timer")

    podman_args.append(dq(image))

    if command:
        if isinstance(command, list):
            podman_args.extend([dq(arg) for arg in command])
        else:
            podman_args.append(dq(command))

    podman_cmd = " ".join(podman_args)

    lines.extend([
        "",
        "[Service]",
        f"Type={service_type}",
        f"Slice={slice_name}",
    ])

    # Delegate the cgroup subtree to the workload user so conmon can create
    # sub-cgroups under this unit (required by --cgroups=split). Not needed for
    # pod mode (the pod owns its own cgroup hierarchy and members just join it).
    if mode != "pod":
        lines.append("Delegate=yes")

    # NotifyAccess only needed for Type=notify
    if service_type == "notify":
        lines.append("NotifyAccess=all")

    # systemd containers need SIGRTMIN+3 for clean shutdown
    if systemd_mode in ("always", "true"):
        lines.append("KillSignal=SIGRTMIN+3")

    lines.extend([
        f"User={user_name}",
        f"Group={user_name}",
        f'Environment="HOME={home_dir}"',
    ])
    if split_health:
        # Stop podman from creating its own (broken under split) --user
        # healthcheck timer; workload-healthcheck drives the probe instead.
        lines.append("Environment=DISABLE_HC_SYSTEMD=true")
    lines.extend([
        f"EnvironmentFile=-/run/workload-env/workload-{name}.env",
        "",
    ])

    resource_directives = build_resource_directives(container)
    if resource_directives:
        lines.append("# Resource limits and constraints")
        lines.extend(resource_directives)
        lines.append("")

    if credentials:
        lines.append("# Load encrypted credentials (auto-decrypted to /run/credentials/{service}/)")
        for cred_name in credentials:
            cred_file = f"/etc/credstore.encrypted/{cred_name}"
            lines.append(f"LoadCredentialEncrypted={cred_name}:{cred_file}")
        lines.append("")

    if has_secret_env_vars:
        # Multi-container: pass the local container name so workload-write-env
        # resolves *that* container's env vars only and writes the matching
        # per-container secrets file. Single-mode keeps the legacy one-arg form.
        if mode == "single":
            lines.append(f"ExecStartPre=+/usr/libexec/workloadctl/workload-write-env {name}")
        else:
            lines.append(
                f"ExecStartPre=+/usr/libexec/workloadctl/workload-write-env "
                f"{name} {container['name']}"
            )

    if gpu_vendor == "nvidia":
        lines.append(
            "ExecStartPre=/bin/bash -c "
            "'test -s /run/cdi/nvidia.yaml"
            " || { echo \"NVIDIA CDI spec missing: check nvidia-cdi-generator.service\" >&2; exit 1; }'"
        )

    lines.append("")
    lines.append(f"# Image pulling handled by podman run --pull={pull_policy}")
    lines.append("")

    lines.append(f"ExecStart={podman_cmd}")

    # podman's own container-stop grace (-t): how long the container gets to
    # exit on the stop signal before podman SIGKILLs it. Keep it a few seconds
    # under the unit's TimeoutStopSec so systemd doesn't kill `podman stop`
    # before podman can do its own SIGKILL + reap. Tracks timeout_stop_sec when
    # set (so a write-heavy workload's longer drain actually reaches podman);
    # otherwise stays the historical 10s (systemd default TimeoutStopSec=30).
    resources = container.get("resources", {})
    stop_grace = resources.get("timeout_stop_sec")
    try:
        podman_stop_timeout = (
            max(1, int(stop_grace) - 5) if stop_grace is not None else 10
        )
    except (TypeError, ValueError):
        # timeout_stop_sec given as a systemd timespan (e.g. "2min"); fall back
        # to the safe default rather than guessing a seconds value.
        podman_stop_timeout = 10

    lines.extend([
        "",
        f"ExecStop=/usr/bin/podman stop -t {podman_stop_timeout} {container_name_quoted}",
        "",
        "StandardOutput=journal",
        "StandardError=journal",
        "",
        "Restart=on-failure",
        "RestartSec=5s",
        "",
        "# Filesystem hardening: restrict writes to workload home + podman runtime",
        "ProtectSystem=strict",
        f'ReadWritePaths="{home_dir}" /run/user/{uid}',
        "PrivateTmp=yes",
        "# Socket-family hardening: deny AF_ALG (CVE-2026-31431 LPE vector) and",
        "# AF_PACKET tree-wide, covering the host _wl- podman process too. Deny-list",
        "# (~) keeps AF_INET/AF_UNIX/AF_NETLINK for pasta networking + getaddrinfo.",
        "RestrictAddressFamilies=~AF_ALG AF_PACKET",
    ])

    if "timeout_start_sec" not in resources:
        lines.append("TimeoutStartSec=300")
    if "timeout_stop_sec" not in resources:
        lines.append("TimeoutStopSec=30")

    # [Install] only on the workload-level service: in single mode that's
    # *this* unit (it gets the multi-user.target.wants symlink); in
    # multi-container mode the per-container services are pulled in by the
    # umbrella's Requires= and never get their own wants symlink, so an
    # [Install] block here is dead text.
    if mode == "single":
        lines.extend([
            "",
            "[Install]",
            "WantedBy=multi-user.target",
            "",
        ])
    else:
        lines.append("")

    return "\n".join(lines)


def generate_health_units(name, container_name, health):
    """System-manager healthcheck oneshot + timer for a --cgroups=split
    container, returned as (svc_name, svc_text, timer_name, timer_text).

    podman's own healthcheck timer runs from the user manager and can't exec
    into a split container, so we drive `podman healthcheck run` (and the
    on-failure action) from the system manager via workload-healthcheck. The
    workload/container unit Wants= the timer (see generate_system_service), and
    the timer BindsTo= it so it stops with the workload.
    """
    interval = health.get("interval", "30s")
    start_period = health.get("start_period", interval)
    on_failure = health.get("on_failure", "none")
    unit = f"{container_name}.service"

    svc = "\n".join([
        f"# Healthcheck runner for {container_name}",
        "# Generated by workload-generate",
        "",
        "[Unit]",
        f"Description=Healthcheck for {container_name}",
        f"BindsTo={unit}",
        f"After={unit}",
        "",
        "[Service]",
        "Type=oneshot",
        # Runs as root: workload-healthcheck creates the uid-owned cgroup leaf,
        # drops privileges to run the probe, and (on failure) acts on the unit.
        f"ExecStart=/usr/libexec/workloadctl/workload-healthcheck "
        f"{name} {container_name} {unit} {on_failure}",
        "StandardOutput=journal",
        "StandardError=journal",
        "",
    ])

    timer = "\n".join([
        f"# Healthcheck timer for {container_name}",
        "# Generated by workload-generate",
        "",
        "[Unit]",
        f"Description=Healthcheck timer for {container_name}",
        f"BindsTo={unit}",
        f"After={unit}",
        "",
        "[Timer]",
        # First probe one start-period after the timer activates, then every
        # interval. Matches podman's --health-start-period / --health-interval.
        f"OnActiveSec={start_period}",
        f"OnUnitActiveSec={interval}",
        "AccuracySec=1s",
        "",
        "[Install]",
        "WantedBy=timers.target",
        "",
    ])

    return (f"{container_name}-health.service", svc,
            f"{container_name}-health.timer", timer)


def generate_sysuser_config_vm(config, user_name, uid):
    """Like generate_sysuser_config but adds implicit kvm group membership."""
    name = config["workload"]["name"]
    home_dir = str(WORKLOADS_BASE / name)
    extra_groups = config.get("security", {}).get("extra_groups", [])

    lines = [
        f"# Workload user for {name} (VM)",
        f"u {user_name} {uid} \"{name} workload\" {home_dir}",
        f"m {user_name} kvm",
    ]
    for group in extra_groups:
        if group != "kvm":  # avoid duplicate
            lines.append(f"m {user_name} {group}")

    return "\n".join(lines) + "\n"


def generate_virtiofs_service(name: str, tag: str, host_path: str, user_name: str, uid: int) -> str:
    """Generate a virtiofsd sidecar service for one virtiofs volume.

    Note: the runtime socket directory (/run/workload-vm/{name}/) is owned by
    the main VM service (RuntimeDirectory + RuntimeDirectoryPreserve). Sidecars
    must not declare RuntimeDirectory or they would refcount-cleanup the dir
    on sidecar stop and yank the VM's qmp/console sockets out from under it.
    """
    socket_path = f"/run/workload-vm/{name}/virtiofs-{tag}.sock"
    home_dir = str(WORKLOADS_BASE / name)

    return "\n".join([
        f"# virtiofsd sidecar for {name}/{tag}",
        "# Generated by workload-generate",
        "",
        "[Unit]",
        f"Description=virtiofsd for {name}/{tag}",
        f"Requires=workload-{name}-setup.service workload-{name}.service",
        f"After=workload-{name}-setup.service",
        f"Before=workload-{name}.service",
        f"PartOf=workload-{name}.service",
        "",
        "[Service]",
        # Type=exec: systemd marks the service active once virtiofsd exec()s,
        # without waiting for sd_notify. virtiofsd 1.x only sends READY after
        # QEMU connects, which deadlocks with Type=notify + Before=VM.service.
        "Type=exec",
        # Run as root so virtiofsd can faithfully apply guest-requested uids
        # and gids on file/dir creation and chown. Unprivileged virtiofsd
        # squashes everything to its own uid, which breaks multi-user data
        # sharing inside the guest. --sandbox=chroot still confines the
        # daemon's view of the host filesystem; --socket-group lets the
        # unprivileged QEMU process connect.
        f'Environment="HOME={home_dir}"',
        f"ExecStart=/usr/libexec/virtiofsd "
        f"--socket-path={socket_path} "
        f"--socket-group={user_name} "
        f"--shared-dir={dq(host_path)} "
        f"--cache=auto --sandbox=chroot",
        # Wait for virtiofsd to create the socket before QEMU starts.
        # virtiofsd creates the socket before blocking on accept(), so this
        # resolves the ordering dependency without the sd_notify deadlock.
        f"ExecStartPost=/bin/sh -c 'until test -S {socket_path}; do sleep 0.1; done'",
        "StandardOutput=journal",
        "StandardError=journal",
        "",
    ])


def generate_vm_bridge_service() -> str:
    """Generate the shared workload-bridge.service that provisions the managed
    VM bridge (VM_BRIDGE_NAME).

    Emitted only for VMs on the default managed bridge; VMs pinned to a
    user-provided bridge (e.g. br0) skip this service entirely. The managed
    bridge name is reserved for workloadctl, so it is *always* fully managed
    here — create-or-adopt the isolated VM_BRIDGE_SUBNET network, set up
    nftables NAT masquerade, and run dnsmasq for DHCP. Every step is
    idempotent: a leftover bridge from a failed/previous run is re-adopted
    (not mistaken for foreign), and a service restart never demotes it.
    """
    bridge = VM_BRIDGE_NAME
    bridge_cidr = f"{VM_BRIDGE_IP}/{VM_BRIDGE_SUBNET.rsplit('/', 1)[1]}"
    return "\n".join([
        "# Shared VM bridge service for workloadctl VM workloads",
        "# Generated by workload-generate — identical for all VMs; last write wins.",
        "",
        "[Unit]",
        f"Description=workloadctl VM bridge ({bridge})",
        "After=network.target",
        "",
        "[Service]",
        "Type=oneshot",
        "RemainAfterExit=yes",
        # systemd creates and owns /run/workload-vm; refcounted across services.
        "RuntimeDirectory=workload-vm",
        "RuntimeDirectoryPreserve=yes",
        "StateDirectory=workload-vm",
        # Create-or-adopt the managed bridge, idempotently. set -e surfaces a
        # genuine failure (vs the benign "already exists"); `ip addr replace`
        # and an unconditional `up` make restarts and leftover-bridge re-runs
        # safe. The marker means "we manage this bridge" and gates the
        # dnsmasq/NAT steps and teardown below.
        "ExecStartPre=/bin/bash -c 'set -e; "
        f"ip link show {bridge} &>/dev/null || ip link add {bridge} type bridge; "
        f"ip addr replace {bridge_cidr} dev {bridge}; "
        f"ip link set {bridge} up; "
        "touch /run/workload-vm/bridge-managed'",
        # Allow VMs to use the bridge via qemu-bridge-helper (always).
        "ExecStartPre=/bin/bash -c '"
        "install -d /etc/qemu && "
        f"grep -qxF \"allow {bridge}\" /etc/qemu/bridge.conf 2>/dev/null || "
        f"echo \"allow {bridge}\" >> /etc/qemu/bridge.conf'",
        # NAT masquerade — managed bridge only.  We own the workload_nat table
        # entirely: delete-then-recreate on each start avoids duplicate rules.
        "ExecStartPre=/bin/bash -c '"
        "[ -f /run/workload-vm/bridge-managed ] || exit 0; "
        "sysctl -q net.ipv4.ip_forward=1 && "
        "(nft delete table ip workload_nat 2>/dev/null; true) && "
        "nft add table ip workload_nat && "
        "nft add chain ip workload_nat postrouting "
        "\"{ type nat hook postrouting priority 100; }\" && "
        "nft add rule ip workload_nat postrouting "
        f"ip saddr {VM_BRIDGE_SUBNET} ip daddr != {VM_BRIDGE_SUBNET} masquerade'",
        # If firewalld is active, put the bridge in the libvirt zone so DHCP/DNS
        # broadcasts from guests aren't rejected (no-op if firewalld absent).
        "ExecStartPre=/bin/bash -c '"
        "if systemctl is-active --quiet firewalld; then "
        f"firewall-cmd -q --zone=libvirt --add-interface={bridge} 2>/dev/null || "
        f"firewall-cmd -q --zone=libvirt --change-interface={bridge}; "
        "fi'",
        # dnsmasq DHCP — managed bridge only.  Daemonizes and writes its pidfile;
        # ExecStart exits 0 and RemainAfterExit keeps the service active.
        # --bind-dynamic (not --bind-interfaces): receives DHCP broadcasts from
        # 0.0.0.0 on the interface — the same approach libvirt uses.
        "ExecStart=/bin/bash -c '"
        "[ -f /run/workload-vm/bridge-managed ] || exit 0; "
        "/usr/sbin/dnsmasq "
        f"--pid-file={VM_DHCP_PIDFILE} "
        "--conf-file=/dev/null "
        f"--interface={bridge} "
        "--except-interface=lo "
        "--bind-dynamic "
        f"--dhcp-range={VM_DHCP_RANGE} "
        f"--dhcp-leasefile={VM_DHCP_LEASE_FILE} "
        "--no-resolv "
        "--server=1.1.1.1 "
        "--server=8.8.8.8 "
        "--log-dhcp'",
        # Stop: kill dnsmasq if we started it.
        f"ExecStop=/bin/bash -c '"
        "[ -f /run/workload-vm/bridge-managed ] || exit 0; "
        f"[ -f {VM_DHCP_PIDFILE} ] && "
        f"kill $(cat {VM_DHCP_PIDFILE}) 2>/dev/null || true'",
        # Stop: remove NAT rules if we added them.
        "ExecStop=/bin/bash -c '"
        "[ -f /run/workload-vm/bridge-managed ] || exit 0; "
        "nft delete table ip workload_nat 2>/dev/null || true'",
        # Stop: tear down the bridge we manage.
        "ExecStop=/bin/bash -c '"
        "[ -f /run/workload-vm/bridge-managed ] || exit 0; "
        f"ip link set {bridge} down 2>/dev/null; ip link del {bridge} 2>/dev/null || true'",
        "StandardOutput=journal",
        "StandardError=journal",
        "",
        "[Install]",
        "WantedBy=multi-user.target",
        "",
    ])


def generate_vm_build_service(config, user_name) -> str:
    """Generate the oneshot build service that creates system.qcow2."""
    name = config["workload"]["name"]
    home_dir = str(WORKLOADS_BASE / name)
    system_disk = f"{home_dir}/system.qcow2"
    setup_service = f"workload-{name}-setup.service"

    return "\n".join([
        f"# Build service for {name} VM workload",
        "# Generated by workload-generate",
        "",
        "[Unit]",
        f"Description=Build system disk for {name} VM",
        f"Requires={setup_service}",
        f"After={setup_service}",
        # Skip rebuild if system disk already exists — update explicitly removes it
        f"ConditionPathExists=!{system_disk}",
        "",
        "[Service]",
        "Type=oneshot",
        "RemainAfterExit=yes",
        "TimeoutStartSec=3600",
        f"ExecStart=/usr/libexec/workloadctl/workload-vm-build-disk {name}",
        "StandardOutput=journal",
        "StandardError=journal",
        "",
    ])


def generate_vm_service(config, user_name: str, uid: int) -> str:
    """Generate the main VM service (QEMU, Type=notify via workload-vm-notify)."""
    name = config["workload"]["name"]
    vm_cfg = config.get("vm", {})
    home_dir = str(WORKLOADS_BASE / name)
    socket_dir = f"/run/workload-vm/{name}"

    # Always pass QEMU an integer number of MiB so memfd's "size=NM" stays valid.
    memory_mib = parse_memory_mib(vm_cfg.get("memory", 2048))
    vcpus = vm_cfg.get("vcpus", 2)
    slice_name = config.get("resources", {}).get("slice", "workloads.slice")

    ovmf_code = find_ovmf_code() or "/usr/share/edk2/ovmf/OVMF_CODE.fd"
    mac = vm_mac_address(name)

    # Parse virtiofs volumes
    volumes = vm_cfg.get("volumes", [])
    virtiofs_tags = []
    for i, vol_spec in enumerate(volumes):
        _host, guest_path, _opts = parse_volume_spec(vol_spec)
        virtiofs_tags.append(virtiofs_tag(guest_path, i))

    # Bridge: default to _workload-br (workloadctl-managed via workload-bridge.service).
    # Any other value names an existing host bridge the user provisions
    # separately (e.g. br0 onto the LAN) — we don't generate a bridge service
    # in that case and don't add it as a dependency.
    bridge_name = vm_cfg.get("network", {}).get("bridge", VM_BRIDGE_NAME)
    uses_managed_bridge = (bridge_name == VM_BRIDGE_NAME)

    # Service dependencies
    prereqs = [
        f"workload-{name}-setup.service",
        f"workload-{name}-build.service",
    ]
    if uses_managed_bridge:
        prereqs.append("workload-bridge.service")
    for tag in virtiofs_tags:
        prereqs.append(f"workload-{name}-virtiofs-{tag}.service")
    prereqs_str = " ".join(prereqs)

    has_data_disk = bool(vm_cfg.get("data_disk_size"))

    # QEMU arguments — built here so the unit file is self-documenting
    qemu_args = [
        "/usr/bin/qemu-system-x86_64",
        "-machine q35,accel=kvm",
        "-cpu host",
    ]

    # Memory: use shared memfd backend when virtiofs is in use
    if virtiofs_tags:
        qemu_args += [
            f"-object memory-backend-memfd,id=mem,size={memory_mib}M,share=on",
            f"-m {memory_mib}",
            "-numa node,memdev=mem",
        ]
    else:
        qemu_args.append(f"-m {memory_mib}")

    qemu_args.append(f"-smp {vcpus}")

    # UEFI
    qemu_args += [
        f"-drive if=pflash,format=raw,readonly=on,file={ovmf_code}",
        f"-drive if=pflash,format=raw,file={home_dir}/nvram.fd",
    ]

    # Disks
    qemu_args.append(
        f"-drive file={home_dir}/system.qcow2,if=virtio,format=qcow2,id=system"
    )
    if has_data_disk:
        qemu_args.append(
            f"-drive file={home_dir}/data.qcow2,if=virtio,format=qcow2,id=data"
        )

    # Cloud-init seed (always present; removed from command after first boot
    # would require rebuild — keep it; cloud-init runs once per instance-id)
    qemu_args.append(
        f"-drive file={home_dir}/cloud-init.iso,if=virtio,format=raw,readonly=on,media=cdrom,id=cloudinit"
    )

    # Network (bridge via qemu-bridge-helper)
    qemu_args += [
        f"-netdev bridge,id=net0,br={bridge_name}",
        f"-device virtio-net-pci,netdev=net0,mac={mac}",
    ]

    # virtiofs chardev + device per volume
    for tag in virtiofs_tags:
        sock = f"{socket_dir}/virtiofs-{tag}.sock"
        qemu_args += [
            f"-chardev socket,id=chr-vfs-{tag},path={sock}",
            f"-device vhost-user-fs-pci,chardev=chr-vfs-{tag},tag={tag}",
        ]

    # Memory balloon — allows host to reclaim idle guest memory
    if vm_cfg.get("balloon", True):
        qemu_args.append("-device virtio-balloon-pci")

    # Console + QMP + display.
    # Two QMP monitors: qmp.sock is the control channel (notify/info/ExecStop
    # system_powerdown); qmp-metrics.sock is a dedicated read-only channel for
    # the always-on Prometheus exporter. A single QMP monitor serves one client
    # at a time, so giving the exporter its own monitor keeps a 15s scrape from
    # ever blocking the shutdown powerdown command (which would otherwise time
    # out into a SIGKILL / unclean shutdown).
    qemu_args += [
        f"-serial unix:{socket_dir}/console.sock,server=on,wait=off",
        f"-qmp unix:{socket_dir}/qmp.sock,server=on,wait=off",
        f"-qmp unix:{socket_dir}/qmp-metrics.sock,server=on,wait=off",
        "-nographic",
        "-no-reboot",
        f"-name {name}",
    ]

    # Resource directives
    resources = config.get("resources", {})
    resource_lines = []
    if "memory_max" in resources:
        resource_lines.append(f"MemoryMax={resources['memory_max']}")
    if "cpu_quota" in resources:
        resource_lines.append(f"CPUQuota={resources['cpu_quota']}")
    if "cpu_weight" in resources:
        resource_lines.append(f"CPUWeight={resources['cpu_weight']}")

    # Build ExecStart: workload-vm-notify wraps QEMU
    qemu_cmd = " \\\n        ".join(qemu_args)

    lines = [
        f"# VM workload service for {name}",
        "# Generated by workload-generate",
        "",
        "[Unit]",
        f"Description={name} VM workload",
        f"Requires={prereqs_str}",
        f"After={prereqs_str}",
        "StartLimitIntervalSec=300",
        "StartLimitBurst=3",
        "",
        "[Service]",
        "Type=notify",
        "NotifyAccess=all",
        f"Slice={slice_name}",
        f"User={user_name}",
        f"Group={user_name}",
        f'Environment="HOME={home_dir}"',
        f"EnvironmentFile=-/run/workload-env/workload-{name}.env",
        # Own the per-VM socket dir; preserve across restarts so virtiofsd
        # sidecars (PartOf=) and QEMU's qmp/console sockets aren't yanked.
        f"RuntimeDirectory=workload-vm/{name}",
        "RuntimeDirectoryMode=0750",
        "RuntimeDirectoryPreserve=yes",
        "",
    ]

    if resource_lines:
        lines += resource_lines
        lines.append("")

    # Restart policy. Default "always" because QEMU runs with -no-reboot: a
    # guest reboot makes QEMU exit 0, which Restart=on-failure treats as success
    # and never brings the VM back (e.g. the first-boot kernel-upgrade reboot
    # would leave the VM down). "always" turns a guest reboot into a fresh QEMU
    # process; StartLimitBurst above bounds a boot-loop. An explicit
    # `workloadctl stop`/`disable` goes through ExecStop and is never
    # auto-restarted regardless of this. "on-failure" keeps the old behavior.
    # "on-reboot" (restart only on a guest reboot, honoring an in-guest
    # poweroff) needs reason-aware exit handling in workload-vm-notify that
    # isn't implemented yet, so it falls back to "always" with a warning.
    restart_mode = vm_cfg.get("restart", "always")
    if restart_mode == "on-failure":
        restart_directive = "on-failure"
    else:
        if restart_mode == "on-reboot":
            log_msg(
                f"WARNING: [vm].restart='on-reboot' for {name} is not implemented "
                "yet; using 'always'. (Reason-aware restart needs work in "
                "workload-vm-notify.)",
                level="warning",
            )
        restart_directive = "always"

    lines += [
        f"ExecStart=/usr/libexec/workloadctl/workload-vm-notify {dq(name)} \\",
        f"    {qemu_cmd}",
        "",
        # Graceful shutdown: ACPI power-off, then *block* until the guest is
        # gone (workload-vm-shutdown waits up to 80s). ExecStop must block —
        # systemd only enters its kill phase after it returns, so a
        # fire-and-forget powerdown would let SIGTERM hard-kill QEMU within
        # milliseconds (unclean power-off / data corruption). TimeoutStopSec
        # below (90s) is the backstop if the guest ignores ACPI.
        f"ExecStop=/usr/libexec/workloadctl/workload-vm-shutdown {dq(name)}",
        "",
        "StandardOutput=journal",
        "StandardError=journal",
        "",
        f"Restart={restart_directive}",
        "RestartSec=10s",
        # Generous start timeout: guest may be slow on first boot
        "TimeoutStartSec=300",
        "TimeoutStopSec=90",
        "",
        "[Install]",
        "WantedBy=multi-user.target",
        "",
    ]

    return "\n".join(lines)


def generate_vm_workload(config, user_name: str, uid: int):
    """Emit all unit files for a VM workload. Returns list of written paths."""
    name = config["workload"]["name"]
    home_dir = str(WORKLOADS_BASE / name)
    vm_cfg = config.get("vm", {})
    volumes = vm_cfg.get("volumes", [])

    written = []

    # Sysusers (with implicit kvm)
    sysuser_content = generate_sysuser_config_vm(config, user_name, uid)
    sysuser_file = SYSUSERS_DIR / f"workload-{name}.conf"
    sysuser_file.write_text(sysuser_content)
    log_msg(f"  Created VM sysusers config (implicit kvm group)")

    # Setup service (same as container)
    setup_content = generate_setup_service(config, user_name)
    (SERVICES_DIR / f"workload-{name}-setup.service").write_text(setup_content)
    log_msg(f"  Created setup service")

    # Only emit the shared workload-bridge.service when this VM actually uses
    # _workload-br (the default). Workloads bridged onto a user-provided bridge
    # (e.g. br0 onto the LAN) shouldn't drag the _workload-br setup along with them.
    bridge_name = vm_cfg.get("network", {}).get("bridge", VM_BRIDGE_NAME)
    wants_dir = SERVICES_DIR / "multi-user.target.wants"
    wants_dir.mkdir(parents=True, exist_ok=True)
    if bridge_name == VM_BRIDGE_NAME:
        bridge_content = generate_vm_bridge_service()
        (SERVICES_DIR / "workload-bridge.service").write_text(bridge_content)
        log_msg(f"  Created workload-bridge.service")

        bridge_link = wants_dir / "workload-bridge.service"
        if bridge_link.exists() or bridge_link.is_symlink():
            bridge_link.unlink()
        bridge_link.symlink_to("../workload-bridge.service")
    else:
        log_msg(f"  Bridge {bridge_name!r} is user-provided; skipping workload-bridge.service")

    # virtiofsd sidecar services
    for i, vol_spec in enumerate(volumes):
        host_raw, guest_path, _opts = parse_volume_spec(vol_spec)
        # Expand ./ relative to workload home
        if host_raw.startswith("./"):
            host_path = home_dir + "/" + host_raw[2:]
        else:
            host_path = host_raw
        tag = virtiofs_tag(guest_path, i)
        vfs_content = generate_virtiofs_service(name, tag, host_path, user_name, uid)
        (SERVICES_DIR / f"workload-{name}-virtiofs-{tag}.service").write_text(vfs_content)
        log_msg(f"  Created virtiofsd service for tag '{tag}'")

    # Build service
    build_content = generate_vm_build_service(config, user_name)
    (SERVICES_DIR / f"workload-{name}-build.service").write_text(build_content)
    log_msg(f"  Created build service")

    # Main VM service
    vm_service_content = generate_vm_service(config, user_name, uid)
    (SERVICES_DIR / f"workload-{name}.service").write_text(vm_service_content)
    log_msg(f"  Created VM service")

    # Wants symlink for main service
    symlink_path = wants_dir / f"workload-{name}.service"
    if symlink_path.exists() or symlink_path.is_symlink():
        symlink_path.unlink()
    symlink_path.symlink_to(f"../workload-{name}.service")

    return name


def main():
    """Main generator logic."""
    log_msg(f"Checking {WORKLOAD_CONFIG_DIR}")
    if not WORKLOAD_CONFIG_DIR.exists():
        log_msg("Workload config dir does not exist, exiting")
        return

    # Ensure output directory exists
    SERVICES_DIR.mkdir(parents=True, exist_ok=True)

    # Names of workloads whose unit files were successfully written this run.
    # Used below to explicitly enqueue a start job for each — see the block
    # at the end of main() for why the wants symlinks alone don't suffice.
    written_workloads = []

    # Process each workload config
    config_files = list(WORKLOAD_CONFIG_DIR.glob("*.toml"))
    log_msg(f"Found {len(config_files)} config files")

    for config_file in config_files:
        try:
            log_msg(f"Processing {config_file}")
            with open(config_file, "rb") as f:
                config = tomllib.load(f)

            enabled = config.get("workload", {}).get("enabled", False)
            if not enabled:
                log_msg(f"  Skipping {config_file} (disabled)")
                continue

            if "workload" not in config or "name" not in config.get("workload", {}):
                log_msg(f"ERROR: {config_file} missing required workload.name field", level="err")
                continue

            name = config["workload"]["name"]

            errors = validate_workload_config(config)
            if errors:
                for e in errors:
                    log_msg(f"  ERROR: {name}: {e}", level="err")
                continue

            kind = infer_workload_kind(config)
            user_name = workload_username(name)
            log_msg(f"  Processing {kind} workload {name}")

            # Look up existing user to pin UID; if user doesn't exist yet,
            # allocate the next free UID in the workload range.
            try:
                uid = pwd.getpwnam(user_name).pw_uid
                log_msg(f"  User {user_name} exists with UID {uid}")
            except KeyError:
                uid = get_next_uid()
                log_msg(f"  User {user_name} not found; allocated UID {uid}")

            if kind == "vm":
                generate_vm_workload(config, user_name, uid)
                written_workloads.append(name)
                continue

            # --- container path ---
            mode = infer_workload_mode(config)

            sysuser_content = generate_sysuser_config(config, user_name, uid)
            sysuser_file = SYSUSERS_DIR / f"workload-{name}.conf"
            sysuser_file.write_text(sysuser_content)
            log_msg(f"  Created sysusers config" + (f" with UID {uid}" if uid else " (range 10000-52948)"))

            # Setup service: creates user (runs as root, no User= directive)
            setup_content = generate_setup_service(config, user_name)
            setup_file = SERVICES_DIR / f"workload-{name}-setup.service"
            setup_file.write_text(setup_content)
            log_msg(f"  Created setup service at {setup_file}")

            # Main service: Requires+After setup service so User= is resolvable
            containers = normalize_containers(config)

            if mode == "single":
                service_content = generate_system_service(config, containers[0], user_name, uid)
                if service_content is None:
                    log_msg(f"  Skipping {name} due to config errors", level="err")
                    continue
                service_file = SERVICES_DIR / f"workload-{name}.service"
                service_file.write_text(service_content)
                log_msg(f"  Created system service at {service_file}")
                # split-mode healthcheck timer (podman's own --user timer can't
                # exec into a split container).
                h = containers[0].get("container", {}).get("health", {})
                if h.get("cmd"):
                    sn, st_, tn, tt = generate_health_units(name, f"workload-{name}", h)
                    (SERVICES_DIR / sn).write_text(st_)
                    (SERVICES_DIR / tn).write_text(tt)
                    log_msg(f"  Created healthcheck timer {tn}")
            else:
                # Network helper service: pod-create (pod mode) or
                # network-create (bridge mode).
                if mode == "pod":
                    helper = generate_pod_service(config, user_name, uid)
                    (SERVICES_DIR / f"workload-{name}-pod.service").write_text(helper)
                else:  # bridge
                    if config.get("network", {}).get("ports"):
                        log_msg(f"  WARNING: {name}: workload-level [network].ports "
                                f"is ignored in bridge mode; publish ports per "
                                f"container under [containers.network]",
                                level="warning")
                    helper = generate_net_service(config, user_name, uid)
                    (SERVICES_DIR / f"workload-{name}-net.service").write_text(helper)
                # Per-container services
                for c in containers:
                    sc = generate_system_service(config, c, user_name, uid, mode=mode)
                    if sc is None:
                        log_msg(f"  Skipping container {c.get('name')} due to config errors", level="err")
                        continue
                    (SERVICES_DIR / f"workload-{name}-{c['name']}.service").write_text(sc)
                    # bridge-mode containers run under --cgroups=split too, so
                    # each gets its own system-manager healthcheck timer. Pod
                    # mode keeps podman's working --user timer (no split).
                    h = c.get("container", {}).get("health", {})
                    if mode == "bridge" and h.get("cmd"):
                        cn = f"workload-{name}-{c['name']}"
                        sn, st_, tn, tt = generate_health_units(name, cn, h)
                        (SERVICES_DIR / sn).write_text(st_)
                        (SERVICES_DIR / tn).write_text(tt)
                        log_msg(f"  Created healthcheck timer {tn}")
                # Umbrella
                slice_name = config.get("resources", {}).get("slice", "workloads.slice")
                umbrella = generate_umbrella_service(
                    name, [c["name"] for c in containers], slice_name, mode=mode
                )
                (SERVICES_DIR / f"workload-{name}.service").write_text(umbrella)
                log_msg(f"  Created {mode}-mode units for {name} ({len(containers)} containers)")

            # Create symlink for auto-start (equivalent to systemctl enable)
            wants_dir = SERVICES_DIR / "multi-user.target.wants"
            wants_dir.mkdir(parents=True, exist_ok=True)
            symlink_path = wants_dir / f"workload-{name}.service"

            if symlink_path.exists() or symlink_path.is_symlink():
                symlink_path.unlink()
            symlink_path.symlink_to(f"../workload-{name}.service")
            log_msg("  Enabled service for auto-start")

            written_workloads.append(name)

        except Exception as e:
            # Log errors but don't fail the boot
            log_msg(f"ERROR processing {config_file}: {e}", level="err")
            log_msg(traceback.format_exc(), level="err")
            continue

    # Explicitly enqueue a start job for each workload whose unit file we
    # just wrote.
    #
    # Why this is necessary: the wants symlinks created above look like they
    # should be enough, but they aren't. systemd builds the boot transaction
    # for default.target (= multi-user.target) once at startup, resolving
    # dependencies from the unit files it knows about AT THAT MOMENT. When
    # this script runs (from workload-generate.service, After=sysinit.target
    # Before=basic.target), multi-user.target's transaction has already been
    # built — and it didn't include any workload services, because those
    # unit files didn't exist yet. daemon-reload updates systemd's in-memory
    # view of unit files, but target .wants/ directories are NOT re-scanned
    # for already-enqueued targets. The symlinks are load-bearing for a
    # subsequent boot cycle (cosmetic "enabled-runtime" in `systemctl is-
    # enabled`, and semantically meaningful if the architecture ever changes)
    # but do nothing for this boot. An explicit `systemctl start` creates
    # a new job and merges it into systemd's running job queue regardless
    # of target transaction state, which is exactly what we need.
    #
    # --no-block: enqueue the job and return immediately. We must not wait
    # for container startup from inside an early-boot oneshot service —
    # that would delay basic.target until every container is up, and would
    # risk deadlock if any workload transitively depends on something
    # downstream of basic.target. `systemctl start` on an already-active
    # unit is a no-op, so re-runs of this script (post-boot config edits
    # via `workloadctl enable` / edit / etc.) are safe: running workloads
    # are not disturbed, newly-written ones are started from cold.
    #
    # Gated on SERVICES_DIR being the live systemd directory so test runs
    # (which pass a tmp dir as argv[1]) never touch the host's systemd.
    is_live = SERVICES_DIR == Path("/run/systemd/system")
    if is_live and written_workloads:
        import subprocess
        try:
            subprocess.run(
                ["systemctl", "daemon-reload"],
                check=False,
                timeout=30,
            )
        except Exception as e:
            log_msg(f"daemon-reload failed: {e}", level="warning")

        for name in written_workloads:
            try:
                subprocess.run(
                    ["systemctl", "start", "--no-block",
                     f"workload-{name}.service"],
                    check=False,
                    timeout=30,
                )
                log_msg(f"  Enqueued start for workload-{name}.service")
            except Exception as e:
                log_msg(f"  Failed to enqueue start for workload-{name}: {e}",
                        level="warning")


if __name__ == "__main__":
    try:
        log_msg("Starting rootless workload generator", level="notice")
        main()
        log_msg("Generator completed successfully", level="notice")
    except Exception as e:
        # CRITICAL: Always exit 0, even on catastrophic failure
        # Generators must never block boot - log the error and let the system come up
        log_msg(f"FATAL ERROR: {e}", level="err")
        log_msg(traceback.format_exc(), level="err")
        log_msg("Generator failed but exiting 0 to allow boot to continue", level="err")

    # Always exit successfully - workload failures should not prevent system boot
    sys.exit(0)
