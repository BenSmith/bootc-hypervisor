# agent-broker configuration.
#
# The upstream set of a broker instance is fixed here and never taken from a
# request. That is the security property, and it is now a SET rather than a
# single value: the profile table is keyed by (workload, Host), so a workload
# may hold several credentials for several providers. What did not change is
# that the caller chooses none of it -- a `Host` with no table entry below is
# refused outright, and a recognised one selects an upstream, a port and a
# credential all written here at start.

# Bind the loopback address derived from this workload's own uid. REQUIRED, and
# deliberately not defaulted: an instance left on 127.0.0.1 would sit where
# every other workload's inspector also dials. 0.0.0.0 is refused by name. On a
# host managed by workloadctl this file is generated and this line is filled in
# for you; see docs/agent-broker.md §7.
listen_address = "127.129.0.3"
listen_port = 8081

# --- defaults, inherited by every host entry below -------------------------
#
# All four are optional. A host entry that overrides none of them uses these; a
# host entry that ends up with no `upstream` or no `credential` from either
# level is refused at start.

# `upstream` must be an https:// origin and MUST NOT carry a path. A base path
# would be prepended to every forwarded request, rewriting the path the
# inspector's [[vm.network.policy]] `paths` patterns admitted -- so the two
# layers would disagree about what request was made, and the one holding the
# credential would win.
upstream = "https://api.anthropic.com"

# Name of the systemd credential holding the real API key. At runtime the
# broker reads $CREDENTIALS_DIRECTORY/<credential>, and it needs a matching
# LoadCredentialEncrypted= line in the unit.
credential = "anthropic-api-key"

# How the credential is attached to outbound requests. Whatever the caller sent
# under this header is DISCARDED and replaced -- which is what makes the guest's
# placeholder work, and what made a forged one useless before placeholders
# existed.
#   Anthropic:  auth_header = "x-api-key",       auth_format = "{secret}"
#   OpenAI:     auth_header = "Authorization",   auth_format = "Bearer {secret}"
#   Gemini:     auth_header = "x-goog-api-key",  auth_format = "{secret}"
auth_header = "x-api-key"
auth_format = "{secret}"

# Optional. Serve HTTPS to the guest for agents that refuse plaintext
# credentials. One certificate for one hostname, signed by a private CA that
# the guest trusts. Leave both unset to serve plain HTTP.
# tls_cert = "/etc/agent-broker/broker.crt"
# tls_key  = "/etc/agent-broker/broker.key"

# Timeouts, seconds. read_timeout must tolerate a long idle gap between
# streamed tokens; connect_timeout should stay short.
connect_timeout = 15.0
read_timeout = 900.0

# `allow_unknown_callers` USED TO BE HERE and is gone. It named a default
# profile for a caller the config did not enumerate, which made sense when one
# host-wide broker fronted guests an operator had not finished listing. An
# instance serves one workload now and its config is generated from that
# workload's own [[vm.network.credential]] blocks, so an unenumerated caller is
# a caller that should not be here -- and the key would have been the one switch
# that turns off the uid check, on the component whose whole job is the uid
# check. A file still carrying it is refused rather than defaulted.

# --- sandboxes and their hosts ---------------------------------------------
#
# Keyed by WORKLOAD NAME, then by HOST. The broker resolves the caller by the
# uid owning the far end of the connection -- assigned by the host, unforgeable
# from inside a guest -- and looks up `_wl-<name>` from it. The second half of
# the key is the request's `Host`, matched lowercased and without a port.
#
# NEITHER DIMENSION HAS A DEFAULT. An unlisted workload gets 403, and so does a
# listed workload asking for a host it has no entry for. That is the difference
# from the pre-rung-6 shape, where a caller that reached the broker at all
# reached its one upstream with its one credential.
#
# Each host entry inherits the settings above and may override any of them.

[sandboxes.agent-scratch.hosts."api.anthropic.com"]
credential = "anthropic-cheap-key"

# `placeholder`, optional, and the broker never uses it to serve a request --
# it discards whatever arrived and sets its own header regardless. It is here
# for one startup check: if it is byte-identical to the decrypted credential,
# a real provider key has been pasted into a plain-text workload.toml, and the
# broker refuses to start rather than let that sit unnoticed.
[sandboxes.agent-review.hosts."api.anthropic.com"]
placeholder = "sk-ant-api00-000000000000000000PLACEHOLDER0000000000"

# One workload, two providers -- the shape the (workload, Host) key exists for.
# [sandboxes.agent-review.hosts."api.github.com"]
# upstream = "https://api.github.com"
# credential = "github-token"
# auth_header = "Authorization"
# auth_format = "Bearer {secret}"

# --- host wiring, for reference -------------------------------------------
#
# Guests reach this broker through a per-uid destination rewrite, the same
# mechanism that steers each workload to its own filtering proxy: every guest is
# handed one fixed advertised endpoint, and the host translates it per uid to
# the real listener. A workload with no map entry gets no translation and
# nothing is listening where it dialled, so cross-sandbox access is
# structurally unavailable rather than denied by a rule. That map is
# workloadctl's to maintain: a `workload_broker` table, keyed on uid, with an
# element added per workload that sets `broker = true`. See docs/agent-broker.md §7.
#
# The address and port above must match what those elements carry. That is
# asserted by tests/test_vm_broker.py against lib/vm.py, but only for the
# defaults -- override them here and you are on your own, and a mismatch looks
# exactly like the broker being down.
#
# Guest environment (Node/Bun agents), from $WORKLOAD_BROKER_URL:
#
#   ANTHROPIC_BASE_URL=http://192.0.2.1:8081
#   NODE_EXTRA_CA_CERTS=/etc/ssl/certs/broker-ca.pem   # only if serving HTTPS
#
# Guest environment (Python agents):
#
#   base_url in the provider config
#   SSL_CERT_FILE=/etc/ssl/certs/broker-bundle.pem     # only if serving HTTPS
#
# NOTE: NODE_EXTRA_CA_CERTS *appends* to the runtime's bundled roots.
# SSL_CERT_FILE *replaces* the bundle, so broker-bundle.pem must be certifi's
# cacert.pem concatenated with the broker CA, or every other TLS call the agent
# makes will fail. docs/agent-broker.md §4.
