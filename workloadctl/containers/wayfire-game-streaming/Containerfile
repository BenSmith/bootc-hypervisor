    dnf install -y steam mesa-va-drivers-freeworld && \
    dnf clean all

# --- Sunshine ---
# Sunshine captures the wayfire display via wlr-screencopy and encodes with
# the GPU's hardware encoder. Encoder + adapter are detected at runtime from
# the visible /dev/dri/renderD* node's PCI vendor — see sunshine-prestart.
# This keeps the same image working on NVIDIA and AMD/Intel hosts; the only
# per-host setting is `gpu = ...` in the workload TOML.
# Pre-release RPM URL changes frequently — pass via build arg:
#   podman build --build-arg SUNSHINE_RPM_URL=https://... .

ARG SUNSHINE_RPM_URL=https://github.com/LizardByte/Sunshine/releases/download/v2026.403.124357/Sunshine-2026.403.124357-1.fc43.x86_64.rpm
RUN dnf install -y "${SUNSHINE_RPM_URL}" && \
    dnf clean all

# Sunshine system-wide defaults. The user can override in ~/.config/sunshine/.
# encoder + adapter_name are appended at startup by sunshine-prestart.
# output_name: wayfire headless virtual output (set by wlr-randr in autostart).
RUN mkdir -p /etc/sunshine && \
    cat > /etc/sunshine/sunshine.conf <<'CONF'
output_name=HEADLESS-1
origin_web_ui_allowed=wan
# Don't bake the cursor into the video frame; Moonlight renders it client-side.
capture_cursor=false
CONF

# --- Polkit stub ---
# Required for Steam's logind D-Bus PowerOff call (Power menu → Turn Off).
# polkitd cannot start in a rootless container (requires CAP_SYS_ADMIN for PID
# namespace introspection).

RUN cat > /usr/local/bin/polkit-stub <<'SCRIPT'
#!/usr/bin/python3
"""Polkit stub: grants login1 actions only (power off, reboot, suspend)."""
from gi.repository import Gio, GLib

IFACE_XML = """
<node>
  <interface name="org.freedesktop.PolicyKit1.Authority">
    <method name="CheckAuthorization">
      <arg type="(sa{sv})" name="subject"         direction="in"/>
      <arg type="s"        name="action_id"        direction="in"/>
      <arg type="a{ss}"    name="details"          direction="in"/>
      <arg type="u"        name="flags"            direction="in"/>
      <arg type="s"        name="cancellation_id"  direction="in"/>
      <arg type="(bba{ss})" name="result"          direction="out"/>
    </method>
  </interface>
</node>
"""

ALLOWED = ("org.freedesktop.login1.",)

def on_method_call(conn, sender, path, iface, method, params, invocation):
    if method == "CheckAuthorization":
        action_id = params.get_child_value(1).get_string()
        granted = any(action_id.startswith(p) for p in ALLOWED)
        invocation.return_value(GLib.Variant("((bba{ss}))", ((granted, False, {}),)))
    else:
        invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)

def on_bus_acquired(conn, name):
    info = Gio.DBusNodeInfo.new_for_xml(IFACE_XML)
    conn.register_object("/org/freedesktop/PolicyKit1/Authority",
                         info.interfaces[0], on_method_call, None, None)

loop = GLib.MainLoop()
Gio.bus_own_name(Gio.BusType.SYSTEM, "org.freedesktop.PolicyKit1",
                 Gio.BusNameOwnerFlags.NONE, on_bus_acquired, None, None)
loop.run()
SCRIPT

RUN cat > /etc/dbus-1/system.d/polkit-stub.conf <<'CONF'
<!DOCTYPE busconfig PUBLIC
 "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <policy user="root">
    <allow own="org.freedesktop.PolicyKit1"/>
  </policy>
</busconfig>
CONF

RUN cat > /usr/lib/systemd/system/polkit-stub.service <<'UNIT'
[Unit]
Description=Polkit stub (grants login1 actions only)
After=dbus.socket
Before=wayfire.service

[Service]
Type=simple
ExecStart=/usr/local/bin/polkit-stub
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT

RUN cat > /usr/share/dbus-1/system-services/org.freedesktop.PolicyKit1.service <<'CONF'
[D-BUS Service]
Name=org.freedesktop.PolicyKit1
Exec=/usr/local/bin/polkit-stub
User=root
SystemdService=polkit-stub.service
CONF

