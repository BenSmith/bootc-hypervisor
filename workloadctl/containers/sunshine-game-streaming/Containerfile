# --- Autostart ---
# Order: audio → virtual display resolution → waybar → sunshine → steam BPM
# Sunshine must start after labwc has created the Wayland socket.
# Steam runs in Big Picture (tenfoot) mode; the labwc desktop is always
# accessible by exiting or minimising Steam.

RUN cat > /etc/xdg/labwc/autostart <<'SH'
#!/bin/bash
export XDG_RUNTIME_DIR=/run/user/$(id -u)

# --- Display resolution ---
wlr-randr --output HEADLESS-1 --custom-mode 2560x1080@60Hz

# --- Audio ---
alsa_card=""
card_num=""
while IFS= read -r line; do
    n=$(echo "$line" | sed -n 's/^card \([0-9]*\):.*/\1/p')
    if [ -n "$n" ] && echo "$line" | grep -qi analog; then
        card_num="$n"
        alsa_card="hw:$card_num,0"
        break
    fi
done < <(aplay -l 2>/dev/null)

if [ -n "$alsa_card" ]; then
    mkdir -p ~/.config/pipewire/pipewire.conf.d
    cat > ~/.config/pipewire/pipewire.conf.d/10-alsa-sink.conf <<EOF
context.objects = [
    { factory = adapter
        args = {
            factory.name     = api.alsa.pcm.sink
            node.name        = "alsa-sink"
            node.description = "ALSA Analog Output"
            media.class      = "Audio/Sink"
            api.alsa.path    = "$alsa_card"
        }
    }
]
EOF
    pipewire &
    i=0
    until [ -S "$XDG_RUNTIME_DIR/pipewire-0" ]; do
        sleep 0.1; i=$((i+1))
        [ $i -ge 100 ] && break
    done
    wireplumber &
    pipewire-pulse &
    i=0
    until wpctl status >/dev/null 2>&1; do
        sleep 0.1; i=$((i+1))
        [ $i -ge 100 ] && break
    done
    [ -n "$card_num" ] && amixer -c "$card_num" sset Master 74% unmute >/dev/null 2>&1
fi

# --- Desktop chrome ---
swaybg -c '#2e3440' &
waybar &
mako &

# --- Steam Big Picture ---
# STEAM_DISABLE_BROWSER_SANDBOX: steamwebhelper's Chromium sandbox can't
#   nest inside the container's user namespace.
STEAM_DISABLE_BROWSER_SANDBOX=1 \
steam -tenfoot &
SH

