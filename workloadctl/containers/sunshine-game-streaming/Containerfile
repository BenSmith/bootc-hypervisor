# Headless Desktop + Sunshine Streaming
#
# labwc runs headlessly (WLR_BACKENDS=headless, no KMS/seatd/libinput).
# Input from Moonlight clients is injected by an in-container bridge that reads
# Sunshine's uinput passthrough devices and injects via Wayland virtual input
# protocols (zwlr_virtual_pointer_manager_v1 / zwp_virtual_keyboard_manager_v1).
# Sunshine captures the virtual display via wlr-screencopy, encodes with VAAPI
# on the AMD render node, and streams to Moonlight clients.
# Steam Big Picture is the default session; the full labwc desktop is always
# accessible by minimising/exiting Steam.
#
# Build:
#   sudo ./build.sh
#
# Run:
#   workload-ctl enable sunshine-game-streaming

FROM registry.fedoraproject.org/fedora:43

