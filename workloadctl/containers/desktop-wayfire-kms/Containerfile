FROM registry.fedoraproject.org/fedora:43

RUN dnf install --setopt=install_weak_deps=False --nodocs -y \
    adwaita-cursor-theme \
    adwaita-icon-theme \
    alsa-utils \
    bash-completion \
    dbus-daemon \
    fira-code-fonts \
    foot \
    grim \
    htop \
    imv \
    kanshi \
    libevdev \
    libinput \
    libseat \
    mako \
    mesa-dri-drivers \
    mesa-libEGL \
    mesa-libGL \
    mesa-libgbm \
    mesa-vulkan-drivers \
    nano \
    neovim \
    pipewire \
    pipewire-alsa \
    pipewire-pulseaudio \
    procps-ng \
    slurp \
    sudo \
    swappy \
    swayidle \
    swaylock \
    systemd \
    systemd-udev \
    util-linux \
    wayfire \
    wayfire-config-manager \
    wdisplays \
    wf-recorder \
    wf-shell \
    wireplumber \
    wl-clipboard \
    wlr-randr \
    wofi \
    xorg-x11-server-Xwayland \
    && dnf clean all

# Wayfire config
COPY --link --chmod=0644 wayfire.ini /etc/xdg/wayfire.ini
COPY --link --chmod=0644 foot.ini /etc/xdg/foot/foot.ini

# systemd services
COPY --link --chmod=0644 systemd/wayfire.service /usr/lib/systemd/system/wayfire.service

# --- PipeWire systemd services ---

RUN cat > /usr/lib/systemd/system/pipewire.service <<'UNIT'
[Unit]
Description=PipeWire Multimedia Service

[Service]
Type=simple
Restart=on-failure
RestartSec=3
EnvironmentFile=/etc/cosy-user.env

ExecStart=/usr/bin/setpriv --reuid=${COSY_UID} --regid=${COSY_GID} --keep-groups -- \
    /bin/sh -c 'export XDG_RUNTIME_DIR=/run/user/$(id -u) && exec /usr/bin/pipewire'

[Install]
WantedBy=multi-user.target
UNIT

RUN cat > /usr/lib/systemd/system/wireplumber.service <<'UNIT'
[Unit]
Description=WirePlumber Session Manager
After=pipewire.service
Requires=pipewire.service

[Service]
Type=simple
Restart=on-failure
RestartSec=3
EnvironmentFile=/etc/cosy-user.env

ExecStart=/usr/bin/setpriv --reuid=${COSY_UID} --regid=${COSY_GID} --keep-groups -- \
    /bin/sh -c 'export XDG_RUNTIME_DIR=/run/user/$(id -u) && exec /usr/bin/wireplumber'

[Install]
WantedBy=multi-user.target
UNIT

RUN cat > /usr/lib/systemd/system/pipewire-pulse.service <<'UNIT'
[Unit]
Description=PipeWire PulseAudio Compatibility
After=pipewire.service
Requires=pipewire.service

[Service]
Type=simple
Restart=on-failure
RestartSec=3
EnvironmentFile=/etc/cosy-user.env

ExecStart=/usr/bin/setpriv --reuid=${COSY_UID} --regid=${COSY_GID} --keep-groups -- \
    /bin/sh -c 'export XDG_RUNTIME_DIR=/run/user/$(id -u) && exec /usr/bin/pipewire-pulse'

[Install]
WantedBy=multi-user.target
UNIT

RUN mkdir -p /etc/systemd/system && \
    ln -sf /dev/null /etc/systemd/system/systemd-oomd.service && \
    ln -sf /dev/null /etc/systemd/system/systemd-oomd.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd-control.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd-kernel.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd.service && \
    systemctl enable wayfire pipewire wireplumber pipewire-pulse

STOPSIGNAL SIGRTMIN+3
CMD ["/usr/sbin/init"]
