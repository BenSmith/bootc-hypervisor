FROM registry.fedoraproject.org/fedora:43 AS builder

RUN dnf install --setopt=install_weak_deps=False --nodocs -y \
    gcc \
    make \
    git \
    && dnf clean all

RUN git clone --depth=1 https://github.com/rofl0r/microsocks /build/microsocks
WORKDIR /build/microsocks
RUN make


FROM registry.fedoraproject.org/fedora:43

LABEL org.opencontainers.image.title="VPN SOCKS5 Proxy"
LABEL org.opencontainers.image.description="SOCKS5 proxy tunneled through WireGuard VPN"

RUN dnf install --setopt=install_weak_deps=False --nodocs -y \
    curl \
    iproute \
    wireguard-tools \
    && dnf clean all

COPY --link --from=builder /build/microsocks/microsocks /usr/local/bin/microsocks

# wireguard-tools creates /etc/wireguard with mode 700; placeholder ensures
# podman bind-mounts wg0.conf as a file rather than creating a directory.
RUN touch /etc/wireguard/wg0.conf

COPY --link --chmod=0755 entrypoint.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
