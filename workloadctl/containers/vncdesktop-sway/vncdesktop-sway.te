module vncdesktop-sway 1.0;

# SELinux policy for the vncdesktop-sway workload container.
#
# GTK4's glycin image loaders run inside a bwrap sandbox to decode SVGs
# (icon themes). Without these rules, bwrap fails during namespace setup
# and every SVG icon load fails, which in turn leaves waybar with a
# zero-size layer surface and no visible bar.

require {
    class chr_file setattr;
    class dir read;
    class file { execute execute_no_trans getattr map open read };
    class filesystem { mount remount };
    class sock_file { getattr mounton write };
    class unix_stream_socket connectto;

    type container_file_t;
    type container_init_t;
    type devpts_t;
    type tmpfs_t;
    type udev_var_run_t;
    type user_tmp_t;
    type var_run_t;
    type xserver_exec_t;
    type xserver_misc_device_t;
    type xserver_t;
}

# bwrap mounts a tmpfs for the sandbox's /tmp-home and /tmp-run.
allow container_init_t tmpfs_t:filesystem { mount remount };

# bwrap mounts a fresh devpts inside the sandbox.
allow container_init_t devpts_t:filesystem mount;

# bwrap bind-mounts over existing sockets while composing the sandbox root.
allow container_init_t container_file_t:sock_file mounton;
allow container_init_t user_tmp_t:sock_file mounton;

# Hardware probing via the bind-mounted /run/udev (mesa, libinput, etc.).
allow container_init_t udev_var_run_t:dir read;
allow container_init_t udev_var_run_t:file { getattr open read };

# Sway launches Xwayland on demand for X11 clients.
allow container_init_t xserver_exec_t:file { execute execute_no_trans getattr map open read };
allow container_init_t xserver_misc_device_t:chr_file setattr;
allow container_init_t xserver_t:unix_stream_socket connectto;
allow container_init_t var_run_t:sock_file { getattr write };
