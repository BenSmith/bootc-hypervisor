FROM registry.fedoraproject.org/fedora:43

LABEL org.opencontainers.image.title="WireGuard VPN"
LABEL org.opencontainers.image.description="WireGuard VPN client"

# Install WireGuard tools and dependencies
RUN dnf install --setopt=install_weak_deps=False --nodocs -y \
    iproute \
    wireguard-tools \
    && dnf clean all

# wireguard-tools creates /etc/wireguard with mode 700 (appropriate for private keys).
# Add placeholder so podman bind-mounts wg0.conf as a file, not a directory.
RUN touch /etc/wireguard/wg0.conf

COPY --link --chmod=0755 entrypoint.sh /entrypoint.sh

# Run as invoking user (workload user)
ENTRYPOINT ["/entrypoint.sh"]
