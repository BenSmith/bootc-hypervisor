{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000"
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "ui": {
      "enable": true
    },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://registry-1.docker.io"],
          "onDemand": false,
          "tlsVerify": true,
          "content": [{ "prefix": "**" }]
        },
        {
          "urls": ["https://ghcr.io"],
          "onDemand": false,
          "tlsVerify": true,
          "content": [{ "prefix": "**" }]
        },
        {
          "urls": ["https://quay.io"],
          "onDemand": false,
          "tlsVerify": true,
          "content": [{ "prefix": "**" }]
        },
        {
          "urls": ["https://registry.fedoraproject.org"],
          "onDemand": false,
          "tlsVerify": true,
          "content": [{ "prefix": "**" }]
        },
        {
          "urls": ["https://codeberg.org"],
          "onDemand": false,
          "tlsVerify": true,
          "content": [{ "prefix": "**" }]
        }
      ]
    }
  }
}
