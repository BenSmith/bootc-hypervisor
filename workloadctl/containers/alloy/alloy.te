module alloy 1.1;

# SELinux policy for the alloy telemetry-collector workload container.
#
# alloy runs confined as container_t and reads the host's systemd journal,
# bind-mounted read-only at /run/log/journal and /var/log/journal (see
# [storage].volumes in alloy.toml). Default container policy denies
# container_t access to the journal's file types, so without this module
# loki.source.journal silently collects 0 entries.
#
# This replaces a blanket `security_opt = ["label=disable"]`: node_exporter
# reads host /proc and /sys, which container_t may already access under the
# stock policy. If enabling alloy produces AVC denials for the host-metrics
# collectors, run `audit2allow -a` and fold the additional rules in here
# rather than reverting to label=disable.

require {
    type container_t;
    type syslogd_var_run_t;
    type var_log_t;
    class dir { open read search getattr watch };
    class file { open read getattr map };
}

# alloy's loki.source.journal reads the journal via libsystemd, which mmap()s
# the .journal files (file:map) and watches the directory for new entries
# via inotify (dir:watch) — both confirmed by AVC denials on first run.

# Runtime journal: /run/log/journal/* is labeled syslogd_var_run_t.
allow container_t syslogd_var_run_t:dir { open read search getattr watch };
allow container_t syslogd_var_run_t:file { open read getattr map };

# Persistent journal: /var/log/journal/* is labeled var_log_t.
allow container_t var_log_t:dir { open read search getattr watch };
allow container_t var_log_t:file { open read getattr map };
