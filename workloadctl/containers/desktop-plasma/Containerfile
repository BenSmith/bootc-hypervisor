# Headless KDE Plasma Desktop (RDP)
#
# Plasma runs under KWin's virtual Wayland backend (no real display).
# Access via krdpserver on port 3389 with any RDP client (Remmina,
# FreeRDP, Windows Remote Desktop, KRDC).
#
# Build:
#   sudo ./build.sh
#
# Run:
#   workloadctl enable desktop-plasma
#
# Default RDP credentials are CONTAINER_USER / "changeme".
# Override by setting KRDP_PASSWORD in the workload TOML's environment.
#
# Phases — add packages and services incrementally once each phase works:
#   Phase 1 (this file): kwin + plasmashell + krdp — bare desktop via RDP
#   Phase 2: xdg-desktop-portal + xdg-desktop-portal-kde
#   Phase 3: pipewire-alsa, pipewire-pulseaudio (audio)
#   Phase 4: apps (Firefox, Dolphin, Konsole, …)

FROM registry.fedoraproject.org/fedora:43

RUN dnf install --setopt=install_weak_deps=False --nodocs -y \
    bash-completion \
    dbus-daemon \
    krdp \
    less \
    kwin \
    mesa-dri-drivers \
    mesa-libEGL \
    mesa-libGL \
    mesa-libgbm \
    openssl \
    pipewire \
    plasma-desktop \
    plasma-workspace \
    procps-ng \
    qt6-qtwayland \
    shadow-utils \
    sudo \
    systemd \
    util-linux \
    wireplumber \
    && dnf clean all

# Strip file capabilities — several KDE/PipeWire binaries request caps that
# fail with EPERM inside a rootless user namespace.
RUN find /usr/bin /usr/libexec -type f 2>/dev/null \
    | xargs -r -I{} sh -c 'getcap "{}" 2>/dev/null | grep -q "=" && setcap -r "{}" 2>/dev/null || true'

# Disable screen auto-lock — pointless for a remote desktop and breaks krdp
# capture if it fires before the user connects.
RUN mkdir -p /etc/xdg && \
    cat > /etc/xdg/kscreenlockerrc <<'INI'
[Daemon]
Autolock=false
LockOnResume=false
INI

# kactivitymanagerd is a headless D-Bus daemon with no UI. Without this patch
# dbus-daemon activates it without QT_QPA_PLATFORM set, it tries xcb/X11,
# and crashes — causing plasmashell to abort.
RUN f=/usr/share/dbus-1/services/org.kde.ActivityManager.service; \
    [ -f "$f" ] && sed -i 's|^Exec=|Exec=/usr/bin/env QT_QPA_PLATFORM=offscreen |' "$f" || true

# --- Session D-Bus daemon ---

RUN cat > /usr/lib/systemd/system/session-dbus.service <<'UNIT'
[Unit]
Description=Session DBus daemon
After=container-bootstrap.service
Requires=container-bootstrap.service

[Service]
Type=simple
Restart=on-failure
RestartSec=3
PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER

ExecStartPre=/bin/sh -c 'mkdir -p /run/user/${CONTAINER_UID} && chown ${CONTAINER_UID}:${CONTAINER_GID} /run/user/${CONTAINER_UID} && chmod 0700 /run/user/${CONTAINER_UID}'
ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /bin/sh -c 'export HOME=/home/${CONTAINER_USER} XDG_RUNTIME_DIR=/run/user/${CONTAINER_UID} && exec /usr/bin/dbus-daemon --session --address=unix:path=/run/user/${CONTAINER_UID}/bus --nofork --nopidfile'

[Install]
WantedBy=multi-user.target
UNIT

# --- PipeWire + WirePlumber ---
# PipeWire is required by krdp for frame transport (via kf6-kpipewire).

RUN cat > /usr/lib/systemd/system/pipewire.service <<'UNIT'
[Unit]
Description=PipeWire Multimedia Service
After=session-dbus.service
Requires=session-dbus.service

[Service]
Type=simple
Restart=on-failure
RestartSec=3
PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER

ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /bin/sh -c 'export HOME=/home/${CONTAINER_USER} XDG_RUNTIME_DIR=/run/user/${CONTAINER_UID} DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${CONTAINER_UID}/bus && exec /usr/bin/pipewire'

[Install]
WantedBy=multi-user.target
UNIT

RUN cat > /usr/lib/systemd/system/wireplumber.service <<'UNIT'
[Unit]
Description=WirePlumber Session Manager
After=pipewire.service
Requires=pipewire.service

[Service]
Type=simple
Restart=on-failure
RestartSec=3
PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER

ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /bin/sh -c 'export HOME=/home/${CONTAINER_USER} XDG_RUNTIME_DIR=/run/user/${CONTAINER_UID} DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${CONTAINER_UID}/bus && exec /usr/bin/wireplumber'

[Install]
WantedBy=multi-user.target
UNIT

# --- KDE Plasma Wayland session ---
# kwin_wayland --virtual renders to an off-screen buffer at the given size,
# then execs plasma-session with WAYLAND_DISPLAY already set in the env.

RUN cat > /usr/local/bin/plasma-session <<'SCRIPT'
#!/bin/bash
set -e
# Push the Wayland session environment into the D-Bus activation environment
# so that any D-Bus-activated service (beyond kactivitymanagerd, which is
# patched at the .service file level) also gets QT_QPA_PLATFORM=wayland.
dbus-update-activation-environment --all
exec plasmashell --no-respawn
SCRIPT

RUN chmod +x /usr/local/bin/plasma-session

RUN cat > /usr/lib/systemd/system/plasma.service <<'UNIT'
[Unit]
Description=KDE Plasma Wayland session (headless)
After=session-dbus.service wireplumber.service
Requires=session-dbus.service

[Service]
Type=simple
TasksMax=infinity
Restart=on-failure
RestartSec=3
PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER

Environment=LANG=C.UTF-8
Environment=XDG_CURRENT_DESKTOP=KDE
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_DESKTOP=KDE
Environment=KDE_FULL_SESSION=true
Environment=QT_QPA_PLATFORM=wayland
Environment=XCURSOR_SIZE=24

ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /bin/sh -c 'export HOME=/home/${CONTAINER_USER} XDG_RUNTIME_DIR=/run/user/${CONTAINER_UID} DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${CONTAINER_UID}/bus && cd && exec /usr/bin/kwin_wayland --virtual /usr/local/bin/plasma-session'

[Install]
WantedBy=multi-user.target
UNIT

# --- Wayland ready gate ---

RUN cat > /usr/local/bin/wait-for-wayland <<'SCRIPT'
#!/bin/sh
RUNTIME_DIR="/run/user/${CONTAINER_UID}"
ENV_FILE="/run/wayland-display.env"
while true; do
    for sock in "$RUNTIME_DIR"/wayland-*; do
        case "$sock" in *.lock) continue ;; esac
        [ -S "$sock" ] || continue
        printf 'WAYLAND_DISPLAY=%s\n' "${sock##*/}" > "$ENV_FILE"
        exit 0
    done
    sleep 0.5
done
SCRIPT

RUN chmod +x /usr/local/bin/wait-for-wayland

RUN cat > /usr/lib/systemd/system/plasma-wayland-ready.service <<'UNIT'
[Unit]
Description=Wait for Plasma Wayland socket
After=plasma.service
Requires=plasma.service

[Service]
Type=oneshot
RemainAfterExit=yes
PassEnvironment=CONTAINER_UID
ExecStart=/usr/local/bin/wait-for-wayland

[Install]
WantedBy=multi-user.target
UNIT

# --- krdp ---

RUN cat > /usr/lib/systemd/system/krdp.service <<'UNIT'
[Unit]
Description=KDE Remote Desktop server
After=plasma-wayland-ready.service
Requires=plasma-wayland-ready.service

[Service]
Type=simple
Restart=on-failure
RestartSec=3
PassEnvironment=CONTAINER_UID CONTAINER_GID CONTAINER_USER KRDP_PASSWORD

Environment=QT_QPA_PLATFORM=wayland
Environment=XDG_CURRENT_DESKTOP=KDE
Environment=XDG_SESSION_TYPE=wayland

ExecStart=/usr/bin/setpriv --reuid=${CONTAINER_UID} --regid=${CONTAINER_GID} --keep-groups -- \
    /bin/sh -c '. /run/wayland-display.env \
        && export HOME=/home/${CONTAINER_USER} \
                 XDG_RUNTIME_DIR=/run/user/${CONTAINER_UID} \
                 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${CONTAINER_UID}/bus \
                 WAYLAND_DISPLAY \
        && cd \
        && exec /usr/bin/krdpserver \
            --address 0.0.0.0 \
            --port 3389 \
            --username ${CONTAINER_USER} \
            --password ${KRDP_PASSWORD:-changeme} \
            --certificate $HOME/.local/share/krdpserver/server.crt \
            --certificate-key $HOME/.local/share/krdpserver/server.key \
            --plasma'

[Install]
WantedBy=multi-user.target
UNIT

# --- Bootstrap ---

RUN cat > /usr/local/bin/container-bootstrap <<'SCRIPT'
#!/bin/bash
set -e
: "${CONTAINER_USER:?must be set}"
: "${CONTAINER_UID:?must be set}"
: "${CONTAINER_GID:?must be set}"

HOME_DIR="/home/$CONTAINER_USER"

groupadd -g "$CONTAINER_GID" "$CONTAINER_USER" 2>/dev/null || true
useradd -u "$CONTAINER_UID" -g "$CONTAINER_GID" -d "$HOME_DIR" -s /bin/bash -M "$CONTAINER_USER" 2>/dev/null || true
mkdir -p "$HOME_DIR/.local/state" "$HOME_DIR/.config" "$HOME_DIR/.local/share/krdpserver"

CERT="$HOME_DIR/.local/share/krdpserver/server.crt"
KEY="$HOME_DIR/.local/share/krdpserver/server.key"
if [ ! -f "$CERT" ] || [ ! -f "$KEY" ]; then
    openssl req -x509 -newkey rsa:4096 -nodes \
        -keyout "$KEY" -out "$CERT" \
        -days 3650 -subj "/CN=krdp-${CONTAINER_USER}"
    chmod 600 "$KEY"
fi

chown -R "$CONTAINER_UID:$CONTAINER_GID" "$HOME_DIR"

for grp in render video audio; do
    getent group "$grp" >/dev/null 2>&1 && usermod -aG "$grp" "$CONTAINER_USER" 2>/dev/null || true
done

mkdir -p /etc/sudoers.d
echo "$CONTAINER_USER ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/container-user
chown 0:0 /etc/sudoers.d/container-user
chmod 0440 /etc/sudoers.d/container-user

echo "Bootstrap complete."
SCRIPT

RUN chmod +x /usr/local/bin/container-bootstrap

RUN cat > /usr/lib/systemd/system/container-bootstrap.service <<'UNIT'
[Unit]
Description=First-boot container bootstrap
ConditionPathExists=!/etc/container-bootstrapped
DefaultDependencies=no
After=sysinit.target
Before=session-dbus.service

[Service]
Type=oneshot
PassEnvironment=CONTAINER_USER CONTAINER_UID CONTAINER_GID
ExecStart=/usr/local/bin/container-bootstrap
ExecStartPost=/bin/touch /etc/container-bootstrapped

[Install]
WantedBy=multi-user.target
UNIT

# --- Journal forwarding to host ---

RUN mkdir -p /etc/systemd/journald.conf.d && \
    cat > /etc/systemd/journald.conf.d/10-container.conf <<'CONF'
[Journal]
Storage=volatile
ForwardToSocket=/run/host-systemd/journal/socket
CONF

RUN mkdir -p /etc/systemd/system/systemd-journald.service.d && \
    cat > /etc/systemd/system/systemd-journald.service.d/10-container.conf <<'DROPIN'
[Service]
CapabilityBoundingSet=
IPAddressDeny=
LockPersonality=no
MemoryDenyWriteExecute=no
NoNewPrivileges=no
ProtectClock=no
RestrictAddressFamilies=
RestrictNamespaces=no
RestrictRealtime=no
RestrictSUIDSGID=no
SystemCallArchitectures=
SystemCallFilter=
DROPIN

RUN ln -sf /dev/null /etc/systemd/system/systemd-udevd.service && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd-control.socket && \
    ln -sf /dev/null /etc/systemd/system/systemd-udevd-kernel.socket && \
    ln -sf /dev/null /etc/systemd/system/rtkit-daemon.service && \
    ln -sf /dev/null /etc/systemd/system/polkit.service && \
    systemctl enable \
        container-bootstrap \
        session-dbus \
        pipewire \
        wireplumber \
        plasma \
        plasma-wayland-ready \
        krdp

STOPSIGNAL SIGRTMIN+3
CMD ["/usr/sbin/init"]
