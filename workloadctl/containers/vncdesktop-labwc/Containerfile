# Fedora 44 labwc desktop served over VNC
#
# labwc runs in headless wlroots mode (no host Wayland or KMS); wayvnc
# attaches to the labwc compositor and serves it on TCP 5900.
#
# Build:
#   ./build.sh
#
# All user configuration is embedded via heredocs so this Containerfile is
# fully self-contained — no external config files or COPY instructions needed.

FROM fedora:44

# Desktop session components:
#   arc-theme             - GTK theme (clean dark style)
#   btop                  - system monitor
#   cliphist              - clipboard history; pairs with wl-paste and fuzzel (Ctrl+Alt+V)
#   dbus-daemon           - per-session D-Bus (waybar, mako, clipboard need it)
#   foot                  - terminal emulator (native Wayland, lightweight)
#   fuzzel                - app launcher (native Wayland, keyboard-driven)
#   geany                 - lightweight GUI text editor
#   imv                   - image viewer (Wayland native)
#   jetbrains-mono-fonts  - monospace font for the terminal
#   labwc                 - Wayland compositor (wlroots-based)
#                           grim and xdg-desktop-portal-wlr pulled in as deps
#   labwc-menu-generator  - generates right-click menu from .desktop files
#   mako                  - notification daemon (native Wayland)
#   mesa-dri-drivers      - GBM / DRI for hardware-accelerated render node
#   mesa-libEGL           - EGL for wlroots / wayvnc
#   papirus-icon-theme    - icon set (replaces minimal Adwaita default)
#   procps-ng             - pkill, used by autostart to SIGHUP labwc after
#                           regenerating the right-click menu
#   swaybg                - wallpaper setter
#   thunar                - file manager
#   tini                  - minimal init / subreaper for zombie reaping
#   tmux                  - terminal multiplexer
#   waybar                - status bar
#   wayvnc                - VNC server attaching to the labwc compositor
#   wl-clipboard          - wl-copy / wl-paste for clipboard support
#   wlr-randr             - sets the headless output resolution at runtime
#   xdg-user-dirs         - creates ~/Documents, ~/Downloads etc. on first login
#   xorg-x11-server-Xwayland - X11 compatibility; labwc aborts at startup
#                              if its built-in xwayland support can't find
#                              /usr/bin/Xwayland
RUN dnf install -y --nodocs --setopt=install_weak_deps=False \
    arc-theme \
    btop \
    cliphist \
    dbus-daemon \
    foot \
    fuzzel \
    geany \
    git-core \
    imv \
    jetbrains-mono-fonts \
    labwc \
    labwc-menu-generator \
    mako \
    mesa-dri-drivers \
    mesa-libEGL \
    papirus-icon-theme \
    procps-ng \
    swaybg \
    thunar \
    tini \
    tmux \
    waybar \
    wayvnc \
    wl-clipboard \
    wlr-randr \
    xdg-user-dirs \
    xorg-x11-server-Xwayland \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Create user with UID 1000 to match the workload's keep-id user mapping.
# XDG_RUNTIME_DIR must exist and be owned by the user before labwc starts.
RUN useradd -m -u 1000 desktop \
    && mkdir -p /run/user/1000 \
    && chown desktop:desktop /run/user/1000 \
    && chmod 700 /run/user/1000

USER desktop
WORKDIR /home/desktop

# Headless wlroots backend — labwc creates a virtual output instead of needing
# a host Wayland socket or DRM/KMS device. wayvnc attaches to it.
ENV GDK_BACKEND=wayland \
    LIBSEAT_BACKEND=noop \
    MOZ_ENABLE_WAYLAND=1 \
    QT_QPA_PLATFORM=wayland \
    WLR_BACKENDS=headless \
    WLR_LIBINPUT_NO_DEVICES=1 \
    XDG_RUNTIME_DIR=/run/user/1000 \
    XDG_SESSION_TYPE=wayland

RUN <<'SETUP'
#!/bin/sh
set -e

mkdir -p \
    ~/.config/btop \
    ~/.config/foot \
    ~/.config/fuzzel \
    ~/.config/gtk-3.0 \
    ~/.config/gtk-4.0 \
    ~/.config/labwc \
    ~/.config/mako \
    ~/.config/waybar \
    ~/.local/share/applications \
    ~/.local/share/themes/Arc-Labwc/openbox-3

# --- .desktop overrides ---
# Hide dependency entries that clutter the menu.
for f in foot-server footclient thunar-bulk-rename thunar-settings xterm panel-preferences panel-desktop-handler; do
  printf '[Desktop Entry]\nType=Application\nName=hidden\nNoDisplay=true\n' > ~/.local/share/applications/${f}.desktop
done
# btop is Terminal=true; wrap it in foot so it launches from the menu.
cat > ~/.local/share/applications/btop.desktop << 'BTOPEOF'
[Desktop Entry]
Type=Application
Name=btop++
Icon=btop
Exec=foot --window-size-chars=80x24 btop
Categories=System;Monitor;
BTOPEOF
# Thunar ships with multiple categories causing it to appear twice; pin it to one.
cat > ~/.local/share/applications/thunar.desktop << 'THUNAREOF'
[Desktop Entry]
Type=Application
Name=Thunar File Manager
Icon=org.xfce.thunar
Exec=thunar
Categories=Utility;FileManager;
MimeType=inode/directory;
THUNAREOF

# --- labwc/rc.xml ---
cat > ~/.config/labwc/rc.xml << 'RCXML'
<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>

  <core>
    <gap>6</gap>
  </core>

  <theme>
    <name>Arc-Labwc</name>
    <cornerRadius>4</cornerRadius>
    <font place="ActiveWindow">
      <name>Cantarell</name>
      <size>10</size>
      <slant>Normal</slant>
      <weight>Bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>Cantarell</name>
      <size>10</size>
      <slant>Normal</slant>
      <weight>Normal</weight>
    </font>
  </theme>

  <desktops>
    <popupTime>500</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <keyboard>
    <default/>

    <!-- Applications
         Ctrl+Alt is used as the primary modifier — chosen to coexist with
         host DEs when this image is also run nested. Inside a VNC viewer,
         Super is often intercepted by the local DE before reaching the
         server, so Ctrl+Alt is the more reliable choice either way.
    -->
    <keybind key="C-A-Return">
      <action name="Execute"><command>foot</command></action>
    </keybind>
    <keybind key="C-A-space">
      <action name="Execute"><command>fuzzel</command></action>
    </keybind>
    <keybind key="C-A-v">
      <action name="Execute">
        <command>sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'</command>
      </action>
    </keybind>

    <!-- Window management -->
    <keybind key="C-A-q">
      <action name="Close"/>
    </keybind>
    <keybind key="C-A-f">
      <action name="ToggleMaximize"/>
    </keybind>
    <!-- Snapping: hjkl avoids Ctrl+Alt+arrows (KDE workspace switch on host) -->
    <keybind key="C-A-h">
      <action name="SnapToEdge"><direction>left</direction></action>
    </keybind>
    <keybind key="C-A-l">
      <action name="SnapToEdge"><direction>right</direction></action>
    </keybind>
    <keybind key="C-A-k">
      <action name="SnapToEdge"><direction>up</direction></action>
    </keybind>
    <keybind key="C-A-j">
      <action name="SnapToEdge"><direction>down</direction></action>
    </keybind>
    <keybind key="C-A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="C-A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>

    <!-- Workspaces -->
    <keybind key="C-A-1">
      <action name="GoToDesktop"><to>1</to></action>
    </keybind>
    <keybind key="C-A-2">
      <action name="GoToDesktop"><to>2</to></action>
    </keybind>
    <keybind key="C-A-3">
      <action name="GoToDesktop"><to>3</to></action>
    </keybind>
    <keybind key="C-A-4">
      <action name="GoToDesktop"><to>4</to></action>
    </keybind>
    <keybind key="C-A-S-1">
      <action name="SendToDesktop"><to>1</to><follow>yes</follow></action>
    </keybind>
    <keybind key="C-A-S-2">
      <action name="SendToDesktop"><to>2</to><follow>yes</follow></action>
    </keybind>
    <keybind key="C-A-S-3">
      <action name="SendToDesktop"><to>3</to><follow>yes</follow></action>
    </keybind>
    <keybind key="C-A-S-4">
      <action name="SendToDesktop"><to>4</to><follow>yes</follow></action>
    </keybind>

  </keyboard>

  <mouse>
    <default/>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </context>
  </mouse>

</labwc_config>
RCXML

# --- labwc/environment ---
cat > ~/.config/labwc/environment << 'ENVIRON'
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24
GTK_THEME=Arc-Dark
QT_QPA_PLATFORM=wayland
LANG=C.UTF-8
LC_ALL=C.UTF-8
ENVIRON

# --- labwc/autostart ---
cat > ~/.config/labwc/autostart << 'AUTOSTART'
~/.config/labwc/menu-generate.sh && pkill -SIGHUP labwc
xdg-user-dirs-update
swaybg -c '#383c4a' &
wl-paste --watch cliphist store &
mako &
sleep 0.5 && waybar &
AUTOSTART

# --- labwc/menu-generate.sh ---
# Regenerates the right-click menu from installed .desktop files at each startup.
cat > ~/.config/labwc/menu-generate.sh << 'MENUSCRIPT'
#!/bin/sh
MENU="$HOME/.config/labwc/menu.xml"

labwc-menu-generator \
  | grep -v '</openbox_menu>' \
  | grep -v '</menu> <!-- root-menu -->' \
  > "$MENU"

cat >> "$MENU" << 'EOF'
</menu> <!-- root-menu -->
</openbox_menu>
EOF
MENUSCRIPT
chmod +x ~/.config/labwc/menu-generate.sh

# --- waybar/config.jsonc ---
# Minimal stable config — avoids modules that crash in a container environment
# (idle_inhibitor, battery, backlight, network, pulseaudio, wlr/taskbar all
# caused segfaults or runaway memory usage during testing).
cat > ~/.config/waybar/config.jsonc << 'WAYBAR_CONF'
{
    "modules-left": [],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory"],
    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "cpu {usage}%",
        "tooltip": false,
        "interval": 2
    },
    "memory": {
        "format": "mem {}%",
        "interval": 5
    }
}
WAYBAR_CONF

