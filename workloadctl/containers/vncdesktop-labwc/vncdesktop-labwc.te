module vncdesktop-labwc 1.0;

# SELinux policy for the vncdesktop-labwc workload container.
#
# GTK4's glycin image loaders run inside a bwrap sandbox to decode SVGs and
# other image formats (icon themes, thumbnails). Without these rules, bwrap
# fails during namespace setup and every image load fails — apps appear to
# run but icons silently fail to render (e.g. empty file pickers, blank
# panels). This image is GTK3-only today, but the policy is shipped pre-
# emptively so that adding a GTK4 app (GIMP 3, GNOME apps, etc.) Just Works.

require {
    class dir read;
    class file { execute execute_no_trans getattr map open read };
    class filesystem { mount remount };
    class sock_file mounton;

    type container_file_t;
    type container_init_t;
    type container_t;
    type devpts_t;
    type tmpfs_t;
    type user_tmp_t;
}

#============= container_init_t ==============
# bwrap mounts a tmpfs for the sandbox's /tmp-home and /tmp-run.
allow container_init_t tmpfs_t:filesystem { mount remount };

# bwrap mounts a fresh devpts inside the sandbox.
allow container_init_t devpts_t:filesystem mount;

# bwrap bind-mounts over existing sockets while composing the sandbox root.
allow container_init_t container_file_t:sock_file mounton;
allow container_init_t user_tmp_t:sock_file mounton;

#============= container_t ==============
allow container_t devpts_t:filesystem mount;
