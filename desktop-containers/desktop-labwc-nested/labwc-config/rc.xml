<?xml version="1.0"?>
<labwc_config>
  <theme>
    <name>Adwaita</name>
    <cornerRadius>8</cornerRadius>
  </theme>

  <keyboard>
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="W-Escape">
      <action name="Exit" />
    </keybind>

    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <outputs>
    <output name="*">
      <transform>normal</transform>
    </output>
  </outputs>

  <windowRules>
    <windowRule identifier="*">
      <action name="MoveTo" x="center" y="center"/>
    </windowRule>
  </windowRules>
</labwc_config>
