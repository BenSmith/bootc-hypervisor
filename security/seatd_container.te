module seatd_container 1.0;

require {
        type unconfined_service_t;
        type var_run_t;
        type container_t;
        class unix_stream_socket connectto;
        class sock_file { read write getattr };
}

# Allow containers to connect to the host seatd socket for DRM/KMS access
allow container_t unconfined_service_t:unix_stream_socket connectto;
allow container_t var_run_t:sock_file { read write getattr };
