; Allow containers to connect to the host seatd socket for DRM/KMS access
; (KMS desktop workloads). Intentionally host-wide on container_t: seatd runs as
; unconfined_service_t and exposes its socket under var_run_t. Per-workload
; scoping is the direction for the desktop workloads; this host-wide grant stays
; until those migrate.
(allow container_t unconfined_service_t (unix_stream_socket (connectto)))
(allow container_t var_run_t (sock_file (read write getattr)))
