; Allow containers to connect to the host seatd socket for DRM/KMS access
; (KMS desktop workloads). This is intentionally host-wide on container_t: seatd
; runs as unconfined_service_t and exposes its socket under var_run_t. Loaded at
; image-build time via `semodule -i` (CIL needs no checkmodule/semodule_package).
;
; NOTE: per-workload scoping (wl_<name>.process) is the direction for the desktop
; workloads; this host-wide grant stays until those migrate. See
; docs/workload-bundles.md "SELinux: per-workload types".
(allow container_t unconfined_service_t (unix_stream_socket (connectto)))
(allow container_t var_run_t (sock_file (read write getattr)))
