[Unit]
Description=Rootless Workload Setup
Documentation=man:systemd-sysusers(8)
After=systemd-sysusers.service local-fs.target
Before=multi-user.target
DefaultDependencies=no
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=/usr/lib/systemd/workload-setup.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
