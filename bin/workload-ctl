#!/bin/bash
# Workload management helper for rootless system workloads
# Usage: workload-ctl {enable|disable|restart|status|list} [workload-name]

set -e

WORKLOAD_DIR="/etc/workloads.d"

print_usage() {
    cat << EOF
Usage: workload-ctl <command> [options] [workload-name]

Commands:
  enable <name>          - Enable and start a workload
  disable [--purge] <name> - Stop and disable a workload
                           --purge: Also remove user, home, and subuid/subgid
  restart <name>         - Restart a running workload
  status <name>          - Show workload service status
  list                   - List all available workloads

Examples:
  workload-ctl enable webserver
  workload-ctl disable webserver
  workload-ctl disable --purge webserver
  workload-ctl status webserver
  workload-ctl list
EOF
}

ensure_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "Error: This command must be run as root (use sudo)" >&2
        exit 1
    fi
}

get_workload_name() {
    local filename=$1
    local config="$WORKLOAD_DIR/$filename.toml"

    if [[ ! -f "$config" ]]; then
        echo "Error: Workload config not found: $config" >&2
        exit 1
    fi

    # Extract name from TOML (handles whitespace, quoted/unquoted values, and strips comments)
    local name=$(grep '^name[[:space:]]*=' "$config" | head -1 | sed 's/#.*//' | sed 's/^name[[:space:]]*=[[:space:]]*["\x27]\?\([^"\x27]*\)["\x27]\?/\1/' | sed 's/[[:space:]]*$//')
    if [[ -z "$name" ]]; then
        echo "Error: Could not find 'name' in $config" >&2
        exit 1
    fi

    echo "$name"
}

get_workload_id() {
    local filename=$1
    local config="$WORKLOAD_DIR/$filename.toml"

    if [[ ! -f "$config" ]]; then
        echo "Error: Workload config not found: $config" >&2
        exit 1
    fi

    # Extract ID from TOML (handles whitespace, quoted/unquoted values, and strips comments)
    local id=$(grep '^id[[:space:]]*=' "$config" | head -1 | sed 's/#.*//' | sed 's/^id[[:space:]]*=[[:space:]]*["\x27]\?\([^"\x27]*\)["\x27]\?/\1/' | sed 's/[[:space:]]*$//')
    if [[ -z "$id" ]]; then
        echo "Error: Could not find 'id' in $config" >&2
        exit 1
    fi

    echo "$id"
}

cmd_enable() {
    ensure_root
    local filename=$1

    if [[ -z "$filename" ]]; then
        echo "Error: Workload name required" >&2
        print_usage
        exit 1
    fi

    local config="$WORKLOAD_DIR/$filename.toml"

    if [[ ! -f "$config" ]]; then
        echo "Error: Workload config not found: $config" >&2
        exit 1
    fi

    echo "Enabling workload: $filename"

    # Enable in config file (handles any whitespace around =)
    sed -i 's/enabled[[:space:]]*=[[:space:]]*false/enabled = true/' "$config"

    # Reload systemd to pick up changes
    echo "  Reloading systemd..."
    systemctl daemon-reload

    # Create user if needed
    echo "  Running systemd-sysusers..."
    systemd-sysusers

    # Configure user (subuid/subgid/linger/home)
    echo "  Configuring workload user..."
    systemctl start workload-setup.service

    # Get the workload name and ID from TOML to construct service name
    local name=$(get_workload_name "$filename")
    local id=$(get_workload_id "$filename")
    local service="workload-$name-$id.service"

    # Start the service (generator already created the enable symlink)
    echo "  Starting $service..."
    echo "  (Image pull may take a few minutes on first start)"
    systemctl start --no-block "$service"

    echo "✓ Workload '$filename' enabled and starting"
    echo "  Check status: workload-ctl status $filename"
    echo "  Watch logs: sudo journalctl -fu $service"
}

cmd_disable() {
    ensure_root
    local filename=$1
    local purge=false

    # Check for --purge flag
    if [[ "$filename" == "--purge" ]]; then
        purge=true
        filename=$2
    elif [[ "$2" == "--purge" ]]; then
        purge=true
    fi

    if [[ -z "$filename" ]]; then
        echo "Error: Workload name required" >&2
        print_usage
        exit 1
    fi

    local name=$(get_workload_name "$filename")
    local id=$(get_workload_id "$filename")
    local service="workload-$name-$id.service"
    local config="$WORKLOAD_DIR/$filename.toml"
    local username="_wl-$name-$id"

    if [[ "$purge" == true ]]; then
        echo "Disabling and purging workload: $filename"
    else
        echo "Disabling workload: $filename"
    fi

    # Stop service
    echo "  Stopping $service..."
    systemctl stop "$service" 2>/dev/null || true


    sed -i 's/enabled[[:space:]]*=[[:space:]]*true/enabled = false/' "$config"

    if [[ "$purge" == true ]]; then
        # Get user info before deletion
        local uid=$(id -u "$username" 2>/dev/null || echo "")
        local home_dir=$(getent passwd "$username" 2>/dev/null | cut -d: -f6 || echo "")

        # Terminate user sessions and disable linger
        if [[ -n "$uid" ]]; then
            echo "  Terminating user sessions for $username..."
            loginctl terminate-user "$uid" 2>/dev/null || true
            loginctl disable-linger "$uid" 2>/dev/null || true
            # Give systemd time to clean up
            sleep 1
        fi

        # Remove subuid/subgid entries
        echo "  Removing subuid/subgid entries..."
        sed -i "/^$username:/d" /etc/subuid 2>/dev/null || true
        sed -i "/^$username:/d" /etc/subgid 2>/dev/null || true

        # Remove user (with force flag to handle any remaining processes)
        echo "  Removing user $username..."
        userdel -f "$username" 2>/dev/null || true

        # Remove home directory (if it exists and wasn't removed by userdel)
        if [[ -n "$home_dir" && -d "$home_dir" ]]; then
            echo "  Removing home directory $home_dir..."
            rm -rf "$home_dir"
        fi

        echo "✓ Workload '$filename' disabled and purged (user, home, subuid/subgid removed)"
    else
        echo "✓ Workload '$filename' disabled and stopped (use --purge to fully remove)"
    fi
}

cmd_restart() {
    ensure_root
    local filename=$1

    if [[ -z "$filename" ]]; then
        echo "Error: Workload name required" >&2
        print_usage
        exit 1
    fi

    local name=$(get_workload_name "$filename")
    local id=$(get_workload_id "$filename")
    local service="workload-$name-$id.service"

    echo "Restarting workload: $filename"
    systemctl restart "$service"
    echo "✓ Workload '$filename' restarted"
}

cmd_status() {
    local filename=$1

    if [[ -z "$filename" ]]; then
        echo "Error: Workload name required" >&2
        print_usage
        exit 1
    fi

    local name=$(get_workload_name "$filename")
    local id=$(get_workload_id "$filename")
    local service="workload-$name-$id.service"

    systemctl status "$service"
}

cmd_list() {
    echo "Available workloads in $WORKLOAD_DIR:"
    echo ""

    for config in "$WORKLOAD_DIR"/*.toml; do
        if [[ ! -f "$config" ]]; then
            echo "  No workload configs found"
            break
        fi

        local filename=$(basename "$config" .toml)
        local enabled=$(grep '^enabled[[:space:]]*=' "$config" | head -1 | grep -q 'true' && echo "enabled" || echo "disabled")
        local name=$(grep '^name[[:space:]]*=' "$config" | head -1 | sed 's/#.*//' | sed 's/^name[[:space:]]*=[[:space:]]*["\x27]\?\([^"\x27]*\)["\x27]\?/\1/' | sed 's/[[:space:]]*$//')
        local id=$(grep '^id[[:space:]]*=' "$config" | sed -n '/\[container\]/,/\[/p' | grep '^id[[:space:]]*=' | head -1 | sed 's/#.*//' | sed 's/^id[[:space:]]*=[[:space:]]*["\x27]\?\([^"\x27]*\)["\x27]\?/\1/' | sed 's/[[:space:]]*$//')

        printf "  %-20s %-10s (name: %s, id: %s)\n" "$filename" "[$enabled]" "$name" "$id"
    done
}

# Main command dispatcher
case "${1:-}" in
    enable)
        cmd_enable "$2"
        ;;
    disable)
        cmd_disable "$2" "$3"
        ;;
    restart)
        cmd_restart "$2"
        ;;
    status)
        cmd_status "$2"
        ;;
    list)
        cmd_list
        ;;
    ""|help|-h|--help)
        print_usage
        ;;
    *)
        echo "Error: Unknown command: $1" >&2
        print_usage
        exit 1
        ;;
esac
